    protected override Task OnInitializedAsync()
    {
        // Subscribe TRƯỚC khi đọc snapshot — event bắn giữa 2 bước không bị miss;
        // apply trùng (event có cả trong snapshot lẫn inbox) là idempotent nên an toàn.
        Feed.Published += OnPublished;

        foreach (var e in Feed.Snapshot())
            ApplyEvent(e);

        try
        {
            // Bù node trắng tại Hàng đợi cho request đang chờ nhưng feed chưa từng thấy
            // (mở app giữa chừng / ring eviction) — spec trace §5.3. Proxy dừng giữa chừng
            // có thể ném khi đọc queue → coi như không có gì để bù.
            var now = DateTimeOffset.UtcNow;
            foreach (var q in Proxy.QueuedSnapshot())
            {
                if (!Nodes.ContainsKey(q.Id))
                    Nodes[q.Id] = new TraceNodeState { Id = q.Id, Model = q.Model, ReceivedAt = now };
            }
        }
        catch (Exception ex)
        {
            Log.Error("RequestTrace: đọc QueuedSnapshot thất bại.", ex);
        }

        EnforceCap();

        // G4: dựng tracker TRƯỚC khi loop render chạy — Flush đầu tiên sẽ fetch ngay
        // (_cooldownFetchedAt = MinValue → điều kiện ≥30s luôn đúng ở tick đầu).
        _cooldown = new CooldownTracker(
            snapshot: () => ProxyPool.Snapshot(),
            reverseAssignments: ct => ProxyService.GetReverseAssignmentsAsync(ct),
            providerAssignments: (id, ct) => ProxyService.GetAssignmentsAsync(id, ct),
            onError: ex => Log.Error("RequestTrace: cooldown snapshot failed — giữ map cũ", ex));

        // Xong bootstrap → từ giờ event runtime mới dựng travel (dot chạy dọc line);
        // snapshot/QueuedSnapshot phía trên không animate
        _primed = true;

        _ = LoadProvidersAsync();
        _ = RunLoopAsync(_cts.Token);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Bật auto-follow sau lần render đầu — ElementReference .trace-wrap mới attach DOM
    /// lúc này, gọi JS trước đó sẽ ném (element chưa resolve).
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _jsReady = true;
    }

    /// <summary>
    /// Nạp cache provider (kèm Accounts) cho chip "+N idle" và panel expand —
    /// fire-and-forget + try/catch: deviation có chủ đích khỏi chữ "lazy khi expand" trong
    /// spec §5.5 (brief Task 6 Interfaces): tổng số TK cần biết NGAY khi render chip,
    /// expand chỉ hiện lại danh sách đã có; không chặn first render.
    /// </summary>
    private async Task LoadProvidersAsync()
    {
        try
        {
            var providers = await ProviderService.ListAsync();

            // Gán + render phải qua dispatcher thread — ListAsync chạy trên thread pool.
            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    _providers = providers;
                    StateHasChanged();
                });
            }
        }
        catch (Exception ex)
        {
            // DB chưa sẵn sàng / query lỗi → chip idle ẩn (không có tổng TK), UI vẫn chạy.
            Log.Error("RequestTrace: nạp danh sách provider cho chip idle thất bại.", ex);
        }
    }

    /// <summary>
    /// Nhận event từ <see cref="ITraceFeed.Published"/> — chạy trên thread publish của Core.
    /// </summary>
    private void OnPublished(TraceEvent e)
    {
        // Handler tuyệt đối không được ném: Published là multicast delegate — subscriber
        // ném sẽ chặn các subscriber phía sau. Enqueue vào ConcurrentQueue với T tham chiếu
        // không ném exception → handler không có đường ném ra ngoài.
        _inbox.Enqueue(e);

        // Publish đến từ thread Kestrel/dispatcher — Blazor chỉ render an toàn trên
        // dispatcher thread của component nên phải Marshal bằng InvokeAsync. Nội dung
        // Nodes chỉ đổi trong Flush (loop 100ms, cũng chạy qua InvokeAsync) nên render
        // ở đây là diff rỗng: không thrash, vẫn đảm bảo re-render đi qua đúng thread.
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Loop 100ms: drain inbox → áp event → dọn node hết hạn → render nếu có thay đổi.
    /// </summary>
    private async Task RunLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                // Tick 100ms — nhỏ hơn 500ms trong spec (§5.4): dọn node terminal sát giờ
                // hơn, vô hại vì render tối đa 10 lần/s và chỉ khi thật sự có thay đổi.
                await Task.Delay(TickMs, ct);

                // Mọi thao tác trên Nodes đều qua InvokeAsync → chỉ chạy trên dispatcher
                // thread, không race với render.
                await InvokeAsync(Flush);
            }
            catch (OperationCanceledException)
            {
                // DisposeAsync đã cancel — dừng vòng lặp.
                return;
            }
            catch (Exception ex)
            {
                // Một tick lỗi không được giết vòng render trace — ghi log rồi tiếp tục.
                Log.Error("RequestTrace: làm mới state thất bại.", ex);
            }
        }
    }

    /// <summary>Drain inbox, áp event, dọn node hết hạn, render khi có thay đổi — chỉ gọi trên dispatcher thread.</summary>
    private void Flush()
    {
        var changed = false;

        // G4: fetch lại map cooldown khi tập proxy down đổi (sig) hoặc quá 30s — snapshot
        // InMemory rẻ, chỉ bắn task khi thật cần; _cooldownBusy chặn fire-and-forget chồng nhau.
        if (_cooldown is not null && !_cooldownBusy)
        {
            // Đường phổ biến (không proxy nào down) phải ~0 allocation mỗi tick 100ms:
            // snapshot 1 lần, loop tay, chỉ dựng danh sách + sort khi thật sự có proxy down.
            var now = DateTimeOffset.UtcNow;
            List<long>? downIds = null;
            foreach (var s in ProxyPool.Snapshot())
            {
                if (s.IsDown && s.DownUntil > now)
                    (downIds ??= []).Add(s.Id);
            }
            // Sig = hash trên down-id ĐÃ SẮP XẾP (List.Sort mặc định dùng cùng comparer
            // với OrderBy cũ → semantics không đổi); rỗng = 0.
            var sig = 0;
            if (downIds is not null)
            {
                downIds.Sort();
                sig = downIds.Aggregate(17, (h, id) => h * 31 + id.GetHashCode());
            }
            if (sig != _lastDownSig || DateTimeOffset.UtcNow - _cooldownFetchedAt >= TimeSpan.FromSeconds(30))
            {
                _lastDownSig = sig;
                _cooldownFetchedAt = DateTimeOffset.UtcNow;
                _ = RefreshCooldownAsync();
            }
        }

        // Countdown đổi theo giây trên tick 100ms sẵn có (không timer riêng): sig chuỗi giây
        // khác lần trước → ép re-render để số giảm đúng lúc.
        var cooldownSig = CooldownSecondsSig();
        if (cooldownSig != _cooldownSig)
        {
            _cooldownSig = cooldownSig;
            changed = true;
        }

        TraceEvent? followEvent = null;
        while (_inbox.TryDequeue(out var e))
        {
            ApplyEvent(e);
            changed = true;
            // Giữ event CUỐI của tick: batch nhiều event trong 100ms → auto-follow chỉ
            // nhảy 1 lần (rbTrace.scrollTo no-op nếu điểm đã nằm trong viewport)
            followEvent = e;
        }

        if (RemoveExpired())
            changed = true;

        if (_litExpiresAt is { } litUntil && litUntil <= DateTimeOffset.UtcNow)
        {
            _litEndpoint = null;
            _litExpiresAt = null;
            changed = true;
        }

        // Dot chạy dọc line: tiến Idx theo thời gian trôi, dọn travel khi node bị gỡ
        // hoặc line dẫn đường đã fade xong — luôn gọi trước early-return để animation
        // vẫn chạy khi không có event mới
        if (AdvanceTravels(DateTimeOffset.UtcNow))
            changed = true;

        if (!changed)
            return;

        EnforceCap();
        StateHasChanged();

        // Auto-follow: cuộn vùng sơ đồ đưa anchor của event cuối về giữa. Node đã bị gỡ
        // (EnforceCap/RemoveExpired) thì bỏ qua; JS tự no-op khi điểm đã thấy nên người
        // dùng cuộn tay không bị giật. Chạy sau StateHasChanged để render áp event trước.
        if (followEvent is not null && _jsReady && !_disposed
            && Nodes.TryGetValue(followEvent.RequestId, out var followNode))
        {
            var (x, y) = AnchorOf(followNode);
            _ = InvokeAsync(async () =>
            {
                // when (!_disposed): component đã gỡ → element không còn, exception vô
                // nghĩa — để thoát khỏi catch thay vì ghi log rác
                try
                {
                    await JS.InvokeVoidAsync("rbTrace.scrollTo", _wrapRef, x, y);
                }
                catch (Exception ex) when (!_disposed)
                {
                    Log.Error("RequestTrace: cuộn theo event thất bại.", ex);
                }
            });
        }
    }

    /// <summary>
    /// Fetch map cooldown qua CooldownTracker — null (lỗi source) thì GIỮ map cũ
    /// (spec §3.5, Review Focus #4); gán + render phải qua dispatcher thread.
    /// </summary>
    private async Task RefreshCooldownAsync()
    {
        _cooldownBusy = true;
        try
        {
            var map = await _cooldown!.ResolveAsync(CancellationToken.None);
            // null = lỗi source → GIỮ map cũ (spec §3.5, Review Focus #4).
            // Guard _disposed như LoadProvidersAsync: fetch kết thúc sau khi component bị gỡ
            // thì InvokeAsync ném ObjectDisposedException (bị catch nuốt → log rác).
            if (map is not null && !_disposed)
                await InvokeAsync(() => { _cooldownMap = map; StateHasChanged(); });
        }
        catch (Exception ex)
        {
            Log.Error("RequestTrace: cooldown refresh failed — giữ map cũ", ex);
        }
        finally
        {
            _cooldownBusy = false;
        }
    }

    /// <summary>Sig theo giây của các entry còn hiệu lực trong <c>_cooldownMap</c> — khác → countdown đổi, phải render.</summary>
    private long CooldownSecondsSig()
    {
        var now = DateTimeOffset.UtcNow;
        long sig = 0;
        foreach (var (accountName, downUntil) in _cooldownMap)
        {
            if (downUntil <= now)
                continue;
            sig = sig * 31 + accountName.GetHashCode() * 1000003 + (long)Math.Ceiling((downUntil - now).TotalSeconds);
        }
        return sig;
    }

    /// <summary>Remaining của account đang cooldown; entry hết hạn bị GỠ hẳn khỏi map qua immutable copy
    /// (render là side-effect — không mutate map in-place; badge tắt đúng lúc DownUntil qua kể cả chưa refresh).</summary>
    private bool TryGetCooldown(string accountName, out TimeSpan remaining)
    {
        if (_cooldownMap.TryGetValue(accountName, out var downUntil))
        {
            var now = DateTimeOffset.UtcNow;
            var left = downUntil - now;
            if (left > TimeSpan.Zero) { remaining = left; return true; }

            // Hết hạn → xóa entry khỏi map MỘT lần (kèm luôn mọi entry khác đã qua hạn).
            // Không để sentinel MinValue: sentinel khiến mỗi render 10Hz của chip đó
            // copy lại cả dictionary cho tới lần refresh ≥30s kế tiếp.
            var alive = new Dictionary<string, DateTimeOffset>();
            foreach (var (name, until) in _cooldownMap)
            {
                if (until > now)
                    alive[name] = until;
            }
            _cooldownMap = alive;
        }
        remaining = default;
        return false;
    }

    /// <summary>Áp một trace event vào node của request — idempotent, tái tạo node nếu đã bị drop.</summary>
    private void ApplyEvent(TraceEvent e)
    {
        var isNew = !Nodes.TryGetValue(e.RequestId, out var before);
        // Chụp vị trí + stage TRƯỚC khi merge: _agg.Apply mutate node tại chỗ nên sau
        // dòng dưới before == node (cùng reference) — không đọc được trạng thái cũ nữa.
        var from = before is null ? default((int X, int Y)) : RenderedAnchor(before);
        var fromStage = before?.Stage;
        // Anchor + route CŨ trước merge: Attempt đổi account giữ NGUYÊN stage nhưng đổi
        // anchor (chip khác) — vẫn phải dựng travel. Đọc trước vì _agg.Apply mutate node
        // tại chỗ; route CŨ là vé để BuildLegs ngược đường cũ thay vì cắt chéo sang route mới.
        var fromAnchor = before is null ? default((int X, int Y)) : AnchorOf(before);
        var fromRoute = before is null ? null : ForwardRoutePoints(before);

        _agg.Apply(e);

        // G5: chỉ event nào MANG endpoint (Received đầu) mới thay ánh sáng —
        // update demote/HeadersSent để null → không đụng (spec §3.6)
        if (e.Endpoint is { } endpoint)
        {
            _litEndpoint = endpoint;
            _litExpiresAt = e.At + EndpointLitTtl;
        }

        // Dot chạy dọc line: node mới → trồi từ đáy Input; ĐỔI CHỖ → đi polyline
        // (BuildLegs bám lane/elbow thật, không nhảy chéo). Bootstrap không animate;
        // cùng anchor (update field/Received merge, slot chỉ lệch do căn giữa hàng) → không travel.
        if (_primed && Nodes.TryGetValue(e.RequestId, out var node))
        {
            // _layout chỉ tính lại khi render — event vừa áp có thể mang Route mới (Attempt)
            // nên phải tính lại TRƯỚC khi resolve anchor. Thiếu bước này AttemptAnchor fallback
            // về Thực thi (from == to) → travel bị bỏ sót → dot bay chéo bằng transition thường.
            RebuildBranchLayout();
            var to = AnchorOf(node);
            if (before is null)
                StartTravel(e.RequestId, node, (DotStartX, InputBottom), to, spawn: true);
            else if ((fromStage != node.Stage || fromAnchor != to) && from != to)
                StartTravel(e.RequestId, node, from, to, spawn: false, fromRoute);
        }

        // Node dựng lại từ id từng bị cap-drop → hoàn badge +N thay vì cộng dồn
        if (isNew && _droppedIds.Remove(e.RequestId))
            _overflow = Math.Max(0, _overflow - 1);
    }

    /// <summary>Gỡ node đã qua <see cref="TraceNodeState.ExpiresAt"/>. Trả về <see langword="true"/> nếu có node bị gỡ.</summary>
    private bool RemoveExpired()
    {
        var now = DateTimeOffset.UtcNow;
        List<string>? expiredIds = null;
        foreach (var (id, node) in Nodes)
        {
            if (node.ExpiresAt is { } expiresAt && expiresAt <= now)
                (expiredIds ??= []).Add(id);
        }

        if (expiredIds is null)
            return false;

        foreach (var id in expiredIds)
            Nodes.Remove(id);
        return true;
    }

    /// <summary>Giới hạn 60 node hiển thị: drop terminal cũ nhất trước, vẫn vượt → giữ 60 mới nhất + đếm _overflow.</summary>
    private void EnforceCap()
    {
        while (Nodes.Count > NodeCap)
        {
            var victim = Nodes.Values
                .OrderBy(n => n.ExpiresAt is null ? 1 : 0)
                .ThenBy(n => n.ReceivedAt)
                .ThenBy(n => n.Id, StringComparer.Ordinal)
                .First();
            Nodes.Remove(victim.Id);
            _droppedIds.Add(victim.Id);
            _overflow++;
        }
    }

    /// <summary>Tọa độ anchor của node theo stage hiện tại — Attempt trỏ tới chip Account của route (Task 6); anchor ngữ nghĩa map pixel tại đây.</summary>
    private (int X, int Y) AnchorOf(TraceNodeState n) => TraceNodeAggregator.AnchorOf(n) switch
    {
        TraceAnchor.Queue => (DotStartX, QueueTop + DotRowOffsetY),
        TraceAnchor.Dispatch => (DotStartX, DispatchTop + DotRowOffsetY),
        TraceAnchor.Attempt => AttemptAnchor(n),
        _ => (DotStartX, ClientTop + DotRowOffsetY),
    };

    /// <summary>
    /// Anchor cho Attempt: tâm dot inline của chip Account trong group route (spec G3).
    /// Chip không render được → lùi về node Provider; group chưa render (không có route) →
    /// lùi về nút Thực thi như Task 5 — dot không bao giờ nhảy ra ngoài layout.
    /// </summary>
    private (int X, int Y) AttemptAnchor(TraceNodeState n)
    {
        if (n.Route is not { Provider: { } providerName })
            return (DotStartX, DispatchTop + DotRowOffsetY);

        if (_layout.FindChip(providerName, n.Route!.Account ?? string.Empty) is { } chip)
            return (AccountLeft + ChipDotOffsetX, chip.Top + ChipDotOffsetY);

        if (_layout.FindProvider(providerName) is { } provider)
            return (ProviderLeft + ProviderDotOffsetX, provider.Top + DotRowOffsetY);

        return (DotStartX, DispatchTop + DotRowOffsetY);
    }

    /// <summary>
    /// Vị trí dot ĐANG render: đang travel thì lấy điểm mục tiêu hiện tại (đang giữa đường),
    /// không thì slot thật trong hàng — dùng làm điểm xuất phát khi stage đổi giữa chừng.
    /// </summary>
    private (int X, int Y) RenderedAnchor(TraceNodeState n) =>
        _travels.TryGetValue(n.Id, out var travel) ? travel.Points[travel.Idx] : RenderedSlot(n);

    /// <summary>
    /// Slot dot sẽ render trong hàng (căn giữa như <see cref="BuildGroups"/>) — travel xuất
    /// phát từ đây để không hop ngược về anchor giữa hàng khi dot đang nằm lệch trong group.
    /// </summary>
    private (int X, int Y) RenderedSlot(TraceNodeState n)
    {
        var anchor = AnchorOf(n);
        var shown = Nodes.Values
            .Where(x => AnchorOf(x) == anchor)
            .OrderBy(x => x.ReceivedAt)
            .ThenBy(x => x.Id, StringComparer.Ordinal)
            .Take(MaxDotsPerAnchor)
            .ToList();
        var idx = shown.FindIndex(x => x.Id == n.Id);
        if (idx < 0)
            return anchor;
        // Căn giữa như BuildGroups — CHỈ lane spine; nhánh giữ left-align
        if (anchor.X != DotStartX)
            return (anchor.X, anchor.Y);
        return (anchor.X - (shown.Count - 1) * DotStepX / 2 + idx * DotStepX, anchor.Y);
    }

    /// <summary>
    /// Dựng travel cho node: đường đi + line dẫn đường transient (dashed + ants màu đích).
    /// Stage đổi giữa chặng → ghi đè travel cũ, dot rebase từ <see cref="RenderedAnchor"/>.
    /// </summary>
    /// <param name="fromRoute">Route CŨ của node (trước merge) — dựng ngược đường cũ cho
    /// rebase cùng stage; <see langword="null"/> khi spawn/stage đổi thường.</param>
    private void StartTravel(string id, TraceNodeState node, (int X, int Y) from, (int X, int Y) to, bool spawn, List<(int X, int Y)>? fromRoute = null)
    {
        List<(int X, int Y)> points;
        if (spawn)
        {
            // Element mới không có vị trí cũ để transition → tự đặt điểm đầu tại đáy Input,
            // rồi đi tiếp tuyến đường coi như xuất phát từ Hàng đợi
            points = [(DotStartX, InputBottom)];
            points.AddRange(BuildLegs(node, (DotStartX, QueueTop + DotRowOffsetY), to));
        }
        else
        {
            points = BuildLegs(node, from, to, fromRoute);
        }

        if (points.Count == 0)
            return;

        var now = DateTimeOffset.UtcNow;
        _travels[id] = new TravelState
        {
            Points = points,
            Path = BuildTravelPath(from, points),
            Stroke = TravelStroke(node),
            StartAt = now,
            // Điểm cuối + TravelSettle: transition .35s chạy xong mới tính "tới nơi"
            ArrivalAt = now + TimeSpan.FromTicks(TravelStep.Ticks * (points.Count - 1)) + TravelSettle,
        };
    }

    /// <summary>
    /// Đường đi của dot khi đổi chỗ — luôn bám lane/elbow thật, không nhảy chéo canvas:
    /// cùng spine → snap slot về lane tâm rồi đi thẳng; từ nhánh về spine → ngược route về
    /// cổng ra Thực thi rồi jog ngang vào lane; Cancel/lỗi → đi đúng lane dây ②/③ đang
    /// sáng (mockup dot rides its wire); Attempt → jog ngang tại row Thực thi rồi theo elbow.
    /// </summary>
    /// <param name="fromRoute">Route CŨ khi rebase trong nhánh (Attempt đổi account —
    /// node đã mang route mới, cắt theo route cũ sẽ ra chéo).</param>
    private List<(int X, int Y)> BuildLegs(TraceNodeState node, (int X, int Y) from, (int X, int Y) to, List<(int X, int Y)>? fromRoute = null)
    {
        var route = ForwardRoutePoints(node);

        // Terminal có lane riêng — dot đi ĐÚT TRÊN dây vàng/đỏ đang sáng, không đi giữa node
        if (node.Stage == TraceStage.Canceled)
            return TerminalLaneLegs(route, from, to, CancelLaneX);
        if (node.Stage is TraceStage.Finished && node.Success == false)
            return TerminalLaneLegs(route, from, to, ErrorLaneX);

        var fromBranch = from.X > DispatchExitX;
        var toBranch = to.X > DispatchExitX;

        // Rebase trong nhánh (Attempt đổi account giữa chặng — stage giữ nguyên):
        // có route CŨ → ngược về cổng ra rồi theo route MỚI; không thì cắt route hiện tại
        if (fromBranch && toBranch)
        {
            if (fromRoute is not null)
            {
                var rebase = RouteCutLegs(fromRoute, from, (DispatchExitX, DispatchExitY), reverse: true);
                if (route is not null)
                    rebase.AddRange(RouteCutLegs(route, (DispatchExitX, DispatchExitY), to));
                else if (rebase.Count == 0 || rebase[^1] != to)
                    rebase.Add(to);
                return rebase;
            }
            return route is null ? [to] : RouteCutLegs(route, from, to);
        }

        // Từ nhánh về spine (Parked/Finished success/...): về cổng ra trước, jog vào lane tâm
        if (fromBranch)
        {
            var back = route is null ? [(DotStartX, DispatchExitY)] : RouteCutLegs(route, from, (DotStartX, DispatchExitY), reverse: true);
            back.Add(to);
            return back;
        }

        // Ra nhánh (Attempt): jog ngang tại row Thực thi — không chéo xuyên node
        if (toBranch)
        {
            var pts = new List<(int X, int Y)>();
            if (from.X != DotStartX && from.Y != DispatchExitY)
                pts.Add((DotStartX, from.Y));          // snap slot lệch về lane tâm
            if (pts.Count == 0 || pts[^1] != (DotStartX, DispatchExitY))
                pts.Add((DotStartX, DispatchExitY));    // jog tại row cổng ra
            if (route is not null)
                pts.AddRange(RouteCutLegs(route, from, to));
            else
                pts.Add(to);
            return pts;
        }

        // Cùng spine: snap slot lệch (hàng căn giữa) về lane tâm rồi đi thẳng
        var spine = new List<(int X, int Y)>();
        if (from.X != DotStartX)
            spine.Add((DotStartX, from.Y));
        if (spine.Count == 0 || spine[^1] != to)
            spine.Add(to);
        return spine;
    }

    /// <summary>
    /// Dot Cancel/lỗi: vào lane tại mép dưới node đang đứng (queue → <see cref="QueueBottom"/>,
    /// dispatch → <see cref="DispatchBottom"/>) — đúng hàng start của dây ②/③ — đi xuống row
    /// Client rồi về slot. Từ nhánh thì về cổng ra Thực thi trước.
    /// </summary>
    private List<(int X, int Y)> TerminalLaneLegs(List<(int X, int Y)>? route, (int X, int Y) from, (int X, int Y) to, int laneX)
    {
        List<(int X, int Y)> pts;
        if (from.X > DispatchExitX)
        {
            pts = route is null ? [(laneX, DispatchExitY)] : RouteCutLegs(route, from, (laneX, DispatchExitY), reverse: true);
        }
        else
        {
            pts = [];
            if (from.X != DotStartX)
                pts.Add((DotStartX, from.Y));
            var jogY = from.Y < DispatchTop ? QueueBottom : DispatchBottom;
            pts.Add((DotStartX, jogY));
            pts.Add((laneX, jogY));
        }
        pts.Add((laneX, ClientTop + DotRowOffsetY));
        pts.Add(to);
        return pts;
    }

    /// <summary>
    /// Cắt route tại điểm gần <paramref name="from"/> nhất (rebase giữa chặng không nhảy)
    /// rồi nối tới <paramref name="to"/> — cùng geometry với connector đang vẽ
    /// (<see cref="RebuildBranchLayout"/>).
    /// </summary>
    private static List<(int X, int Y)> RouteCutLegs(IReadOnlyList<(int X, int Y)> route, (int X, int Y) from, (int X, int Y) to, bool reverse = false)
    {
        List<(int X, int Y)> path = reverse ? [.. route.AsEnumerable().Reverse()] : [.. route];
        var pts = new List<(int X, int Y)>();
        var k = NearestIndex(path, from);
        if (path[k] != from)
            pts.Add(path[k]);
        for (var i = k + 1; i < path.Count; i++)
            pts.Add(path[i]);
        if (pts.Count == 0 || pts[^1] != to)
            pts.Add(to);
        return pts;
    }

    /// <summary>
    /// Polyline cửa ra Thực thi → nhánh Attempt — copy đúng geometry connector đang vẽ
    /// (elbow ở trung điểm 2 cột; chip bị cắt thì đường dừng tại Provider).
    /// </summary>
    private List<(int X, int Y)>? ForwardRoutePoints(TraceNodeState node)
    {
        if (node.Route is not { Provider: { } providerName })
            return null;
        var combo = _layout.Combos.FirstOrDefault(c => c.Name == (node.Route!.Combo ?? string.Empty));
        var provider = _layout.FindProvider(providerName);
        if (combo is null || provider is null)
            return null;

        var cy = combo.Top + NodeElbowOffsetY;
        var py = provider.Top + NodeElbowOffsetY;
        var m1 = (DispatchExitX + ComboLeft) / 2;
        var m2 = (ComboLeft + ComboWidth + ProviderLeft) / 2;
        var pts = new List<(int X, int Y)>
        {
            (DispatchExitX, DispatchExitY),
            (m1, DispatchExitY),
            (m1, cy),
            (ComboLeft, cy),
            (ComboLeft + ComboWidth, cy),
            (m2, cy),
            (m2, py),
            (ProviderLeft, py),
        };

        if (_layout.FindChip(providerName, node.Route!.Account ?? string.Empty) is { } chip)
        {
            var m3 = (ProviderLeft + ProviderWidth + AccountLeft) / 2;
            var chy = chip.Top + ChipElbowOffsetY;
            pts.Add((ProviderLeft + ProviderWidth, py));
            pts.Add((m3, py));
            pts.Add((m3, chy));
            pts.Add((AccountLeft, chy));
        }
        return pts;
    }

    /// <summary>Chỉ số điểm gần <paramref name="from"/> nhất (đường đi cắt tại đó khi rebase giữa chặng).</summary>
    private static int NearestIndex(IReadOnlyList<(int X, int Y)> path, (int X, int Y) from)
    {
        var best = 0;
        var bestD = long.MaxValue;
        for (var i = 0; i < path.Count; i++)
        {
            var dx = (long)path[i].X - from.X;
            var dy = (long)path[i].Y - from.Y;
            var d = dx * dx + dy * dy;
            if (d < bestD)
            {
                bestD = d;
                best = i;
            }
        }
        return best;
    }

    /// <summary>String polyline M…L… cho path svg — StringBuilder để không nối string giữa chừng.</summary>
    private static string BuildTravelPath((int X, int Y) from, List<(int X, int Y)> points)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append('M').Append(from.X).Append(',').Append(from.Y);
        foreach (var (x, y) in points)
            sb.Append(" L").Append(x).Append(',').Append(y);
        return sb.ToString();
    }

    /// <summary>Màu line dẫn đường = màu trạng thái ĐÍCH — cùng bảng với TraceColors/legend.</summary>
    private static string TravelStroke(TraceNodeState node) => node.Stage switch
    {
        TraceStage.DispatchStarted or TraceStage.Attempt => "#3b82f6",
        TraceStage.Canceled => "#eab308",
        TraceStage.Finished => node.Success == false ? "#ef4444" : "#22c55e",
        _ => "#ffffff",
    };

    /// <summary>Opacity line dẫn đường: full khi dot còn đi, fade về 0 trong <see cref="TravelFade"/> sau khi tới nơi.</summary>
    private static string TravelOpacity(TravelState travel, DateTimeOffset now)
    {
        if (now <= travel.ArrivalAt)
            return "1";
        var fading = 1d - (now - travel.ArrivalAt).TotalMilliseconds / TravelFade.TotalMilliseconds;
        if (fading <= 0)
            return "0";
        // Invariant culture: decimal ',' của locale vi-VN sẽ làm opacity CSS hỏng
        return fading.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Tiến dot dọc line theo tick render (Idx nhảy về điểm theo thời gian đã trôi) và dọn
    /// travel khi node bị gỡ hoặc line đã fade xong. Trả về <see langword="true"/> nếu cần
    /// render (đổi điểm / đang fade / gỡ entry).
    /// </summary>
    private bool AdvanceTravels(DateTimeOffset now)
    {
        if (_travels.Count == 0)
            return false;

        var changed = false;
        List<string>? gone = null;
        foreach (var (id, travel) in _travels)
        {
            if (!Nodes.ContainsKey(id))
            {
                // Node đã hết hạn/bị drop → travel mồ côi không được giữ line trên canvas
                (gone ??= []).Add(id);
                changed = true;
                continue;
            }

            var target = Math.Min(travel.Points.Count - 1, (now - travel.StartAt).Ticks / TravelStep.Ticks);
            if (target > travel.Idx)
            {
                travel.Idx = (int)target;
                changed = true;
            }

            if (now > travel.ArrivalAt + TravelFade)
            {
                (gone ??= []).Add(id);
                changed = true;
            }
            else if (now > travel.ArrivalAt)
            {
                changed = true; // đang fade → opacity đổi mỗi tick, buộc phải render
            }
        }

        if (gone is not null)
        {
            foreach (var id in gone)
                _travels.Remove(id);
        }
        return changed;
    }

    /// <summary>
    /// Tính lại layout nhánh từ <c>Nodes</c> còn hạn — gọi đầu mỗi render.
    /// Chỉ group có node tham chiếu (<c>Route.Provider</c> khác null) được vẽ (spec §5.1);
    /// thứ tự = xuất hiện đầu tiên của group trong <c>Nodes</c>, tọa độ cột fixed theo mockup.
    /// </summary>
    private void RebuildBranchLayout()
    {
        var layout = new BranchLayout();
        _layout = layout;
        // Về mức tối thiểu trước — nhánh rỗng return sớm ở dưới không cần tính lại
        _canvasHeight = MinCanvasHeight;

        // Sắp (ReceivedAt, Id) để thứ tự "xuất hiện đầu tiên" ổn định giữa các lần render —
        // Dictionary không giữ thứ tự enumerate, không được dựa vào nó.
        var routed = Nodes.Values
            .Where(n => n.Route?.Provider is not null)
            .OrderBy(n => n.ReceivedAt)
            .ThenBy(n => n.Id, StringComparer.Ordinal)
            .ToList();
        if (routed.Count == 0)
        {
            // Không còn node route → không còn provider nào trong layout → đóng panel expand
            _expandedIdleProvider = null;
            return;
        }

        var groups = routed
            .GroupBy(n => (Combo: n.Route!.Combo ?? string.Empty,
                           Provider: n.Route!.Provider!,
                           Account: n.Route!.Account ?? string.Empty))
            .Select(g => new BranchGroup(g.Key.Combo, g.Key.Provider, g.Key.Account, g.ToList()))
            .ToList();

        // Cột Combo: mỗi combo distinct một block, xếp dọc theo thứ tự xuất hiện
        var comboNames = groups.Select(g => g.Combo).Distinct(StringComparer.Ordinal).ToList();
        var comboIndex = new Dictionary<string, int>(StringComparer.Ordinal);
        for (var i = 0; i < comboNames.Count; i++)
        {
            var name = comboNames[i];
            comboIndex[name] = i;
            var nodes = groups.Where(g => g.Combo == name).SelectMany(g => g.Nodes).ToList();
            // Mode do DispatchStarted ghi, ApplyEvent giữ lại khi node chuyển sang Attempt
            var mode = nodes.Select(n => n.Mode).FirstOrDefault(m => m is not null);
            var running = nodes.Any(n => n.Stage is TraceStage.DispatchStarted or TraceStage.Attempt);
            layout.Combos.Add(new ComboBlock(name, mode, ComboStartY + i * ComboRowH, running));
        }

        // Cột Provider + chip Account — lane dồn theo số chip (chip 34px, lane ≥ 110px như mockup)
        var laneTop = ProviderStartY;
        foreach (var providerGroup in groups.GroupBy(g => g.Provider))
        {
            var providerName = providerGroup.Key;
            var pGroups = providerGroup.ToList();

            // TK đang tham chiếu: GroupBy giữ thứ tự xuất hiện, OrderByDescending (stable sort)
            // đưa TK đang chạy lên trước khi vượt max 4 chip — "active trước" (spec §5.2)
            var accounts = pGroups
                .GroupBy(g => g.Account)
                .Select(ag => (Name: ag.Key,
                                Running: ag.Any(x => x.Running),
                                HasError: ag.Any(x => x.HasError)))
                .OrderByDescending(a => a.Running)
                .ToList();
            var shown = accounts.Take(MaxAccountChips).ToList();

            // Tổng số TK lấy từ cache IProviderService; provider chưa có trong cache →
            // không biết tổng → bỏ chip idle thay vì hiển thị N sai cho người dùng.
            var providerEntity = _providers.FirstOrDefault(
                p => string.Equals(p.Name, providerName, StringComparison.Ordinal));
            var activeCount = accounts.Count;
            var idleCount = providerEntity is { } pe ? Math.Max(0, pe.Accounts.Count - activeCount) : 0;
            var chipTotal = shown.Count + (idleCount > 0 ? 1 : 0);
            var laneHeight = Math.Max(ProviderRowH, ChipLanePadY + chipTotal * ChipRowH);

            var running = pGroups.Any(g => g.Running);
            var hasError = pGroups.Any(g => g.HasError);
            // Tag lỗi: status ≥ 400 của node xuất hiện đầu — mockup hiện đúng 1 tag (429)
            var errorStatus = pGroups
                .SelectMany(g => g.Nodes)
                .FirstOrDefault(n => n.Status is >= 400)?.Status;
            // Provider căn theo TÂM cụm chip của lane chứ không theo đầu lane — theo mockup
            // 118/228/326 đều = tâm cụm chip − 20; căn theo đầu lane sẽ trệ ~50px ở lane2+
            // và clip đáy canvas 415px ngay ở mật độ 3 provider của mockup.
            var providerTop = laneTop + ((chipTotal - 1) * ChipRowH + ChipHeight) / 2 - NodeElbowOffsetY;
            layout.Providers.Add(new ProviderBlock(providerName, providerTop, running, hasError, errorStatus));

            for (var k = 0; k < shown.Count; k++)
            {
                layout.Chips.Add(new AccountChip(
                    providerName, shown[k].Name, laneTop + k * ChipRowH,
                    IsIdle: false, Running: shown[k].Running, HasError: shown[k].HasError,
                    IdleCount: 0, IdleAccounts: []));
            }

            if (idleCount > 0)
            {
                // Panel expand = toàn bộ TK của provider (spec §5.5); dot active suy ra node
                // đang sống trong Nodes (Living), pulse nếu TK đang có request chạy (Running).
                var known = providerEntity?.Accounts.Select(a => a.Name).ToList() ?? [];
                var referenced = pGroups.Select(g => g.Account).Distinct().ToList();
                var entryNames = known.Concat(referenced.Where(r => !known.Contains(r))).ToList();
                var entries = entryNames
                    .Select(name => new IdleAccount(
                        name,
                        Living: pGroups.Any(g => g.Account == name),
                        Running: pGroups.Any(g => g.Account == name && g.Running)))
                    .ToList();
                layout.Chips.Add(new AccountChip(
                    providerName, string.Empty, laneTop + shown.Count * ChipRowH,
                    IsIdle: true, Running: false, HasError: false,
                    IdleCount: idleCount, IdleAccounts: entries));
            }

            laneTop += laneHeight;
        }

        // Panel expand không được "tự mở lại" khi provider biến mất khỏi layout (node expire) —
        // flag là state component, layout tính lại mỗi render nên dọn ngay tại đây.
        if (_expandedIdleProvider is not null && layout.FindProvider(_expandedIdleProvider) is null)
        {
            _expandedIdleProvider = null;
        }

        // Connector per group: Thực thi → Combo → Provider → Account (elbow ở trung điểm 2 cột).
        // Tách từng đoạn (giống mockup): block nền trong nên không kẻ đường xuyên qua trong block.
        foreach (var g in groups)
        {
            // Defensive: combo/provider dựng ngay từ groups ở trên — không bao giờ vắng.
            if (!comboIndex.TryGetValue(g.Combo, out var comboIdx))
                continue;
            var providerBlock = layout.FindProvider(g.Provider);
            if (providerBlock is null)
                continue;

            var cy = layout.Combos[comboIdx].Top + NodeElbowOffsetY;
            var py = providerBlock.Top + NodeElbowOffsetY;
            var m1 = (DispatchExitX + ComboLeft) / 2;
            var m2 = (ComboLeft + ComboWidth + ProviderLeft) / 2;
            var segments = new List<string>
            {
                $"M{DispatchExitX},{DispatchExitY} L{m1},{DispatchExitY} L{m1},{cy} L{ComboLeft},{cy}",
                $"M{ComboLeft + ComboWidth},{cy} L{m2},{cy} L{m2},{py} L{ProviderLeft},{py}",
            };

            // Chip bị cắt (vượt max 4) → đường dừng tại Provider
            if (layout.FindChip(g.Provider, g.Account) is { } chip)
            {
                var m3 = (ProviderLeft + ProviderWidth + AccountLeft) / 2;
                var chy = chip.Top + ChipElbowOffsetY;
                segments.Add($"M{ProviderLeft + ProviderWidth},{py} L{m3},{py} L{m3},{chy} L{AccountLeft},{chy}");
            }

            layout.Paths.Add(new BranchPath(segments, g.HasError));
        }

        // Chiều cao canvas tính SAU khi mọi block/chip/panel expand đã dựng xong
        // (kể cả khi panel idle vừa bị đóng ở trên) — nội dung tràn đáy cuộn tới thay vì clip
        UpdateCanvasHeight(layout);
    }

    /// <summary>
    /// Mở rộng chiều cao canvas theo nội dung nhánh thật: block Combo/Provider, chip Account
    /// và panel expand đang mở — vùng sơ đồ cuộn tới thay vì clip đáy (user 2026-10-08).
    /// </summary>
    private void UpdateCanvasHeight(BranchLayout layout)
    {
        var bottom = 0;
        foreach (var combo in layout.Combos)
            bottom = Math.Max(bottom, combo.Top + BranchBlockH);
        foreach (var provider in layout.Providers)
            bottom = Math.Max(bottom, provider.Top + BranchBlockH);

        foreach (var chip in layout.Chips)
        {
            bottom = Math.Max(bottom, chip.Top + ChipHeight);

            if (chip.IsIdle && _expandedIdleProvider == chip.Provider)
            {
                // Panel expand ước lượng theo đúng hướng của IdleListStyle (mở xuống/mở lên);
                // giữ đơn giản: mỗi dòng ~18px + padding, chặn ở max-height CSS
                // .trace-idle-list — panel tự cuộn trong nên canvas không phình vô hạn
                // theo số TK idle.
                var listH = Math.Min(IdleListMaxH, chip.IdleAccounts.Count * IdleListRowH + IdleListPadY);
                var listTop = chip.Top > IdleListUpThreshold
                    ? chip.Top - 4 - listH          // mở lên: đáy panel cách đỉnh chip 4px
                    : chip.Top + IdleChipHeight;    // mở xuống: ngay dưới chip
                bottom = Math.Max(bottom, listTop + listH);
            }
        }

        _canvasHeight = Math.Max(MinCanvasHeight, bottom + CanvasBottomPad);
    }

    /// <summary>Class dot indicator: rỗng = xanh pulse (đang chạy), đỏ khi lỗi còn lại, xám khi chỉ còn terminal.</summary>
    private static string NodeDotClass(bool running, bool hasError) =>
        running ? "" : hasError ? "trace-idot--err" : "trace-idot--dim";

    /// <summary>
    /// Panel expand: mở xuống dưới chip nếu còn chỗ, ngược lại mở lên trên — giữ panel sát
    /// chip trong vùng nhìn được. <c>bottom</c> phải theo chiều cao canvas THẬT
    /// (<see cref="CanvasHeight"/>): canvas giờ cao theo nội dung, dùng 415 cố định sẽ
    /// tách panel khỏi chip.
    /// </summary>
    private string IdleListStyle(AccountChip chip) =>
        chip.Top > IdleListUpThreshold
            ? $"left:{AccountLeft}px;bottom:{CanvasHeight - chip.Top + 4}px"
            : $"left:{AccountLeft}px;top:{chip.Top + IdleChipHeight}px";

    /// <summary>Bật/tắt panel inline danh sách TK khi click chip "+N idle" (spec §5.5 — không dùng Modal).</summary>
    private void ToggleIdleProvider(string provider) =>
        _expandedIdleProvider = _expandedIdleProvider == provider ? null : provider;

    /// <summary>Mở modal chi tiết timeline — gọi từ onclick của circle request trên sơ đồ.</summary>
    private void OpenDetail(string id) => _selectedId = id;

    /// <summary>Đóng modal chi tiết — Modal gọi qua OnClose khi người dùng Esc/backdrop/×.</summary>
    private void CloseDetail() => _selectedId = null;

    /// <summary>Nhóm node theo anchor, tối đa 6 dot/nhóm + badge +N cho phần dư.</summary>
    private List<DotGroup> BuildGroups() =>
        Nodes.Values
            .GroupBy(AnchorOf)
            .Select(g =>
            {
                var ordered = g
                    .OrderBy(n => n.ReceivedAt)
                    .ThenBy(n => n.Id, StringComparer.Ordinal)
                    .ToList();
                var shown = ordered.Take(MaxDotsPerAnchor).ToList();
                // Căn giữa hàng dot CHỈ trên lane tâm (spine) — mockup slot dot nằm giữa node
                // theo spine. Nhánh (chip/provider) giữ left-align: chip có inline dotrow ở
                // mép trái, căn giữa sẽ đè dot lên border + inline idot.
                var x = g.Key.X == DotStartX
                    ? g.Key.X - (shown.Count - 1) * DotStepX / 2
                    : g.Key.X;
                return new DotGroup(x, g.Key.Y, shown, ordered.Count - shown.Count);
            })
            .OrderBy(g => g.Y)
            .ThenBy(g => g.X)
            .ToList();

    /// <summary>Class dòng path trên node Input — sáng xanh khi endpoint vừa được request dùng (G5).</summary>
    private string PathLitClass(string endpoint) => _litEndpoint == endpoint ? "trace-node__path trace-node__path--lit" : "trace-node__path";

    /// <summary>Màu circle theo trạng thái — spec G2; delegate sang <see cref="TraceColors.ForStage"/>
    /// (một nguồn sự thật cho màu — API Monitor đọc cùng bảng này).</summary>
    private static string ColorClass(TraceNodeState n) => TraceColors.ForStage(n.Stage, n.Success);

    /// <summary>Gỡ subscription và dừng vòng render — tránh leak delegate trên feed singleton.</summary>
    public ValueTask DisposeAsync()
    {
        // Bắt buộc unsubscribe: feed là singleton, giữ delegate trỏ vào component đã
        // dispose là leak + handler chạy vô ích cho mỗi event.
        Feed.Published -= OnPublished;

        // Đánh dấu trước khi cancel — LoadProvidersAsync fire-and-forget có thể đang chạy,
        // callback không được StateHasChanged trên component đã gỡ.
        _disposed = true;

        // Chỉ Cancel, không Dispose: vòng lặp còn đăng ký Task.Delay trên token này;
        // CTS không giữ tài nguyên native nên GC thu hồi an toàn.
        _cts.Cancel();
        return ValueTask.CompletedTask;
    }
}
