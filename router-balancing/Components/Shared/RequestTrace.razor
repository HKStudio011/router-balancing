@using System.Collections.Concurrent
@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Engine
@using RouterBalancing.Core.Providers
@inject ITraceFeed Feed
@inject IProxyHost Proxy
@inject ILogService Log
@inject IProviderService ProviderService
@inject LocalizationService L
@implements IAsyncDisposable

<style>
    /* CSS theo mockup trace-design-v2.html — priority 7 (style inline trong razor, xem style.css) */
    .trace-wrap {
        overflow-x: auto;
        padding-bottom: 6px;
    }

    .trace-canvas {
        position: relative;
        width: 740px;
        height: 415px;
        font-size: 11px;
        /* Clip nhánh tràn đáy (nhiều combo/provider hơn mockup) thay vì build scrolling —
           ruling Task 6: clamp là chấp nhận được; panel expand tự chọn hướng để vừa vùng này */
        overflow: hidden;
    }

    .trace-svg {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .trace-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .trace-title {
        font-weight: 600;
        font-size: 14px;
    }

    .trace-counts {
        display: flex;
        gap: 12px;
        font-size: 11px;
        opacity: .85;
        flex-wrap: wrap;
        align-items: center;
    }

    .trace-node {
        position: absolute;
        border: 1.5px solid #8b8fa3;
        background: rgba(255, 255, 255, .055);
        border-radius: 8px;
        padding: 5px 8px;
        text-align: center;
        line-height: 1.35;
    }

    /* Node đang có request đi qua (mockup .n.act) */
    .trace-node--act {
        border-color: #3b82f6;
        box-shadow: 0 0 0 1px rgba(59, 130, 246, .4), 0 0 12px rgba(59, 130, 246, .18);
    }

    .trace-node .cap {
        display: block;
        font-size: 9px;
        line-height: 12px;
        opacity: .55;
        text-transform: uppercase;
        letter-spacing: .05em;
        /* Cấm wrap: cap giữ đúng 1 dòng để dòng dot tuyệt đối (AnchorOf = top node + 17px)
           luôn thẳng hàng với slot trong node */
        white-space: nowrap;
    }

    /* Slot dành chỗ cho dot absolute — cao 12px bằng đúng kích thước dot */
    .trace-node__slot {
        height: 12px;
    }

    /* 2 dòng endpoint trong INPUT node — 9px (bằng cap) + lh 11px + nowrap (đo trên WebView2:
       "POST /v1/chat/completions" = 99.6px, "POST /v1/responses" = 73.1px, vừa khung trong
       101px của node width:120px → mỗi path đúng 1 dòng, không truncate).
       Chiều cao box = 2×1.5 border + 2×5 padding + 12 cap + 2×11 lines = 47px → đáy = top 8 +
       47 = 55px, sát điểm bắt đầu spine (y=52) và thấp hơn box 11px hiện tại (~62px; font 11px
       sẽ tràn 3 dòng, đáy ~77px → spine cắt ngang text).
       nowrap: margin fit chỉ ~1.4px — nhỡ DPI/font metric lệch thì cấm wrap sau '/' thành dòng 3;
       thà tràn ngang vài px còn hơn đổi hình học node (nguyên tắc như .cap). */
    .trace-node__paths {
        display: block;
        font-size: 9px;
        line-height: 11px;
        white-space: nowrap;
    }

    /* Circle = request: transition left/top tạo hiệu ứng di chuyển trên đường (không JS) */
    .trace-dot {
        position: absolute;
        box-sizing: border-box;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        transition: left .35s ease, top .35s ease;
    }

    .trace-dot--white { background: #fff; border: 1.5px solid #9aa0aa; }
    .trace-dot--blue { background: #3b82f6; }
    .trace-dot--green { background: #22c55e; }
    .trace-dot--red { background: #ef4444; }
    .trace-dot--yellow { background: #eab308; }

    .trace-badge {
        font-size: 9.5px;
        border: 1px solid rgba(139, 143, 163, .55);
        border-radius: 999px;
        padding: 0 6px;
        opacity: .75;
    }

    .trace-badge--float {
        position: absolute;
        box-sizing: border-box;
        height: 13px;
        line-height: 11px;
    }

    /* Ring vàng đứt quanh dot đang chờ slot (G1 — mockup .lt-park-ring) */
    .trace-dot--park {
        outline: 1.5px dashed #eab308;
        outline-offset: 2px;
    }

    /* Cột badge bên phải node Hàng đợi (mockup left 132 — G1/G2/G3 dùng chung) */
    .trace-queue-badges {
        position: absolute;
        display: flex;
        gap: 4px;
        align-items: center;
        white-space: nowrap;
        z-index: 5;
    }

    .trace-badge--park {
        color: #eab308;
        border-color: #eab308;
        border-style: dashed;
    }

    .trace-legend {
        display: flex;
        gap: 10px;
        font-size: 10.5px;
        opacity: .8;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 8px;
    }

    .trace-legend__item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .trace-legend__hint {
        opacity: .65;
    }

    .trace-ldot {
        display: inline-block;
        box-sizing: border-box;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* ===== Nhánh Combo → Provider → Account (copy từ mockup .n/.acct/.tag — Task 6) ===== */

    /* Node nhánh lỗi (mockup .n.err) */
    .trace-node--err {
        border-color: #ef4444;
        box-shadow: 0 0 0 1px rgba(239, 68, 68, .4);
    }

    /* Chip account (mockup .acct) — absolute như node, nội dung 1 dòng */
    .trace-chip {
        position: absolute;
        box-sizing: border-box;
        border: 1.5px solid #8b8fa3;
        background: rgba(255, 255, 255, .05);
        border-radius: 6px;
        padding: 4px 7px;
        font-size: 10.5px;
        line-height: 1.35;
        white-space: nowrap;
        text-align: left;
    }

    .trace-chip--act { border-color: #3b82f6; }
    .trace-chip--err { border-color: #ef4444; }

    /* Chip "+N idle" (mockup .acct.idle) — click expand danh sách inline */
    .trace-chip--idle {
        border-style: dashed;
        opacity: .6;
        background: transparent;
        cursor: pointer;
    }

    /* Dot indicator inline trong node/chip nhánh (mockup .dot) — khác .trace-dot (tuyệt đối, = circle request) */
    .trace-idot {
        display: inline-block;
        box-sizing: border-box;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #3b82f6;
        vertical-align: -2px;
        animation: trace-pulse 1.3s ease-in-out infinite;
    }

    /* Còn node sống nhưng không có request đang chạy (mockup .dot.white opacity .5) */
    .trace-idot--dim {
        background: #fff;
        border: 1.5px solid #9aa0aa;
        opacity: .5;
        animation: none;
    }

    /* Lỗi nhưng không chạy — dot đỏ đứng yên */
    .trace-idot--err {
        background: #ef4444;
        animation: none;
    }

    @@keyframes trace-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.35); }
    }

    /* Tag status lỗi trong node Provider (mockup .tag.bad) */
    .trace-tag {
        font-size: 9px;
        border: 1px solid rgba(139, 143, 163, .6);
        border-radius: 4px;
        padding: 0 4px;
    }

    .trace-tag--bad {
        border-color: #ef4444;
        color: #ef4444;
    }

    /* Panel inline danh sách TK khi click chip "+N idle" (spec §5.5 — inline, không Modal) */
    .trace-idle-list {
        position: absolute;
        z-index: 30;
        box-sizing: border-box;
        width: 144px;
        max-height: 160px;
        overflow-y: auto;
        border: 1px dashed rgba(139, 143, 163, .6);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        padding: 6px 8px;
        font-size: 10.5px;
    }

    .trace-idle-list ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .trace-idle-list li {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 0;
        overflow-wrap: anywhere;
    }
</style>

<div class="mb-4 rounded border border-border bg-surface p-4">
    <div class="trace-head">
        <span class="trace-title">📊 @L["trace.title"]</span>
        @* Count row đã gộp sang strip API Monitor (user quyết 2026-10-07, mockup merge-counts A):
           state live đọc trực tiếp từ circles + legend; chỉ giữ badge drop-over-cap ở đây. *@
        <div class="trace-counts">
            @* Badge node bị drop khi vượt cap 60 (khác badge +N theo anchor bên dưới) *@
            @if (_overflow > 0)
            {
                <span class="trace-badge">@string.Format(L["trace.more"], _overflow)</span>
            }
        </div>
    </div>

    <div class="trace-wrap">
        <div class="trace-canvas">
            @* Tính lại layout nhánh TRƯỚC khi vẽ — svg/branch node/dot cùng đọc _layout trong 1 render *@
            @{ RebuildBranchLayout(); }

            <svg class="trace-svg" width="740" height="415">
                @* Đường nối spine — coords theo mockup; đoạn Thực thi→Client nối thêm cho đủ spine *@
                <g fill="none" stroke="#8b8fa3" stroke-width="1.6" opacity=".55">
                    <path d="M68,52 L68,96" />
                    <path d="M68,152 L68,188" />
                    <path d="M68,244 L68,336" />
                </g>
                @* Nhánh route per group — đỏ khi group có node lỗi, ngược lại xanh marching-ants (mockup);
                   tách từng đoạn như mockup để đường KHÔNG kẻ xuyên qua block (block nền trong) *@
                @foreach (var path in _layout.Paths)
                {
                    <g fill="none" stroke="@(path.HasError ? "#ef4444" : "#3b82f6")" stroke-width="1.8"
                       stroke-dasharray="7 6" opacity="@(path.HasError ? ".9" : "1")">
                        @foreach (var segment in path.Segments)
                        {
                            <path d="@segment">
                                <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                            </path>
                        }
                    </g>
                }
                @* (Bỏ 2 circle ornament lặp vô hạn của mockup — user report: bị hiểu nhầm là request
                   đang chạy khi không có request nào; trái nguyên tắc "hình thật cần, không phải
                   animation trang trí" spec §5.1). marching-ants ở trên giữ vì nó GẮN DATA — chỉ vẽ
                   khi có đường route thật. *@
            </svg>

            @* Skeleton spine — luôn vẽ kể cả khi idle (spec §5.1); tọa độ fixed theo mockup *@
            <div class="trace-node" style="left:8px;top:8px;width:120px">
                <span class="cap">@L["trace.node.input"]</span>
                @* Path THẬT của cả 2 endpoint proxy (ProxyApp.cs:124,132) — giữ full path, không
                   truncate "v1/chat" gây hiểu nhầm. /v1/responses (design 2026-09-25 mục 2) đã
                   implement (Task 4) → node liệt kê cả 2. Font 9px/lh 11px có đo lường ở
                   .trace-node__paths — 2 dòng gọn trong ô, không đè spine. *@
                <span class="trace-node__paths">POST /v1/chat/completions<br />POST /v1/responses</span>
            </div>
            <div class="trace-node" style="left:8px;top:96px;width:120px">
                <span class="cap">@L["trace.node.queue"]</span>
                <div class="trace-node__slot"></div>
                <span class="cap">@QueuedCount @L["trace.count.queued"]</span>
            </div>
            <div class="trace-node @(RunningCount > 0 ? "trace-node--act" : "")" style="left:8px;top:188px;width:120px">
                <span class="cap">@L["trace.node.dispatch"]</span>
                <div class="trace-node__slot"></div>
                <span class="cap">@RunningCount @L["trace.count.running"]</span>
            </div>
            <div class="trace-node" style="left:8px;top:336px;width:120px">
                <span class="cap">@L["trace.node.client"]</span>
                <div class="trace-node__slot"></div>
            </div>

            @foreach (var combo in _layout.Combos)
            {
                <div class="trace-node @(combo.Running ? "trace-node--act" : "")"
                     style="left:@(ComboLeft)px;top:@(combo.Top)px;width:@(ComboWidth)px"
                     @key="@($"combo-{combo.Name}")">
                    <span class="cap">@L["trace.node.combo"]</span>
                    @combo.DisplayName
                </div>
            }

            @foreach (var provider in _layout.Providers)
            {
                <div class="trace-node @(provider.Running ? "trace-node--act" : "") @(provider.HasError ? "trace-node--err" : "")"
                     style="left:@(ProviderLeft)px;top:@(provider.Top)px;width:@(ProviderWidth)px"
                     @key="@($"provider-{provider.Name}")">
                    <span class="cap">@L["trace.node.provider"]</span>
                    @* Không vẽ dot trạng thái trong node Provider — user report: trùng với dot
                       ở chip account ngay cạnh, nhìn như hình trang trí. Trạng thái provider vẫn
                       có qua border --act/--err và tag lỗi bên dưới; dot thật chỉ ở chip account. *@
                    @provider.Name
                    @if (provider.ErrorStatus is { } status)
                    {
                        <span class="trace-tag trace-tag--bad">@status</span>
                    }
                </div>
            }

            @foreach (var chip in _layout.Chips)
            {
                @if (chip.IsIdle)
                {
                    @* Chip "+N idle" → expand inline danh sách TK (spec §5.5 — không dùng Modal) *@
                    <button type="button" class="trace-chip trace-chip--idle"
                            style="left:@(AccountLeft)px;top:@(chip.Top)px"
                            aria-expanded="@(_expandedIdleProvider == chip.Provider)"
                            @key="@($"idle-{chip.Provider}")"
                            @onclick="() => ToggleIdleProvider(chip.Provider)">
                        @string.Format(L["trace.idleAccounts"], chip.IdleCount) @(_expandedIdleProvider == chip.Provider ? "▴" : "▾")
                    </button>
                    @if (_expandedIdleProvider == chip.Provider)
                    {
                        <div class="trace-idle-list" style="@IdleListStyle(chip)" @key="@($"idle-list-{chip.Provider}")">
                            <ul>
                                @foreach (var account in chip.IdleAccounts)
                                {
                                    <li @key="account.Name">
                                        @if (account.Living)
                                        {
                                            <i class="trace-idot @(account.Running ? "" : "trace-idot--dim")"></i>
                                        }
                                        @account.Name
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
                else
                {
                    <div class="trace-chip @(chip.Running ? "trace-chip--act" : "") @(chip.HasError ? "trace-chip--err" : "")"
                         style="left:@(AccountLeft)px;top:@(chip.Top)px"
                         @key="@($"chip-{chip.Provider}-{chip.Name}")">
                        <i class="trace-idot @NodeDotClass(chip.Running, chip.HasError)"></i> @chip.Name
                    </div>
                }
            }

            @* Circle = request: 1 dot tuyệt đối/node, stack ngang theo anchor của stage *@
            @foreach (var group in BuildGroups())
            {
                for (var i = 0; i < group.Shown.Count; i++)
                {
                    var node = group.Shown[i];
                    <div class="@("trace-dot " + ColorClass(node) + (node.Stage == TraceStage.Parked ? " trace-dot--park" : ""))" @key="node.Id"
                         style="left:@(group.X + i * DotStepX)px;top:@(group.Y)px"
                         @onclick="() => OpenDetail(node.Id)"></div>
                }
                @if (group.Y == QueueTop + DotRowOffsetY)
                {
                    var row = 0;
                    foreach (var node in group.Shown)
                    {
                        if (node.Stage != TraceStage.Parked)
                        {
                            continue;   // Task 10 sẽ nới điều kiện này cho headers/priority
                        }
                        <div class="trace-queue-badges" style="left:132px;top:@(group.Y - 6 + row * 14)px"
                             @key="@($"badge-{node.Id}")">
                            <span class="trace-badge trace-badge--park">@L["trace.park.badge"]</span>
                        </div>
                        row++;
                    }
                }
                @if (group.Overflow > 0)
                {
                    <div class="trace-badge trace-badge--float"
                         style="left:@(group.X + group.Shown.Count * DotStepX)px;top:@(group.Y)px">@string.Format(L["trace.more"], group.Overflow)</div>
                }
            }
        </div>
    </div>

    <div class="trace-legend">
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--white"></i>@L["trace.legend.queued"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--blue"></i>@L["trace.legend.running"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--green"></i>@L["trace.legend.ok"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--red"></i>@L["trace.legend.error"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--yellow"></i>@L["trace.legend.cancelled"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--white trace-dot--park"></i>@L["trace.legend.parked"]</span>
        <span class="trace-legend__hint">@L["trace.fadeHint"]</span>
    </div>
</div>

@* Modal chi tiết — component dùng chung (Task 5): circle Live Trace và row API Monitor
   cùng mở popup này. Đặt ngoài block chính vì Modal render fixed. *@
@* @() tường minh: param kiểu string mà bind bare-identifier sẽ Razor hiểu là string literal
   "_selectedId" → modal hiện từ startup và không bao giờ đóng được (bug runtime, không lỗi compile) *@
<RequestDetailModal RequestId="@(_selectedId)" OnClose="CloseDetail" />

@code {
    private const int NodeCap = 60;
    private const int MaxDotsPerAnchor = 6;
    private const int DotStepX = 16;
    private const int TickMs = 100;
    private static readonly TimeSpan TerminalTtl = TimeSpan.FromSeconds(10);

    // Tọa độ pixel spine theo mockup trace-design-v2.html — tính bằng C#, không JS interop
    private const int DotStartX = 14;   // node left 8 + padding
    private const int QueueTop = 96;
    private const int DispatchTop = 188;
    private const int ClientTop = 336;
    // Dòng dot nằm ngay dưới cap đầu node: padding-top 5px + cap line-height 12px (xem CSS)
    private const int DotRowOffsetY = 17;

    // ===== Tọa độ nhánh Combo → Provider → Account — copy từ mockup trace-design-v2.html,
    // tính thuần bằng C# trong AnchorOf/RebuildBranchLayout, không JS interop =====
    private const int ComboLeft = 210;         // cột Combo
    private const int ComboWidth = 130;
    private const int ProviderLeft = 410;      // cột Provider
    private const int ProviderWidth = 128;
    private const int AccountLeft = 596;       // cột Account chip
    private const int ComboStartY = 168;       // block Combo đầu tiên (mockup top 168)
    private const int ComboRowH = 128;         // giãn cách block Combo (mockup 168 → 296)
    private const int ProviderStartY = 76;     // đầu lane Provider/Account (mockup chip top 76)
    private const int ProviderRowH = 98;       // giãn cách lane thưa tối thiểu (mockup lane2→lane3: 334 − 236 = 98); lane dày chạy theo 24 + n×ChipRowH
    private const int ChipRowH = 34;           // giãn cách chip (mockup 76 → 110 → 144 → 178)
    private const int ChipHeight = 25;         // cao thật của .trace-chip (padding 4×2 + border 1.5×2 + line 10.5×1.35 ≈ 14) — dùng tính tâm cụm chip
    private const int ChipLanePadY = 24;       // padding đáy lane — tránh chip đè lane kế
    private const int NodeElbowOffsetY = 20;   // tâm block nhánh (~39px: cap 12 + dòng tên 14 + padding 10 + border 3) — mockup nối connector ở +22
    private const int ChipElbowOffsetY = 12;   // tâm dot request trong chip (dot top +6, bán kính 12/2 → 6 + 6) — mockup nối ở +14 (90 − 76)
    private const int DispatchExitX = 128;     // mép phải node Thực thi (mockup M128,210)
    private const int DispatchExitY = 210;
    private const int ChipDotOffsetX = 8;      // dot trong chip: border 1.5px + padding 7px
    private const int ChipDotOffsetY = 6;
    private const int ProviderDotOffsetX = 9;  // dot trong provider: border 1.5px + padding 8px
    private const int MaxAccountChips = 4;     // spec §5.2: max 4 chip + "+N idle"
    private const int CanvasHeight = 415;
    private const int IdleChipHeight = 26;     // chiều cao chip (~22px) + hở 4px với panel
    private const int IdleListUpThreshold = 200; // chip dưới ngưỡng này → panel mở xuống, trên → mở lên

    private readonly ConcurrentQueue<TraceEvent> _inbox = new();
    // Merge rule/anchor/tag nằm trong Core (TraceNodeAggregator) để test project với
    // chỉ tham chiếu Core kiểm tra được — component giữ bookkeeping (cap-drop) + map pixel.
    private readonly TraceNodeAggregator _agg = new(TerminalTtl);
    private Dictionary<string, TraceNodeState> Nodes => _agg.Nodes;
    private readonly CancellationTokenSource _cts = new();

    // Layout nhánh tính lại mỗi lần render từ Nodes (không giữ state layout riêng)
    private BranchLayout _layout = new();

    // Cache provider cho chip "+N idle" — nạp 1 lần trong OnInitializedAsync
    private IReadOnlyList<Provider> _providers = [];

    // Provider đang mở panel danh sách idle (tối đa 1 chip mở cùng lúc)
    private string? _expandedIdleProvider;

    // Id request đang mở modal chi tiết timeline — null = đóng; circle click gán, CloseDetail xóa
    private string? _selectedId;

    // Component đã gỡ — callback fire-and-forget không được StateHasChanged sau dispose
    private bool _disposed;

    // Id từng bị drop do vượt cap 60 — cộng lại đúng khi node được dựng từ event mới,
    // tránh badge +N bị cao dần vô hạn theo thời gian
    private readonly HashSet<string> _droppedIds = new();
    private int _overflow;

    /// <summary>Nhóm dot cùng anchor: tối đa 6 dot vẽ ra, phần dư cộng vào badge +N.</summary>
    private sealed record DotGroup(int X, int Y, List<TraceNodeState> Shown, int Overflow);

    /// <summary>Nhóm node cùng route (Combo, Provider, Account) — đơn vị vẽ connector của nhánh.</summary>
    private sealed record BranchGroup(string Combo, string Provider, string Account, List<TraceNodeState> Nodes)
    {
        /// <summary>Đang chạy: có node ở Attempt — viền xanh + dot pulse (spec §5.2).</summary>
        public bool Running => Nodes.Any(n => n.Stage is TraceStage.DispatchStarted or TraceStage.Attempt);

        /// <summary>Nhóm lỗi: node có status ≥ 400 hoặc Success == false → connector nét đỏ.</summary>
        public bool HasError => Nodes.Any(n => n.Status is >= 400 || n.Success == false);
    }

    /// <summary>Block cột Combo — mockup <c>.n</c> tại left 210.</summary>
    private sealed record ComboBlock(string Name, string? Mode, int Top, bool Running)
    {
        /// <summary>"combo · mode" (mockup <c>ai-fast · RR</c>); combo rỗng (dispatch trực tiếp) → "—".</summary>
        public string DisplayName => Name.Length == 0 ? "—" : Mode is null ? Name : $"{Name} · {Mode}";
    }

    /// <summary>Block cột Provider — mockup <c>.n</c> tại left 410, kèm tag status lỗi.</summary>
    private sealed record ProviderBlock(string Name, int Top, bool Running, bool HasError, int? ErrorStatus);

    /// <summary>Chip cột Account — mockup <c>.acct</c> tại left 596; IsIdle = chip "+N idle".</summary>
    private sealed record AccountChip(
        string Provider, string Name, int Top, bool IsIdle, bool Running, bool HasError,
        int IdleCount, IReadOnlyList<IdleAccount> IdleAccounts);

    /// <summary>Một dòng trong panel expand chip idle — Living = còn node sống tham chiếu TK này.</summary>
    private sealed record IdleAccount(string Name, bool Living, bool Running);

    /// <summary>Đường connector 1 group — HasError đổi màu nét (đỏ) thay vì xanh marching-ants.</summary>
    private sealed record BranchPath(IReadOnlyList<string> Segments, bool HasError);

    /// <summary>Layout nhánh của lần render hiện tại — svg, block, chip và AnchorOf cùng đọc.</summary>
    private sealed class BranchLayout
    {
        public List<ComboBlock> Combos { get; } = [];
        public List<ProviderBlock> Providers { get; } = [];
        public List<AccountChip> Chips { get; } = [];
        public List<BranchPath> Paths { get; } = [];

        public AccountChip? FindChip(string provider, string account) =>
            Chips.FirstOrDefault(c => !c.IsIdle && c.Provider == provider && c.Name == account);

        public ProviderBlock? FindProvider(string provider) =>
            Providers.FirstOrDefault(p => p.Name == provider);
    }

    private int QueuedCount => Nodes.Values.Count(n => n.Stage is TraceStage.Received or TraceStage.Parked);
    private int RunningCount => Nodes.Values.Count(n => n.Stage is TraceStage.DispatchStarted or TraceStage.Attempt);

    protected override Task OnInitializedAsync()
    {
        // Subscribe TRƯỚC khi đọc snapshot — event bắn giữa 2 bước không bị miss;
        // apply trùng (event có cả trong snapshot lẫn inbox) là idempotent nên an toàn.
        Feed.Published += OnPublished;

        foreach (var e in Feed.Snapshot())
            ApplyEvent(e);

        try
        {
            // Bù node trắng tại Hàng đợi cho request đang chờ nhưng feed chưa từng thấy
            // (mở app giữa chừng / ring eviction) — spec trace §5.3. Proxy dừng giữa chừng
            // có thể ném khi đọc queue → coi như không có gì để bù.
            var now = DateTimeOffset.UtcNow;
            foreach (var q in Proxy.QueuedSnapshot())
            {
                if (!Nodes.ContainsKey(q.Id))
                    Nodes[q.Id] = new TraceNodeState { Id = q.Id, Model = q.Model, ReceivedAt = now };
            }
        }
        catch (Exception ex)
        {
            Log.Error("RequestTrace: đọc QueuedSnapshot thất bại.", ex);
        }

        EnforceCap();

        _ = LoadProvidersAsync();
        _ = RunLoopAsync(_cts.Token);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Nạp cache provider (kèm Accounts) cho chip "+N idle" và panel expand —
    /// fire-and-forget + try/catch: deviation có chủ đích khỏi chữ "lazy khi expand" trong
    /// spec §5.5 (brief Task 6 Interfaces): tổng số TK cần biết NGAY khi render chip,
    /// expand chỉ hiện lại danh sách đã có; không chặn first render.
    /// </summary>
    private async Task LoadProvidersAsync()
    {
        try
        {
            var providers = await ProviderService.ListAsync();

            // Gán + render phải qua dispatcher thread — ListAsync chạy trên thread pool.
            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    _providers = providers;
                    StateHasChanged();
                });
            }
        }
        catch (Exception ex)
        {
            // DB chưa sẵn sàng / query lỗi → chip idle ẩn (không có tổng TK), UI vẫn chạy.
            Log.Error("RequestTrace: nạp danh sách provider cho chip idle thất bại.", ex);
        }
    }

    /// <summary>
    /// Nhận event từ <see cref="ITraceFeed.Published"/> — chạy trên thread publish của Core.
    /// </summary>
    private void OnPublished(TraceEvent e)
    {
        // Handler tuyệt đối không được ném: Published là multicast delegate — subscriber
        // ném sẽ chặn các subscriber phía sau. Enqueue vào ConcurrentQueue với T tham chiếu
        // không ném exception → handler không có đường ném ra ngoài.
        _inbox.Enqueue(e);

        // Publish đến từ thread Kestrel/dispatcher — Blazor chỉ render an toàn trên
        // dispatcher thread của component nên phải Marshal bằng InvokeAsync. Nội dung
        // Nodes chỉ đổi trong Flush (loop 100ms, cũng chạy qua InvokeAsync) nên render
        // ở đây là diff rỗng: không thrash, vẫn đảm bảo re-render đi qua đúng thread.
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Loop 100ms: drain inbox → áp event → dọn node hết hạn → render nếu có thay đổi.
    /// </summary>
    private async Task RunLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                // Tick 100ms — nhỏ hơn 500ms trong spec (§5.4): dọn node terminal sát giờ
                // hơn, vô hại vì render tối đa 10 lần/s và chỉ khi thật sự có thay đổi.
                await Task.Delay(TickMs, ct);

                // Mọi thao tác trên Nodes đều qua InvokeAsync → chỉ chạy trên dispatcher
                // thread, không race với render.
                await InvokeAsync(Flush);
            }
            catch (OperationCanceledException)
            {
                // DisposeAsync đã cancel — dừng vòng lặp.
                return;
            }
            catch (Exception ex)
            {
                // Một tick lỗi không được giết vòng render trace — ghi log rồi tiếp tục.
                Log.Error("RequestTrace: làm mới state thất bại.", ex);
            }
        }
    }

    /// <summary>Drain inbox, áp event, dọn node hết hạn, render khi có thay đổi — chỉ gọi trên dispatcher thread.</summary>
    private void Flush()
    {
        var changed = false;
        while (_inbox.TryDequeue(out var e))
        {
            ApplyEvent(e);
            changed = true;
        }

        if (RemoveExpired())
            changed = true;

        if (!changed)
            return;

        EnforceCap();
        StateHasChanged();
    }

    /// <summary>Áp một trace event vào node của request — idempotent, tái tạo node nếu đã bị drop.</summary>
    private void ApplyEvent(TraceEvent e)
    {
        var isNew = !Nodes.ContainsKey(e.RequestId);
        _agg.Apply(e);

        // Node dựng lại từ id từng bị cap-drop → hoàn badge +N thay vì cộng dồn
        if (isNew && _droppedIds.Remove(e.RequestId))
            _overflow = Math.Max(0, _overflow - 1);
    }

    /// <summary>Gỡ node đã qua <see cref="TraceNodeState.ExpiresAt"/>. Trả về <see langword="true"/> nếu có node bị gỡ.</summary>
    private bool RemoveExpired()
    {
        var now = DateTimeOffset.UtcNow;
        List<string>? expiredIds = null;
        foreach (var (id, node) in Nodes)
        {
            if (node.ExpiresAt is { } expiresAt && expiresAt <= now)
                (expiredIds ??= []).Add(id);
        }

        if (expiredIds is null)
            return false;

        foreach (var id in expiredIds)
            Nodes.Remove(id);
        return true;
    }

    /// <summary>Giới hạn 60 node hiển thị: drop terminal cũ nhất trước, vẫn vượt → giữ 60 mới nhất + đếm _overflow.</summary>
    private void EnforceCap()
    {
        while (Nodes.Count > NodeCap)
        {
            var victim = Nodes.Values
                .OrderBy(n => n.ExpiresAt is null ? 1 : 0)
                .ThenBy(n => n.ReceivedAt)
                .ThenBy(n => n.Id, StringComparer.Ordinal)
                .First();
            Nodes.Remove(victim.Id);
            _droppedIds.Add(victim.Id);
            _overflow++;
        }
    }

    /// <summary>Tọa độ anchor của node theo stage hiện tại — Attempt trỏ tới chip Account của route (Task 6); anchor ngữ nghĩa map pixel tại đây.</summary>
    private (int X, int Y) AnchorOf(TraceNodeState n) => TraceNodeAggregator.AnchorOf(n) switch
    {
        TraceAnchor.Queue => (DotStartX, QueueTop + DotRowOffsetY),
        TraceAnchor.Dispatch => (DotStartX, DispatchTop + DotRowOffsetY),
        TraceAnchor.Attempt => AttemptAnchor(n),
        _ => (DotStartX, ClientTop + DotRowOffsetY),
    };

    /// <summary>
    /// Anchor cho Attempt: tâm dot inline của chip Account trong group route (spec G3).
    /// Chip không render được → lùi về node Provider; group chưa render (không có route) →
    /// lùi về nút Thực thi như Task 5 — dot không bao giờ nhảy ra ngoài layout.
    /// </summary>
    private (int X, int Y) AttemptAnchor(TraceNodeState n)
    {
        if (n.Route is not { Provider: { } providerName })
            return (DotStartX, DispatchTop + DotRowOffsetY);

        if (_layout.FindChip(providerName, n.Route!.Account ?? string.Empty) is { } chip)
            return (AccountLeft + ChipDotOffsetX, chip.Top + ChipDotOffsetY);

        if (_layout.FindProvider(providerName) is { } provider)
            return (ProviderLeft + ProviderDotOffsetX, provider.Top + DotRowOffsetY);

        return (DotStartX, DispatchTop + DotRowOffsetY);
    }

    /// <summary>
    /// Tính lại layout nhánh từ <c>Nodes</c> còn hạn — gọi đầu mỗi render.
    /// Chỉ group có node tham chiếu (<c>Route.Provider</c> khác null) được vẽ (spec §5.1);
    /// thứ tự = xuất hiện đầu tiên của group trong <c>Nodes</c>, tọa độ cột fixed theo mockup.
    /// </summary>
    private void RebuildBranchLayout()
    {
        var layout = new BranchLayout();
        _layout = layout;

        // Sắp (ReceivedAt, Id) để thứ tự "xuất hiện đầu tiên" ổn định giữa các lần render —
        // Dictionary không giữ thứ tự enumerate, không được dựa vào nó.
        var routed = Nodes.Values
            .Where(n => n.Route?.Provider is not null)
            .OrderBy(n => n.ReceivedAt)
            .ThenBy(n => n.Id, StringComparer.Ordinal)
            .ToList();
        if (routed.Count == 0)
        {
            // Không còn node route → không còn provider nào trong layout → đóng panel expand
            _expandedIdleProvider = null;
            return;
        }

        var groups = routed
            .GroupBy(n => (Combo: n.Route!.Combo ?? string.Empty,
                           Provider: n.Route!.Provider!,
                           Account: n.Route!.Account ?? string.Empty))
            .Select(g => new BranchGroup(g.Key.Combo, g.Key.Provider, g.Key.Account, g.ToList()))
            .ToList();

        // Cột Combo: mỗi combo distinct một block, xếp dọc theo thứ tự xuất hiện
        var comboNames = groups.Select(g => g.Combo).Distinct(StringComparer.Ordinal).ToList();
        var comboIndex = new Dictionary<string, int>(StringComparer.Ordinal);
        for (var i = 0; i < comboNames.Count; i++)
        {
            var name = comboNames[i];
            comboIndex[name] = i;
            var nodes = groups.Where(g => g.Combo == name).SelectMany(g => g.Nodes).ToList();
            // Mode do DispatchStarted ghi, ApplyEvent giữ lại khi node chuyển sang Attempt
            var mode = nodes.Select(n => n.Mode).FirstOrDefault(m => m is not null);
            var running = nodes.Any(n => n.Stage is TraceStage.DispatchStarted or TraceStage.Attempt);
            layout.Combos.Add(new ComboBlock(name, mode, ComboStartY + i * ComboRowH, running));
        }

        // Cột Provider + chip Account — lane dồn theo số chip (chip 34px, lane ≥ 110px như mockup)
        var laneTop = ProviderStartY;
        foreach (var providerGroup in groups.GroupBy(g => g.Provider))
        {
            var providerName = providerGroup.Key;
            var pGroups = providerGroup.ToList();

            // TK đang tham chiếu: GroupBy giữ thứ tự xuất hiện, OrderByDescending (stable sort)
            // đưa TK đang chạy lên trước khi vượt max 4 chip — "active trước" (spec §5.2)
            var accounts = pGroups
                .GroupBy(g => g.Account)
                .Select(ag => (Name: ag.Key,
                                Running: ag.Any(x => x.Running),
                                HasError: ag.Any(x => x.HasError)))
                .OrderByDescending(a => a.Running)
                .ToList();
            var shown = accounts.Take(MaxAccountChips).ToList();

            // Tổng số TK lấy từ cache IProviderService; provider chưa có trong cache →
            // không biết tổng → bỏ chip idle thay vì hiển thị N sai cho người dùng.
            var providerEntity = _providers.FirstOrDefault(
                p => string.Equals(p.Name, providerName, StringComparison.Ordinal));
            var activeCount = accounts.Count;
            var idleCount = providerEntity is { } pe ? Math.Max(0, pe.Accounts.Count - activeCount) : 0;
            var chipTotal = shown.Count + (idleCount > 0 ? 1 : 0);
            var laneHeight = Math.Max(ProviderRowH, ChipLanePadY + chipTotal * ChipRowH);

            var running = pGroups.Any(g => g.Running);
            var hasError = pGroups.Any(g => g.HasError);
            // Tag lỗi: status ≥ 400 của node xuất hiện đầu — mockup hiện đúng 1 tag (429)
            var errorStatus = pGroups
                .SelectMany(g => g.Nodes)
                .FirstOrDefault(n => n.Status is >= 400)?.Status;
            // Provider căn theo TÂM cụm chip của lane chứ không theo đầu lane — theo mockup
            // 118/228/326 đều = tâm cụm chip − 20; căn theo đầu lane sẽ trệ ~50px ở lane2+
            // và clip đáy canvas 415px ngay ở mật độ 3 provider của mockup.
            var providerTop = laneTop + ((chipTotal - 1) * ChipRowH + ChipHeight) / 2 - NodeElbowOffsetY;
            layout.Providers.Add(new ProviderBlock(providerName, providerTop, running, hasError, errorStatus));

            for (var k = 0; k < shown.Count; k++)
            {
                layout.Chips.Add(new AccountChip(
                    providerName, shown[k].Name, laneTop + k * ChipRowH,
                    IsIdle: false, Running: shown[k].Running, HasError: shown[k].HasError,
                    IdleCount: 0, IdleAccounts: []));
            }

            if (idleCount > 0)
            {
                // Panel expand = toàn bộ TK của provider (spec §5.5); dot active suy ra node
                // đang sống trong Nodes (Living), pulse nếu TK đang có request chạy (Running).
                var known = providerEntity?.Accounts.Select(a => a.Name).ToList() ?? [];
                var referenced = pGroups.Select(g => g.Account).Distinct().ToList();
                var entryNames = known.Concat(referenced.Where(r => !known.Contains(r))).ToList();
                var entries = entryNames
                    .Select(name => new IdleAccount(
                        name,
                        Living: pGroups.Any(g => g.Account == name),
                        Running: pGroups.Any(g => g.Account == name && g.Running)))
                    .ToList();
                layout.Chips.Add(new AccountChip(
                    providerName, string.Empty, laneTop + shown.Count * ChipRowH,
                    IsIdle: true, Running: false, HasError: false,
                    IdleCount: idleCount, IdleAccounts: entries));
            }

            laneTop += laneHeight;
        }

        // Panel expand không được "tự mở lại" khi provider biến mất khỏi layout (node expire) —
        // flag là state component, layout tính lại mỗi render nên dọn ngay tại đây.
        if (_expandedIdleProvider is not null && layout.FindProvider(_expandedIdleProvider) is null)
        {
            _expandedIdleProvider = null;
        }

        // Connector per group: Thực thi → Combo → Provider → Account (elbow ở trung điểm 2 cột).
        // Tách từng đoạn (giống mockup): block nền trong nên không kẻ đường xuyên qua trong block.
        foreach (var g in groups)
        {
            // Defensive: combo/provider dựng ngay từ groups ở trên — không bao giờ vắng.
            if (!comboIndex.TryGetValue(g.Combo, out var comboIdx))
                continue;
            var providerBlock = layout.FindProvider(g.Provider);
            if (providerBlock is null)
                continue;

            var cy = layout.Combos[comboIdx].Top + NodeElbowOffsetY;
            var py = providerBlock.Top + NodeElbowOffsetY;
            var m1 = (DispatchExitX + ComboLeft) / 2;
            var m2 = (ComboLeft + ComboWidth + ProviderLeft) / 2;
            var segments = new List<string>
            {
                $"M{DispatchExitX},{DispatchExitY} L{m1},{DispatchExitY} L{m1},{cy} L{ComboLeft},{cy}",
                $"M{ComboLeft + ComboWidth},{cy} L{m2},{cy} L{m2},{py} L{ProviderLeft},{py}",
            };

            // Chip bị cắt (vượt max 4) → đường dừng tại Provider
            if (layout.FindChip(g.Provider, g.Account) is { } chip)
            {
                var m3 = (ProviderLeft + ProviderWidth + AccountLeft) / 2;
                var chy = chip.Top + ChipElbowOffsetY;
                segments.Add($"M{ProviderLeft + ProviderWidth},{py} L{m3},{py} L{m3},{chy} L{AccountLeft},{chy}");
            }

            layout.Paths.Add(new BranchPath(segments, g.HasError));
        }
    }

    /// <summary>Class dot indicator: rỗng = xanh pulse (đang chạy), đỏ khi lỗi còn lại, xám khi chỉ còn terminal.</summary>
    private static string NodeDotClass(bool running, bool hasError) =>
        running ? "" : hasError ? "trace-idot--err" : "trace-idot--dim";

    /// <summary>
    /// Panel expand: mở xuống dưới chip nếu còn chỗ trong canvas 415px, ngược lại mở lên trên —
    /// tự giữ panel trong vùng clip (không build scrolling theo ruling Task 6).
    /// </summary>
    private string IdleListStyle(AccountChip chip) =>
        chip.Top > IdleListUpThreshold
            ? $"left:{AccountLeft}px;bottom:{CanvasHeight - chip.Top + 4}px"
            : $"left:{AccountLeft}px;top:{chip.Top + IdleChipHeight}px";

    /// <summary>Bật/tắt panel inline danh sách TK khi click chip "+N idle" (spec §5.5 — không dùng Modal).</summary>
    private void ToggleIdleProvider(string provider) =>
        _expandedIdleProvider = _expandedIdleProvider == provider ? null : provider;

    /// <summary>Mở modal chi tiết timeline — gọi từ onclick của circle request trên sơ đồ.</summary>
    private void OpenDetail(string id) => _selectedId = id;

    /// <summary>Đóng modal chi tiết — Modal gọi qua OnClose khi người dùng Esc/backdrop/×.</summary>
    private void CloseDetail() => _selectedId = null;

    /// <summary>Nhóm node theo anchor, tối đa 6 dot/nhóm + badge +N cho phần dư.</summary>
    private List<DotGroup> BuildGroups() =>
        Nodes.Values
            .GroupBy(AnchorOf)
            .Select(g =>
            {
                var ordered = g
                    .OrderBy(n => n.ReceivedAt)
                    .ThenBy(n => n.Id, StringComparer.Ordinal)
                    .ToList();
                var shown = ordered.Take(MaxDotsPerAnchor).ToList();
                return new DotGroup(g.Key.X, g.Key.Y, shown, ordered.Count - shown.Count);
            })
            .OrderBy(g => g.Y)
            .ThenBy(g => g.X)
            .ToList();

    /// <summary>Màu circle theo trạng thái — spec G2; delegate sang <see cref="TraceColors.ForStage"/>
    /// (một nguồn sự thật cho màu — API Monitor đọc cùng bảng này).</summary>
    private static string ColorClass(TraceNodeState n) => TraceColors.ForStage(n.Stage, n.Success);

    /// <summary>Gỡ subscription và dừng vòng render — tránh leak delegate trên feed singleton.</summary>
    public ValueTask DisposeAsync()
    {
        // Bắt buộc unsubscribe: feed là singleton, giữ delegate trỏ vào component đã
        // dispose là leak + handler chạy vô ích cho mỗi event.
        Feed.Published -= OnPublished;

        // Đánh dấu trước khi cancel — LoadProvidersAsync fire-and-forget có thể đang chạy,
        // callback không được StateHasChanged trên component đã gỡ.
        _disposed = true;

        // Chỉ Cancel, không Dispose: vòng lặp còn đăng ký Task.Delay trên token này;
        // CTS không giữ tài nguyên native nên GC thu hồi an toàn.
        _cts.Cancel();
        return ValueTask.CompletedTask;
    }
}
