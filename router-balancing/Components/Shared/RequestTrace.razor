@using System.Collections.Concurrent
@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Engine
@using RouterBalancing.Core.Providers
@using RouterBalancing.Core.Proxies
@inject ITraceFeed Feed
@inject IProxyHost Proxy
@inject ILogService Log
@inject IProviderService ProviderService
@inject IProxyPool ProxyPool
@inject IProxyService ProxyService
@inject LocalizationService L
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    /* CSS theo mockup trace-design-v2.html — priority 7 (style inline trong razor, xem style.css) */
    /* Chỉ phần sơ đồ cuộn; .trace-head/.trace-legend là sibling đứng ngoài nên đứng yên
       (user 2026-10-08: chỉ phần sơ đồ cuộn, head/legend đứng yên) */
    .trace-wrap {
        overflow: auto;
        max-height: 415px;
        padding-bottom: 6px;
    }

    .trace-canvas {
        position: relative;
        width: 740px;
        font-size: 11px;
        /* Chiều cao set inline theo nội dung thật (CanvasHeight). Vùng giữa giờ CUỘN thay vì
           clip: nội dung tràn đáy cuộn tới thay vì bị cắt (user 2026-10-08 thay ruling Task 6
           "clamp thay vì scrolling"); panel expand vẫn tự chọn hướng để sát chip */
    }

    .trace-svg {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .trace-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    .trace-title {
        font-weight: 600;
        font-size: 14px;
    }

    .trace-counts {
        display: flex;
        gap: 12px;
        font-size: 11px;
        opacity: .85;
        flex-wrap: wrap;
        align-items: center;
    }

    .trace-node {
        position: absolute;
        border: 1.5px solid #8b8fa3;
        background: rgba(255, 255, 255, .055);
        border-radius: 8px;
        padding: 5px 8px;
        text-align: center;
        line-height: 1.35;
    }

    /* Node đang có request đi qua (mockup .n.act) */
    .trace-node--act {
        border-color: #3b82f6;
        box-shadow: 0 0 0 1px rgba(59, 130, 246, .4), 0 0 12px rgba(59, 130, 246, .18);
    }

    .trace-node .cap {
        display: block;
        font-size: 9px;
        line-height: 12px;
        opacity: .55;
        text-transform: uppercase;
        letter-spacing: .05em;
        /* Cấm wrap: cap giữ đúng 1 dòng để dòng dot tuyệt đối (AnchorOf = top node + 17px)
           luôn thẳng hàng với slot trong node */
        white-space: nowrap;
    }

    /* Slot dành chỗ cho dot absolute — cao 12px bằng đúng kích thước dot */
    .trace-node__slot {
        height: 12px;
    }

    /* 2 dòng endpoint trong INPUT node — 9px (bằng cap) + lh 11px + nowrap (đo trên WebView2:
       "POST /v1/chat/completions" = 99.6px, "POST /v1/responses" = 73.1px, vừa khung trong
       101px của node width:120px → mỗi path đúng 1 dòng, không truncate).
       Chiều cao box = 2×1.5 border + 2×5 padding + 12 cap + 2×11 lines = 47px → đáy = top 8 +
       47 = 55px, sát điểm bắt đầu spine (y=52) và thấp hơn box 11px hiện tại (~62px; font 11px
       sẽ tràn 3 dòng, đáy ~77px → spine cắt ngang text).
       nowrap: margin fit chỉ ~1.4px — nhỡ DPI/font metric lệch thì cấm wrap sau '/' thành dòng 3;
       thà tràn ngang vài px còn hơn đổi hình học node (nguyên tắc như .cap). */
    .trace-node__paths {
        display: block;
        font-size: 9px;
        line-height: 11px;
        white-space: nowrap;
    }

    /* G5: dòng endpoint đang được request dùng — sáng xanh ~2s rồi fade về màu gốc */
    .trace-node__path {
        transition: color .8s ease;
    }

    .trace-node__path--lit {
        color: #3b82f6;
        font-weight: 600;
    }

    /* Circle = request: transition left/top tạo hiệu ứng di chuyển trên đường (không JS) */
    .trace-dot {
        position: absolute;
        box-sizing: border-box;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        transition: left .35s ease, top .35s ease;
    }

    .trace-dot--white { background: #fff; border: 1.5px solid #9aa0aa; }
    .trace-dot--blue { background: #3b82f6; }
    .trace-dot--green { background: #22c55e; }
    .trace-dot--red { background: #ef4444; }
    .trace-dot--yellow { background: #eab308; }

    /* Dot ĐANG chạy dọc line — glow màu trạng thái để mắt theo được hướng đi;
       class do C# bỏ khi tới nơi (TravelState.ArrivalAt), không animation lặp */
    .trace-dot--move.trace-dot--white { box-shadow: 0 0 8px #fff; }
    .trace-dot--move.trace-dot--blue { box-shadow: 0 0 8px #3b82f6; }
    .trace-dot--move.trace-dot--green { box-shadow: 0 0 8px #22c55e; }
    .trace-dot--move.trace-dot--red { box-shadow: 0 0 8px #ef4444; }
    .trace-dot--move.trace-dot--yellow { box-shadow: 0 0 8px #eab308; }

    .trace-badge {
        font-size: 9.5px;
        border: 1px solid rgba(139, 143, 163, .55);
        border-radius: 999px;
        padding: 0 6px;
        opacity: .75;
    }

    .trace-badge--float {
        position: absolute;
        box-sizing: border-box;
        height: 13px;
        line-height: 11px;
    }

    /* Ring vàng đứt quanh dot đang chờ slot (G1 — mockup .lt-park-ring) */
    .trace-dot--park {
        outline: 1.5px dashed #eab308;
        outline-offset: 2px;
    }

    /* Cột badge bên phải node Hàng đợi (mockup left 132 — G1/G2/G3 dùng chung) */
    .trace-queue-badges {
        position: absolute;
        display: flex;
        gap: 4px;
        align-items: center;
        white-space: nowrap;
        z-index: 5;
    }

    .trace-badge--park {
        color: #eab308;
        border-color: #eab308;
        border-style: dashed;
    }

    /* Badge "200 ✓" khi stream đã commit header (G2 — mockup nét đứt xanh lá) */
    .trace-badge--headers {
        color: #22c55e;
        border-color: #22c55e;
        border-style: dashed;
    }

    .trace-legend {
        display: flex;
        gap: 10px;
        font-size: 10.5px;
        opacity: .8;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 8px;
    }

    .trace-legend__item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .trace-legend__hint {
        opacity: .65;
    }

    .trace-ldot {
        display: inline-block;
        box-sizing: border-box;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* Legend: ring đứt quanh dot = marker dạng badge/tag nét đứt (chờ slot, headers, priority).
       offset 1px (khác .trace-dot--park 2px trên dot thật) để không chạm text trong khoảng cách legend 4px */
    .trace-ldot--ring {
        outline-style: dashed;
        outline-width: 1.5px;
        outline-offset: 1px;
    }

    /* Màu ring lấy đúng border-color của marker thật tương ứng trong legend */
    .trace-ldot--ring-amber {
        outline-color: #eab308;
    }

    .trace-ldot--ring-green {
        outline-color: #22c55e;
    }

    .trace-ldot--ring-blue {
        outline-color: #3b82f6;
    }

    /* ===== Nhánh Combo → Provider → Account (copy từ mockup .n/.acct/.tag — Task 6) ===== */

    /* Node nhánh lỗi (mockup .n.err) */
    .trace-node--err {
        border-color: #ef4444;
        box-shadow: 0 0 0 1px rgba(239, 68, 68, .4);
    }

    /* Chip account (mockup .acct) — absolute như node, nội dung 1 dòng */
    .trace-chip {
        position: absolute;
        box-sizing: border-box;
        border: 1.5px solid #8b8fa3;
        background: rgba(255, 255, 255, .05);
        border-radius: 6px;
        padding: 4px 7px;
        font-size: 10.5px;
        line-height: 1.35;
        white-space: nowrap;
        text-align: left;
    }

    .trace-chip--act { border-color: #3b82f6; }
    .trace-chip--err { border-color: #ef4444; }

    /* Chip account có proxy đang cooldown — viền nét đứt đỏ trên CHÍNH chip (spec §3.5 G4:
       trang trí chip, không thay chip) */
    .trace-chip--cooldown {
        border-style: dashed;
        border-color: #ef4444;
    }

    /* Badge đếm ngược COOLDOWN gắn trong chip — chữ đỏ (spec §3.5) */
    .trace-chip__cooldown {
        color: #ef4444;
        margin-left: 6px;
    }

    /* Chip 2 dòng (theo pattern .trace-node__slot): dòng 1 dành dot request rơi vào,
       dòng 2 là tên TK — dot tuyệt đối không đè lên tên */
    .trace-chip__dotrow { display: block; height: 12px; }
    .trace-chip__name { display: block; }

    /* Chip "+N idle" (mockup .acct.idle) — click expand danh sách inline */
    .trace-chip--idle {
        border-style: dashed;
        opacity: .6;
        background: transparent;
        cursor: pointer;
    }

    /* Dot indicator inline trong node/chip nhánh (mockup .dot) — khác .trace-dot (tuyệt đối, = circle request) */
    .trace-idot {
        display: inline-block;
        box-sizing: border-box;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #3b82f6;
        vertical-align: -2px;
        animation: trace-pulse 1.3s ease-in-out infinite;
    }

    /* Còn node sống nhưng không có request đang chạy (mockup .dot.white opacity .5) */
    .trace-idot--dim {
        background: #fff;
        border: 1.5px solid #9aa0aa;
        opacity: .5;
        animation: none;
    }

    /* Lỗi nhưng không chạy — dot đỏ đứng yên */
    .trace-idot--err {
        background: #ef4444;
        animation: none;
    }

    @@keyframes trace-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.35); }
    }

    /* Tag status lỗi trong node Provider (mockup .tag.bad) */
    .trace-tag {
        font-size: 9px;
        border: 1px solid rgba(139, 143, 163, .6);
        border-radius: 4px;
        padding: 0 4px;
    }

    .trace-tag--bad {
        border-color: #ef4444;
        color: #ef4444;
    }

    /* Tag priority cạnh dot (G3) — amber Highest / blue High, Normal ẩn (spec §3.4) */
    .trace-tag--prio-highest {
        color: #eab308;
        border-color: #eab308;
    }

    .trace-tag--prio-high {
        color: #3b82f6;
        border-color: #3b82f6;
    }

    /* Panel inline danh sách TK khi click chip "+N idle" (spec §5.5 — inline, không Modal) */
    .trace-idle-list {
        position: absolute;
        z-index: 30;
        box-sizing: border-box;
        width: 144px;
        max-height: 160px;
        overflow-y: auto;
        border: 1px dashed rgba(139, 143, 163, .6);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        padding: 6px 8px;
        font-size: 10.5px;
    }

    .trace-idle-list ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .trace-idle-list li {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 0;
        overflow-wrap: anywhere;
    }
</style>

<div class="mb-4 rounded border border-border bg-surface p-4">
    <div class="trace-head">
        <span class="trace-title">📊 @L["trace.title"]</span>
        @* Count row đã gộp sang strip API Monitor (user quyết 2026-10-07, mockup merge-counts A):
           state live đọc trực tiếp từ circles + legend; chỉ giữ badge drop-over-cap ở đây. *@
        <div class="trace-counts">
            @* Badge node bị drop khi vượt cap 60 (khác badge +N theo anchor bên dưới) *@
            @if (_overflow > 0)
            {
                <span class="trace-badge">@string.Format(L["trace.more"], _overflow)</span>
            }
        </div>
    </div>

    @* Tính lại layout nhánh TRƯỚC khi vẽ — CanvasHeight (style .trace-canvas), svg, branch
       node/dot cùng đọc _layout trong 1 render. Đặt TRƯỚC div .trace-canvas vì attribute
       style của div này tính trước khi render nội dung bên trong. *@
    @{ RebuildBranchLayout();
       // Một giá trị now chung cho cả line dẫn đường (svg) và glow (dot) trong cùng lần render
       var traceNow = DateTimeOffset.UtcNow; }

    <div class="trace-wrap" @ref="_wrapRef">
        <div class="trace-canvas" style="height:@(CanvasHeight)px">
            <svg class="trace-svg" width="740" height="@CanvasHeight">
                @* Đường nối spine — coords theo mockup; đoạn Thực thi→Client nối thêm cho đủ spine *@
                <g fill="none" stroke="#8b8fa3" stroke-width="1.6" opacity=".55">
                    <path d="M68,52 L68,96" />
                    <path d="M68,152 L68,188" />
                    <path d="M68,244 L68,336" />
                </g>
                @if (WireInputQueueLit)
                {
                    @* Luồng ① trắng (user gate §1.3-8): overlay NGAY TRÊN gray spine tại lane tâm
                       (mockup M70,58 V118 — dot, dây và spine cùng x, không tách lane song song) *@
                    <g fill="none" stroke="#ffffff" stroke-width="1.8" opacity=".9" stroke-dasharray="7 6">
                        <path d="M@(DotStartX),@InputBottom L@(DotStartX),@QueueTop">
                            <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                        </path>
                    </g>
                }
                @if (WireCancelLit)
                {
                    @* Luồng ② vàng: 2 đoạn theo gap spine (QueueBottom→DispatchTop, DispatchBottom→ClientTop),
                       lane CancelLaneX — bỏ qua node Thực thi; dot Cancel đi đúng lane này *@
                    <g fill="none" stroke="#eab308" stroke-width="1.8" opacity=".9" stroke-dasharray="7 6">
                        <path d="M@(CancelLaneX),@QueueBottom L@(CancelLaneX),@DispatchTop">
                            <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                        </path>
                        <path d="M@(CancelLaneX),@DispatchBottom L@(CancelLaneX),@ClientTop">
                            <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                        </path>
                    </g>
                }
                @if (WireErrorLit)
                {
                    @* Luồng ③ đỏ: lane ErrorLaneX (khác lane vàng) đáy Thực thi → đỉnh Client
                       — luôn đi qua DispatchStarted (G6 loại); dot lỗi đi đúng lane này *@
                    <g fill="none" stroke="#ef4444" stroke-width="1.8" opacity=".9" stroke-dasharray="7 6">
                        <path d="M@(ErrorLaneX),@DispatchBottom L@(ErrorLaneX),@ClientTop">
                            <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                        </path>
                    </g>
                }
                @* Nhánh route per group — đỏ khi group có node lỗi, ngược lại xanh marching-ants (mockup);
                   tách từng đoạn như mockup để đường KHÔNG kẻ xuyên qua block (block nền trong) *@
                @foreach (var path in _layout.Paths)
                {
                    <g fill="none" stroke="@(path.HasError ? "#ef4444" : "#3b82f6")" stroke-width="1.8"
                       stroke-dasharray="7 6" opacity="@(path.HasError ? ".9" : "1")">
                        @foreach (var segment in path.Segments)
                        {
                            <path d="@segment">
                                <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                            </path>
                        }
                    </g>
                }
                @* Line dẫn đường transient của dot đang chạy (user 2026-10-08): nét đứt +
                   marching-ants màu trạng thái ĐÍCH — sáng full khi dot di chuyển rồi fade
                   ~0.5s sau khi tới nơi; tự gỡ trong AdvanceTravels, không JS *@
                @foreach (var travel in _travels.Values)
                {
                    <g fill="none" stroke="@travel.Stroke" stroke-width="1.8" stroke-dasharray="7 6"
                       opacity="@TravelOpacity(travel, traceNow)">
                        <path d="@travel.Path">
                            <animate attributeName="stroke-dashoffset" values="0;-26" dur="1s" repeatCount="indefinite" />
                        </path>
                    </g>
                }
                @* (Bỏ 2 circle ornament lặp vô hạn của mockup — user report: bị hiểu nhầm là request
                   đang chạy khi không có request nào; trái nguyên tắc "hình thật cần, không phải
                   animation trang trí" spec §5.1). marching-ants ở trên giữ vì nó GẮN DATA — chỉ vẽ
                   khi có đường route thật. *@
            </svg>

            @* Skeleton spine — luôn vẽ kể cả khi idle (spec §5.1); tọa độ fixed theo mockup *@
            <div class="trace-node" style="left:8px;top:8px;width:120px">
                <span class="cap">@L["trace.node.input"]</span>
                @* Path THẬT của cả 2 endpoint proxy (ProxyApp.cs:124,132) — giữ full path, không
                   truncate "v1/chat" gây hiểu nhầm. /v1/responses (design 2026-09-25 mục 2) đã
                   implement (Task 4) → node liệt kê cả 2. Font 9px/lh 11px có đo lường ở
                   .trace-node__paths — 2 dòng gọn trong ô, không đè spine. *@
                <span class="trace-node__paths"><span class="@PathLitClass("chat")">POST /v1/chat/completions</span><br /><span class="@PathLitClass("responses")">POST /v1/responses</span></span>
            </div>
            <div class="trace-node" style="left:8px;top:96px;width:120px">
                <span class="cap">@L["trace.node.queue"]</span>
                <div class="trace-node__slot"></div>
                <span class="cap">@QueuedCount @L["trace.count.queued"]</span>
            </div>
            <div class="trace-node @(RunningCount > 0 ? "trace-node--act" : "")" style="left:8px;top:188px;width:120px">
                <span class="cap">@L["trace.node.dispatch"]</span>
                <div class="trace-node__slot"></div>
                <span class="cap">@RunningCount @L["trace.count.running"]</span>
            </div>
            <div class="trace-node" style="left:8px;top:336px;width:120px">
                <span class="cap">@L["trace.node.client"]</span>
                <div class="trace-node__slot"></div>
            </div>

            @foreach (var combo in _layout.Combos)
            {
                <div class="trace-node @(combo.Running ? "trace-node--act" : "")"
                     style="left:@(ComboLeft)px;top:@(combo.Top)px;width:@(ComboWidth)px"
                     @key="@($"combo-{combo.Name}")">
                    <span class="cap">@L["trace.node.combo"]</span>
                    <div class="trace-node__slot"></div>
                    @combo.DisplayName
                </div>
            }

            @foreach (var provider in _layout.Providers)
            {
                <div class="trace-node @(provider.Running ? "trace-node--act" : "") @(provider.HasError ? "trace-node--err" : "")"
                     style="left:@(ProviderLeft)px;top:@(provider.Top)px;width:@(ProviderWidth)px"
                     @key="@($"provider-{provider.Name}")">
                    <span class="cap">@L["trace.node.provider"]</span>
                    <div class="trace-node__slot"></div>
                    @* Không vẽ dot trạng thái trong node Provider — user report: trùng với dot
                       ở chip account ngay cạnh, nhìn như hình trang trí. Trạng thái provider vẫn
                       có qua border --act/--err và tag lỗi bên dưới; dot thật chỉ ở chip account. *@
                    @provider.Name
                    @if (provider.ErrorStatus is { } status)
                    {
                        <span class="trace-tag trace-tag--bad">@status</span>
                    }
                </div>
            }

            @foreach (var chip in _layout.Chips)
            {
                @if (chip.IsIdle)
                {
                    @* Chip "+N idle" → expand inline danh sách TK (spec §5.5 — không dùng Modal) *@
                    <button type="button" class="trace-chip trace-chip--idle"
                            style="left:@(AccountLeft)px;top:@(chip.Top)px"
                            aria-expanded="@(_expandedIdleProvider == chip.Provider)"
                            @key="@($"idle-{chip.Provider}")"
                            @onclick="() => ToggleIdleProvider(chip.Provider)">
                        @string.Format(L["trace.idleAccounts"], chip.IdleCount) @(_expandedIdleProvider == chip.Provider ? "▴" : "▾")
                    </button>
                    @if (_expandedIdleProvider == chip.Provider)
                    {
                        <div class="trace-idle-list" style="@IdleListStyle(chip)" @key="@($"idle-list-{chip.Provider}")">
                            <ul>
                                @foreach (var account in chip.IdleAccounts)
                                {
                                    <li @key="account.Name">
                                        @if (account.Living)
                                        {
                                            <i class="trace-idot @(account.Running ? "" : "trace-idot--dim")"></i>
                                        }
                                        @account.Name
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
                else
                {
                    // G4: account có proxy đang cooldown → TRANG TRÍ chip (spec §3.5): giữ nguyên
                    // tên/visual trạng thái, thêm viền đỏ đứt qua class + badge đếm ngược bên trong.
                    var cooling = TryGetCooldown(chip.Name, out var remaining);
                    <div class="trace-chip @(chip.Running ? "trace-chip--act" : "") @(chip.HasError ? "trace-chip--err" : "") @(cooling ? "trace-chip--cooldown" : "")"
                         style="left:@(AccountLeft)px;top:@(chip.Top)px"
                         @key="@($"chip-{chip.Provider}-{chip.Name}")">
                        <span class="trace-chip__dotrow"><i class="trace-idot @NodeDotClass(chip.Running, chip.HasError)"></i></span>
                        <span class="trace-chip__name">@chip.Name
                            @if (cooling)
                            {
                                <span class="trace-chip__cooldown">@string.Format(L["trace.cooldown"], (int)Math.Ceiling(remaining.TotalSeconds))</span>
                            }
                        </span>
                    </div>
                }
            }

            @* Circle = request: 1 dot tuyệt đối/node, stack ngang căn giữa lane tâm theo anchor của stage *@
            @foreach (var group in BuildGroups())
            {
                for (var i = 0; i < group.Shown.Count; i++)
                {
                    var node = group.Shown[i];
                    // Dot đang đổi stage → bám điểm hiện tại của travel (đang giữa đường)
                    // thay vì anchor cuối; glow trong lúc còn di chuyển (ArrivalAt)
                    var left = group.X + i * DotStepX;
                    var top = group.Y;
                    var gliding = false;
                    if (_travels.TryGetValue(node.Id, out var travel) && travel is not null)
                    {
                        left = travel.Points[travel.Idx].X;
                        top = travel.Points[travel.Idx].Y;
                        gliding = traceNow <= travel.ArrivalAt;
                    }
                    <div class="@("trace-dot " + ColorClass(node) + (node.Stage == TraceStage.Parked ? " trace-dot--park" : "") + (gliding ? " trace-dot--move" : ""))" @key="node.Id"
                         style="left:@(left)px;top:@(top)px"
                         title="@node.Endpoint"
                         @onclick="() => OpenDetail(node.Id)"></div>
                }
                @if (group.Y == QueueTop + DotRowOffsetY)
                {
                    var row = 0;
                    foreach (var node in group.Shown)
                    {
                        var tag = TraceNodeAggregator.PriorityTag(node.Priority);
                        var headers = node.HeadersSent == true;
                        var park = node.Stage == TraceStage.Parked;
                        if (tag is null && !headers && !park)
                        {
                            continue;
                        }
                        <div class="trace-queue-badges" style="left:132px;top:@(group.Y - 6 + row * 14)px"
                             @key="@($"badge-{node.Id}")">
                            @if (tag is not null)
                            {
                                <span class="trace-tag @tag">@(node.Priority == RequestPriority.Highest ? L["trace.priority.highest"] : L["trace.priority.high"])</span>
                            }
                            @if (headers)
                            {
                                <span class="trace-badge trace-badge--headers">@L["trace.headers.badge"]</span>
                            }
                            @if (park)
                            {
                                <span class="trace-badge trace-badge--park">@L["trace.park.badge"]</span>
                            }
                        </div>
                        row++;
                    }
                    @* +N xếp DƯỚI cột tag bên phải node (không inline sau hàng dot — hàng đã
                       căn giữa nên inline sẽ chạm tag ở x=132) *@
                    if (group.Overflow > 0)
                    {
                        <div class="trace-badge trace-badge--float"
                             style="left:132px;top:@(group.Y - 6 + row * 14)px">@string.Format(L["trace.more"], group.Overflow)</div>
                    }
                }
                else if (group.Overflow > 0)
                {
                    <div class="trace-badge trace-badge--float"
                         style="left:@(group.X + group.Shown.Count * DotStepX)px;top:@(group.Y)px">@string.Format(L["trace.more"], group.Overflow)</div>
                }
            }
        </div>
    </div>

    <div class="trace-legend">
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--white"></i>@L["trace.legend.queued"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--blue"></i>@L["trace.legend.running"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--green"></i>@L["trace.legend.ok"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--red"></i>@L["trace.legend.error"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--yellow"></i>@L["trace.legend.cancelled"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--white trace-ldot--ring trace-ldot--ring-amber"></i>@L["trace.legend.parked"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--green trace-ldot--ring trace-ldot--ring-green"></i>@L["trace.legend.headers"]</span>
        <span class="trace-legend__item"><i class="trace-ldot trace-dot--yellow trace-ldot--ring trace-ldot--ring-amber"></i><i class="trace-ldot trace-dot--blue trace-ldot--ring trace-ldot--ring-blue"></i>@L["trace.priority.highest"]/@L["trace.priority.high"]</span>
        <span class="trace-legend__hint">@L["trace.fadeHint"]</span>
    </div>
</div>

@* Modal chi tiết — component dùng chung (Task 5): circle Live Trace và row API Monitor
   cùng mở popup này. Đặt ngoài block chính vì Modal render fixed. *@
@* @() tường minh: param kiểu string mà bind bare-identifier sẽ Razor hiểu là string literal
