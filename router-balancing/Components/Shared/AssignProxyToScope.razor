@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Proxies
@inject IProxyService ProxySvc
@inject LocalizationService L
@inject ToastService Toast
@inject ILogService Log

@* Form "+ Gán provider cho proxy này": cộng ProxyId vào tập của scope provider.
   Override theo AC chỉ thao tác qua panel ✎ của từng AC trên cây.
   Nạp assignment của provider lúc đổi select để prefill mode + merge đúng danh sách cũ. *@
<div class="pt-panel">
    <div class="mb-2 flex flex-wrap items-center gap-2">
        <select class="rounded border border-border bg-surface px-2 py-1"
                value="@_providerText" @onchange="OnProviderChanged"
                disabled="@(_busy || _loadingScope)">
            <option value="">@L["proxies.assign.select_provider"]</option>
            @foreach (var p in Providers)
            {
                <option value="@p.Id">@p.Name</option>
            }
        </select>

        <span class="text-xs opacity-70">@L["proxies.assign.mode"]</span>
        @* null ≡ RoundRobin (D6) — chỉ 2 lựa chọn tường minh, lưu tường minh *@
        <select class="rounded border border-border bg-surface px-2 py-1"
                value="@_mode" @onchange="OnModeChanged"
                disabled="@(_busy || _loadingScope)">
            <option value="rr">@L["proxies.assign.mode_rr"]</option>
            <option value="fb">@L["proxies.assign.mode_fallback"]</option>
        </select>
    </div>

    @if (_loadingScope)
    {
        <p class="text-xs opacity-70">...</p>
    }

    @if (_error is not null)
    {
        <div class="mb-2 text-xs text-danger">@_error</div>
    }

    <div class="flex gap-2">
        <button type="button" class="btn btn-primary"
                disabled="@(_busy || _loadingScope || _providerId is null || !_scopeLoaded)"
                @onclick="SaveAsync">
            @L["proxies.assign.save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy"
                @onclick="@(() => OnCancel.InvokeAsync())">
            @L["confirm.cancel"]
        </button>
    </div>
</div>

@code {
    /// <summary>Proxy đang mở form — danh sách cũ của provider sẽ được cộng thêm id này.</summary>
    [Parameter, EditorRequired]
    public long ProxyId { get; set; }

    /// <summary>Nguồn option provider (đã nạp sẵn ở trang cha).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Provider> Providers { get; set; } = [];

    /// <summary>Cháy sau khi gán thành công — trang cha tải lại cây.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Đóng form.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private long? _providerId;
    private string _mode = string.Empty;
    private IReadOnlyList<ProxyAssignment> _scopeRows = [];
    private int _assignLoadToken; // race: đổi provider khi load cũ còn chạy (D-A3)
    private bool _loadingScope;
    private bool _scopeLoaded; // chỉ merge/save khi đã nạp đúng danh sách cũ — tránh ghi đè mất dữ liệu
    private bool _busy;
    private string? _error;

    private string _providerText => _providerId?.ToString() ?? string.Empty;

    private async Task OnProviderChanged(ChangeEventArgs e)
    {
        _providerId = long.TryParse(e.Value?.ToString(), out var id) && id > 0 ? id : null;
        _mode = string.Empty;
        _scopeRows = [];
        _scopeLoaded = false;
        _error = null;

        if (_providerId is { } providerId)
        {
            _ = LoadScopeAsync(++_assignLoadToken, providerId);
        }
        else
        {
            _loadingScope = false;
            StateHasChanged();
        }
    }

    private void OnModeChanged(ChangeEventArgs e)
    {
        _mode = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    /// <summary>Nạp assignment của provider đang chọn — prefill mode + danh sách cũ để merge.</summary>
    private async Task LoadScopeAsync(int loadToken, long providerId)
    {
        _loadingScope = true;
        try
        {
            IReadOnlyList<ProxyAssignment> rows;
            try
            {
                rows = await ProxySvc.GetAssignmentsAsync(providerId);
            }
            catch (Exception ex)
            {
                Log.Error("Không tải được gán proxy hiện có của provider.", ex);
                Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
                rows = [];
            }

            // Load của provider cũ về trễ bị discard (D-A3)
            if (loadToken != _assignLoadToken) return;
            _scopeRows = rows;
            // Load lỗi → _scopeLoaded vẫn false, nút Gán khóa — không ghi đè mất gán cũ
            _scopeLoaded = rows.Count > 0;
            // null ≡ RoundRobin (D6) — hiển thị rr tường minh
            _mode = ModeValue(ScopeRow()?.Mode ?? ProxyMode.RoundRobin);
        }
        finally
        {
            if (loadToken == _assignLoadToken)
            {
                _loadingScope = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>Hàng provider trong assignment — thiếu = chưa có hàng provider-level.</summary>
    private ProxyAssignment? ScopeRow() => _scopeRows.FirstOrDefault(r => r.IsProvider);

    private static string ModeValue(ProxyMode? mode) => mode switch
    {
        ProxyMode.RoundRobin => "rr",
        ProxyMode.Fallback => "fb",
        _ => string.Empty,
    };

    private static ProxyMode? ModeFromValue(string value) => value switch
    {
        "rr" => ProxyMode.RoundRobin,
        "fb" => ProxyMode.Fallback,
        _ => null,
    };

    private async Task SaveAsync()
    {
        if (_busy || _loadingScope || !_scopeLoaded || _providerId is not { } providerId) return;

        _busy = true;
        try
        {
            // Cộng proxy này vào danh sách cũ của provider — không đụng proxy đã gán ở nơi khác
            var proxyIds = ScopeRow()?.ProxyIds.ToList() ?? [];
            if (!proxyIds.Contains(ProxyId))
            {
                proxyIds.Add(ProxyId);
            }

            // null ≡ RR — lưu tường minh, hết ambiguous (D6)
            await ProxySvc.AssignProviderProxiesAsync(
                providerId, proxyIds, ModeFromValue(_mode) ?? ProxyMode.RoundRobin);
            Toast.Show(L["proxies.assign.message"], ToastSeverity.Success);

            await OnSaved.InvokeAsync();
        }
        catch (KeyNotFoundException ex)
        {
            // Proxy/provider bị xóa ở nơi khác giữa lúc load và lúc save (D-A4)
            Log.Error("Không gán proxy cho provider.", ex);
            _error = L["proxies.assign.error.scopeNotFound"];
        }
        catch (Exception ex)
        {
            Log.Error("Không gán proxy cho provider.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
