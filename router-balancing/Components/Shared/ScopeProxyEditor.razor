@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Proxies
@inject IProxyService ProxySvc
@inject LocalizationService L
@inject ToastService Toast
@inject ILogService Log

@* Form sửa gán theo chiều scope (phương án B): scope đã chọn sẵn, tick toàn bộ proxy, mode.
   Hiển thị EFFECTIVE view: AC chưa override thấy tập kế thừa được tick sẵn; tick/bỏ tick
   rồi Lưu ghi override (D1: override thay thế tập kế thừa). *@
<div class="pt-panel">
    @if (_loading)
    {
        <p class="text-xs opacity-70">...</p>
    }
    else
    {
        <div class="mb-2 flex flex-wrap items-center gap-2">
            <span class="font-medium">@ScopeLabel</span>
            <span class="text-xs opacity-70">@L["proxies.assign.mode"]</span>
            <select class="rounded border border-border bg-surface px-2 py-1"
                    value="@_mode" @onchange="OnModeChanged" disabled="@_saving">
                @* Scope provider: null ≡ RoundRobin (D6) — chỉ 2 lựa chọn tường minh.
                   Scope AC: "kế thừa" = không override mode (lấy mode provider). *@
                @if (AccountId is not null)
                {
                    <option value="">@L["proxies.assign.mode_inherit"]</option>
                }
                <option value="rr">@L["proxies.assign.mode_rr"]</option>
                <option value="fb">@L["proxies.assign.mode_fallback"]</option>
            </select>
        </div>

        <div class="mb-2 flex flex-col gap-1">
            @foreach (var row in AllProxies)
            {
                <label class="flex items-center gap-2">
                    <input type="checkbox" checked="@_proxyIds.Contains(row.Id)" disabled="@_saving"
                           @onchange="() => ToggleProxy(row.Id)" />
                    <span class="font-mono">@EndpointOf(row)</span>
                    @if (!row.Enabled)
                    {
                        @* Proxy tắt vẫn tick được — pool tự lọc (D-A2) *@
                        <span class="text-xs opacity-60">@L["proxies.assign.disabledSuffix"]</span>
                    }
                </label>
            }
        </div>

        @if (AccountId is not null && _proxyIds.Count == 0)
        {
            @* Proxy đã gán cho provider phải luôn có ít nhất 1 AC đi qua nó — không cho lưu tập rỗng *@
            <p class="mb-2 text-xs text-danger">@L["proxies.assign.needOneProxy"]</p>
        }

        @if (AccountId is null && _overrideCount > 0)
        {
            @* Bulk reset: đưa mọi AC của provider về kế thừa (xóa hàng override) *@
            <div class="mb-2">
                <button type="button" class="btn btn-outline-secondary" disabled="@_saving"
                        @onclick="@(() => _confirmReset = true)">
                    ↺ @L["proxies.assign.resetOverrides"] (@_overrideCount)
                </button>
            </div>
        }

        @if (_error is not null)
        {
            <div class="mb-2 text-xs text-danger">@_error</div>
        }

        <div class="flex gap-2">
            <button type="button" class="btn btn-primary"
                    disabled="@(_saving || (AccountId is not null && _proxyIds.Count == 0))"
                    @onclick="SaveAsync">
                @L["proxies.assign.save"]
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@_saving"
                    @onclick="@(() => OnCancel.InvokeAsync())">
                @L["confirm.cancel"]
            </button>
        </div>
    }

    @if (_confirmReset)
    {
        <ConfirmDialog Visible="true"
                       Title="@L["proxies.assign.resetOverrides"]"
                       Message="@string.Format(L["proxies.assign.resetOverridesConfirm"], _overrideCount)"
                       Danger="true"
                       ConfirmText="@L["proxies.assign.resetOverrides"]"
                       CancelText="@L["confirm.cancel"]"
                       OnConfirm="ResetOverridesAsync"
                       OnCancel="@(() => _confirmReset = false)" />
    }
</div>

@code {
    /// <summary>Provider sở hữu scope — cần cho query assignment (lấy cả hàng account).</summary>
    [Parameter, EditorRequired]
    public long ProviderId { get; set; }

    /// <summary>null = scope provider; có giá trị = scope override của account.</summary>
    [Parameter]
    public long? AccountId { get; set; }

    /// <summary>Nhãn scope đã i18n ở nơi gọi — ví dụ "Tài khoản acc-1".</summary>
    [Parameter, EditorRequired]
    public string ScopeLabel { get; set; } = string.Empty;

    /// <summary>Toàn bộ proxy để tick — do trang cha truyền vào.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<OutboundProxy> AllProxies { get; set; } = [];

    /// <summary>Cháy sau khi lưu thành công — trang cha tải lại cây.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Đóng panel — hủy hoặc lỗi không sửa được.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private List<long> _proxyIds = [];
    private string _mode = string.Empty;
    // Hàng provider đã load lúc mở form — so sánh khi quyết định "quay kế thừa" (AC scope)
    private List<long> _providerProxyIds = [];
    private ProxyMode? _providerMode;
    // Số AC của provider đang override — hiện nút bulk reset ở scope provider
    private int _overrideCount;
    private bool _confirmReset;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    /// <summary>Nạp assignment của scope 1 lần lúc mở — chỉ 1 panel được mở nên không cần token.</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await ProxySvc.GetAssignmentsAsync(ProviderId);
            var row = AccountId is { } accountId
                ? rows.FirstOrDefault(r => !r.IsProvider && r.Id == accountId)
                : rows.FirstOrDefault(r => r.IsProvider);

            if (row is null)
            {
                // Scope bị xóa ở nơi khác giữa lúc render tree và lúc mở form (D-A4)
                Log.Error("Không tìm thấy scope để sửa gán proxy.",
                    new KeyNotFoundException($"provider={ProviderId}, account={AccountId}"));
                Toast.Show(L["proxies.assign.error.scopeNotFound"], ToastSeverity.Error);
                await OnCancel.InvokeAsync();
                return;
            }

            var providerRow = rows.FirstOrDefault(r => r.IsProvider);
            _providerProxyIds = providerRow?.ProxyIds.ToList() ?? [];
            _providerMode = providerRow?.Mode;
            _overrideCount = rows.Count(r => !r.IsProvider && r.ProxyIds.Count > 0);

            if (AccountId is null)
            {
                // Provider scope: null ≡ RoundRobin (D6) — hiển thị + lưu tường minh rr
                _proxyIds = row.ProxyIds.ToList();
                _mode = ModeValue(row.Mode ?? ProxyMode.RoundRobin);
            }
            else
            {
                // AC scope — effective view: chưa override (tập rỗng) → thấy tập KẾ THỪA được tick.
                // Hàng override khác rỗng → tập override thay thế kế thừa (D1).
                _proxyIds = row.ProxyIds.Count > 0 ? row.ProxyIds.ToList() : [.. _providerProxyIds];
                // Mode select của AC lưu mode override thô: null = "Kế thừa provider"
                _mode = ModeValue(row.Mode);
            }
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được gán proxy của scope.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
            await OnCancel.InvokeAsync();
            return;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string EndpointOf(OutboundProxy row) => $"{row.Scheme}://{row.Host}:{row.Port}";

    private static string ModeValue(ProxyMode? mode) => mode switch
    {
        ProxyMode.RoundRobin => "rr",
        ProxyMode.Fallback => "fb",
        _ => string.Empty,
    };

    private static ProxyMode? ModeFromValue(string value) => value switch
    {
        "rr" => ProxyMode.RoundRobin,
        "fb" => ProxyMode.Fallback,
        _ => null,
    };

    private void OnModeChanged(ChangeEventArgs e)
    {
        _mode = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void ToggleProxy(long id)
    {
        if (!_proxyIds.Remove(id))
        {
            _proxyIds.Add(id);
        }
        // Blazor không re-render khi chỉ mutate danh sách trong chỗ — ép render để checkbox cập nhật
        StateHasChanged();
    }

    /// <summary>Xóa toàn bộ hàng override của provider — mọi AC quay về kế thừa (bulk).</summary>
    private async Task ResetOverridesAsync()
    {
        if (_saving) return;
        _saving = true;
        try
        {
            var count = await ProxySvc.ResetAccountOverridesAsync(ProviderId);
            _confirmReset = false;
            _overrideCount = 0;
            Toast.Show(
                string.Format(L["proxies.assign.resetOverridesDone"], count), ToastSeverity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không đưa được các AC về kế thừa.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || (AccountId is not null && _proxyIds.Count == 0)) return;
        _saving = true;
        try
        {
            if (AccountId is { } accountId)
            {
                // Chọn "kế thừa" → không override mode; tập hiệu lực trùng kế thừa toàn bộ
                // (tập + mode) → xóa override, quay kế thừa động thay vì ghi hàng copy.
                var chosen = ModeFromValue(_mode);
                var providerEffectiveMode = _providerMode ?? ProxyMode.RoundRobin;
                var effectiveMode = chosen ?? providerEffectiveMode;
                var sameSet = !_proxyIds.Except(_providerProxyIds).Any()
                    && !_providerProxyIds.Except(_proxyIds).Any();
                if (sameSet && effectiveMode == providerEffectiveMode)
                {
                    await ProxySvc.AssignAccountProxiesAsync(accountId, [], null);
                }
                else
                {
                    await ProxySvc.AssignAccountProxiesAsync(accountId, _proxyIds, chosen);
                }
                Toast.Show(L["proxies.assign.message_account"], ToastSeverity.Success);
            }
            else
            {
                // Provider scope: select chỉ còn rr/fb — lưu tường minh, hết ambiguous null
                await ProxySvc.AssignProviderProxiesAsync(
                    ProviderId, _proxyIds, ModeFromValue(_mode) ?? ProxyMode.RoundRobin);
                Toast.Show(L["proxies.assign.message"], ToastSeverity.Success);
            }

            await OnSaved.InvokeAsync();
        }
        catch (KeyNotFoundException ex)
        {
            // Proxy/provider/ac bị xóa ở nơi khác giữa lúc load và lúc save (D-A4)
            Log.Error("Không lưu được gán proxy của scope.", ex);
            _error = L["proxies.assign.error.scopeNotFound"];
        }
        catch (Exception ex)
        {
            Log.Error("Không lưu được gán proxy của scope.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
