@using Microsoft.JSInterop
@using RouterBalancing.Core.Domain
@inject LocalizationService L
@inject IJSRuntime JS

<style>
    /* Combo chọn model có search (mockup variant B v3): nhóm optgroup theo provider,
       search live trong dropdown theo model id/display/name/identifier — thay select
       native + ô search tách ngoài của form Combo. Theme dùng vars app
       (--surface/--border/--text) nên tự sáng/tối. Menu position fixed theo trigger
       qua rbCombo.place để không bị overflow-y-auto của Modal cắt. */
    .modelcombo {
        position: relative;
        flex: 1;
        min-width: 0;
    }

    .modelcombo__control {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
        padding: 5px 8px;
        font-size: 13px;
        text-align: left;
        color: inherit;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        cursor: pointer;
    }

    /* Ô đang chọn 2-3 dòng: model xanh accent thụ nhẹ, provider mờ dưới,
       capabilities (ctx + cờ) dòng cuối — mockup v3 + yêu cầu thêm dòng ctx */
    .modelcombo__value {
        display: flex;
        flex-direction: column;
        min-width: 0;
        line-height: 1.25;
        padding-left: 4px;
    }

    .modelcombo__model {
        color: #3b82f6;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .modelcombo__provider {
        font-size: 11px;
        opacity: .6;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Dòng 3 — capabilities của model; badge Pill giãn 4px, tràn thì cắt (không xuống dòng) */
    .modelcombo__caps {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-top: 2px;
        font-size: 11px;
        overflow: hidden;
        white-space: nowrap;
    }

    .modelcombo__chev {
        opacity: .5;
        flex: none;
    }

    /* Overlay toàn khung dialog — bắt click ngoài dropdown; stopPropagation ở dialog
       nên Modal backdrop không bị đóng theo (xem Modal.razor). */
    .modelcombo__overlay {
        position: fixed;
        inset: 0;
        z-index: 40;
    }

    .modelcombo__menu {
        /* Fallback absolute dưới trigger — rbCombo.place sẽ chuyển sang fixed + tọa độ */
        position: absolute;
        z-index: 50;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        max-height: 260px;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, .22);
        overflow: hidden;
    }

    .modelcombo__search {
        box-sizing: border-box;
        flex: none;
        width: 100%;
        padding: 7px 10px;
        font-size: 13px;
        color: inherit;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--border);
        outline: none;
    }

    .modelcombo__list {
        overflow-y: auto;
    }

    .modelcombo__group {
        padding: 6px 10px 3px;
        font-size: 10px;
        letter-spacing: .05em;
        text-transform: uppercase;
        opacity: .5;
        position: sticky;
        top: 0;
        background: var(--surface);
    }

    .modelcombo__opt {
        padding: 7px 10px;
        font-size: 13px;
        cursor: pointer;
    }

    .modelcombo__opt:hover {
        background: rgba(59, 130, 246, .12);
    }

    .modelcombo__empty {
        padding: 12px;
        font-size: 12px;
        text-align: center;
        opacity: .55;
    }
</style>

<div class="modelcombo">
    <button type="button" class="modelcombo__control" @ref="_controlRef" @onclick="ToggleAsync">
        <span class="modelcombo__value">
            <span class="modelcombo__model">@SelectedModelText</span>
            @if (SelectedProviderText is { } providerLabel)
            {
                <span class="modelcombo__provider">@providerLabel</span>
            }
            @* Dòng 3 — capabilities của model đang chọn, cùng ngữ nghĩa emoji với cột caps ở bảng combo *@
            @if (SelectedModelInfo is { } capsModel)
            {
                var hasCaps = capsModel.ContextWindow is not null
                    || capsModel.SupportsVision || capsModel.SupportsThink
                    || capsModel.SupportsAudio || capsModel.SupportsVideo;
                if (hasCaps)
                {
                    <span class="modelcombo__caps">
                        @if (capsModel.ContextWindow is { } ctx)
                        {
                            <Badge Text="@($"ctx: {FormatCtx(ctx)}")" Variant="BadgeVariant.Info" />
                        }
                        @* Chỉ hiện cờ khi true — false của Model = "chưa rõ/chưa fill", ghi ✕ sẽ hiểu sai là "không hỗ trợ" *@
                        @if (capsModel.SupportsVision)
                        {
                            <Badge Text="👁" Variant="BadgeVariant.Success" />
                        }
                        @if (capsModel.SupportsThink)
                        {
                            <Badge Text="⚡" Variant="BadgeVariant.Warning" />
                        }
                        @if (capsModel.SupportsAudio)
                        {
                            <Badge Text="🔊" Variant="BadgeVariant.Purple" />
                        }
                        @if (capsModel.SupportsVideo)
                        {
                            <Badge Text="🎬" Variant="BadgeVariant.Pink" />
                        }
                    </span>
                }
            }
        </span>
        <span class="modelcombo__chev">▾</span>
    </button>

    @if (_open)
    {
        <div class="modelcombo__overlay" @onclick="Close"></div>
        <div class="modelcombo__menu" @ref="_menuRef">
            <input @ref="_searchRef" class="modelcombo__search"
                   placeholder="@L["combos.combo.search"]"
                   @bind="_search" @bind:event="oninput"
                   @onkeydown="OnSearchKeyDownAsync" @onkeydown:stopPropagation="true" />
            <div class="modelcombo__list">
                <div class="modelcombo__opt" @onclick="() => SelectAsync(null)">—</div>
                @foreach (var group in FilteredGroups)
                {
                    <div class="modelcombo__group">@group.Label</div>
                    @foreach (var model in group.Models)
                    {
                        var m = model;
                        @* Option chỉ hiện model id — provider đã có ở header group (mockup v2) *@
                        <div class="modelcombo__opt" @onclick="() => SelectAsync(m.Id)">@m.ModelId</div>
                    }
                }
                @if (!FilteredGroups.Any())
                {
                    <div class="modelcombo__empty">@L["combos.combo.empty"]</div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>Danh sách provider kèm model — nguồn option; chỉ model Enabled được liệt kê (model đang chọn vẫn giữ dù đã tắt).</summary>
    [Parameter] public IReadOnlyList<Provider> Providers { get; set; } = [];

    /// <summary>Model đang chọn — null = chưa chọn.</summary>
    [Parameter] public long? Value { get; set; }

    /// <summary>Phát khi người dùng chọn/bỏ chọn model.</summary>
    [Parameter] public EventCallback<long?> ValueChanged { get; set; }

    private sealed record GroupRow(string Label, IReadOnlyList<Model> Models);

    private bool _open;
    private string _search = string.Empty;
    private bool _focusSearch;
    private ElementReference _controlRef;
    private ElementReference _searchRef;
    private ElementReference _menuRef;

    /// <summary>Dòng 1 của ô đang chọn — model id; "—" khi chưa chọn.</summary>
    private string SelectedModelText
    {
        get
        {
            var entry = FindSelected();
            return entry is { } e ? e.Model.ModelId : "—";
        }
    }

    /// <summary>Dòng 2 của ô đang chọn — "Name (Identifier)" của provider; null khi chưa chọn.</summary>
    private string? SelectedProviderText => FindSelected() is { } e ? ProviderLabel(e.Provider) : null;

    /// <summary>Model đang chọn — nguồn dòng capabilities (dòng 3); null khi chưa chọn model.</summary>
    private Model? SelectedModelInfo => FindSelected() is { } e ? e.Model : null;

    /// <summary>128000 → "128k"; ≥1000000 → "1M" (1000k đọc thành chữ dài); dưới 1000 giữ nguyên.</summary>
    private static string FormatCtx(int contextWindow) =>
        contextWindow >= 1_000_000 ? $"{contextWindow / 1_000_000}M"
            : contextWindow >= 1000 ? $"{contextWindow / 1000}k"
            : contextWindow.ToString();

    private (Provider Provider, Model Model)? FindSelected()
    {
        if (Value is not { } id)
        {
            return null;
        }

        foreach (var provider in Providers)
        {
            foreach (var model in provider.Models)
            {
                if (model.Id == id)
                {
                    return (provider, model);
                }
            }
        }
        return null;
    }

    /// <summary>Nhóm option theo provider — filter Enabled + search; giữ model đang chọn dù đã tắt.</summary>
    private IEnumerable<GroupRow> FilteredGroups
    {
        get
        {
            var term = _search.Trim();
            foreach (var provider in Providers)
            {
                var models = provider.Models
                    .Where(m => m.Enabled || m.Id == Value)
                    .Where(m => Matches(m, provider, term))
                    .ToList();
                if (models.Count > 0)
                {
                    yield return new GroupRow(ProviderLabel(provider), models);
                }
            }
        }
    }

    /// <summary>Tên group/nhãn provider: "Name" hoặc "Name (Identifier)".</summary>
    private static string ProviderLabel(Provider provider) =>
        string.IsNullOrEmpty(provider.Identifier)
            ? provider.Name
            : $"{provider.Name} ({provider.Identifier})";

    /// <summary>
    /// Match search: rỗng → tất cả; ngược lại so không phân biệt hoa/thường với model id,
    /// display name, tên provider và identifier (client pin theo "{Identifier}/{ModelId}").
    /// </summary>
    private static bool Matches(Model model, Provider provider, string term)
    {
        if (term.Length == 0)
        {
            return true;
        }

        return model.ModelId.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (model.DisplayName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || provider.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (provider.Identifier?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task ToggleAsync()
    {
        _open = !_open;
        _search = string.Empty;
        _focusSearch = _open;
        if (_open)
        {
            // Render menu xong mới focus được input — chờ frame render kế tiếp
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Close() => _open = false;

    /// <summary>Esc trong ô search đóng dropdown (không đóng modal — đã stopPropagation).</summary>
    private Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
        return Task.CompletedTask;
    }

    private async Task SelectAsync(long? modelId)
    {
        _open = false;
        if (modelId != Value)
        {
            Value = modelId;
            await ValueChanged.InvokeAsync(modelId);
        }
    }

    /// <summary>Focus ô search + place menu fixed theo trigger sau khi menu vừa render.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchRef.FocusAsync();
            // Place sau focus để tránh browser tự scroll container làm lệch tọa độ
            try
            {
                await JS.InvokeVoidAsync("rbCombo.place", _controlRef, _menuRef);
            }
            catch (JSException)
            {
                // JS không load được — giữ fallback CSS absolute (menu vẫn mở dưới trigger)
            }
        }
    }
}
