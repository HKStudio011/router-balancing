@* Phân trang client-side — state (Page/PageSize) do parent giữ qua @bind để persist qua re-render *@
@using RouterBalancing.Core.Ui
@inject LocalizationService L

@if (Total > PageSize)
{
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
        @if (ShowFirstLast)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(1)">
                «&nbsp;@L["pager.first"]
            </button>
        }

        <button type="button" class="btn btn-outline-secondary" disabled="@(Page <= 1)" @onclick="PrevAsync">
            @L["pager.prev"]
        </button>

        @foreach (var item in PagerWindow.Build(Page, PageCount))
        {
            @if (item is { } number)
            {
                <button type="button"
                        class="@(number == Page ? "btn btn-dark" : "btn btn-outline-secondary")"
                        aria-current="@(number == Page ? "page" : null)"
                        disabled="@(number == Page)"
                        @onclick="() => PageChanged.InvokeAsync(number)">
                    @number
                </button>
            }
            else
            {
                <span class="px-1 opacity-60">…</span>
            }
        }

        <button type="button" class="btn btn-outline-secondary" disabled="@(Page >= PageCount)" @onclick="NextAsync">
            @L["pager.next"]
        </button>

        @if (ShowFirstLast)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@(Page >= PageCount)" @onclick="() => PageChanged.InvokeAsync(PageCount)">
                @L["pager.last"]&nbsp;»
            </button>
        }

        <label class="ml-1 flex items-center gap-1">
            @L["pager.goto"]
            <input type="number" min="1" max="@PageCount" value="@Page"
                   class="w-16 rounded border border-border bg-surface px-1 py-0.5"
                   @onchange="GotoAsync" />
        </label>

        <label class="flex items-center gap-1">
            @L["pager.pageSize"]
            <select value="@PageSize" class="rounded border border-border bg-surface px-1 py-0.5"
                    @onchange="PageSizeSelectAsync">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size">@size</option>
                }
            </select>
        </label>
    </div>

    <div class="mt-1 text-xs opacity-70">
        @string.Format(L["pager.range"], RangeStart, RangeEnd, Total)
    </div>
}

@code {
    /// <summary>Tổng số dòng.</summary>
    [Parameter] public int Total { get; set; }

    /// <summary>Số dòng mỗi trang — parent giữ state.</summary>
    [Parameter] public int PageSize { get; set; } = 10;

    /// <summary>Thông báo PageSize mới khi người dùng đổi — dùng cùng <c>@bind-PageSize</c>.</summary>
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>Trang hiện tại, 1-based — parent giữ state.</summary>
    [Parameter] public int Page { get; set; } = 1;

    /// <summary>Thông báo trang mới khi người dùng chuyển — dùng cùng <c>@bind-Page</c>.</summary>
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>Danh sách kích thước trang trong dropdown — do nơi gọi cấu hình.</summary>
    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 25, 50, 100];

    private int PageCount => Math.Max(1, (Total + PageSize - 1) / PageSize);

    /// <summary>Chỉ hiện First/Last khi số trang nhiều đến mức phải thu gọn (khớp mẫu UI).</summary>
    private bool ShowFirstLast => PageCount > PagerWindow.ShowAllThreshold;

    /// <summary>Dòng đầu của trang hiện tại — dùng cho tóm tắt "dòng X–Y".</summary>
    private int RangeStart => (Page - 1) * PageSize + 1;

    /// <summary>Dòng cuối của trang hiện tại — clamp về Total để không vượt quá dữ liệu.</summary>
    private int RangeEnd => Math.Min(Page * PageSize, Total);

    private Task PrevAsync() => PageChanged.InvokeAsync(Page - 1);

    private Task NextAsync() => PageChanged.InvokeAsync(Page + 1);

    private Task GotoAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var target)) return Task.CompletedTask;
        return PageChanged.InvokeAsync(Math.Clamp(target, 1, PageCount));
    }

    private async Task PageSizeSelectAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size)) return;
        await PageSizeChanged.InvokeAsync(size);
        await PageChanged.InvokeAsync(1); // đổi page size → về trang 1 tránh trang trống
    }
}
