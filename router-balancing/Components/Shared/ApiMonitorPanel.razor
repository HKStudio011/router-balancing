@using RouterBalancing.Core.Engine
@inject IApiMonitorStore Store
@inject LocalizationService L
@inject ILogService Log
@implements IAsyncDisposable

<style>
    /* CSS theo mockup dashboard-monitor.html — priority 7 (style inline trong razor, xem style.css);
       màu dot dùng lại class trace-dot--* từ style block của RequestTrace (cùng render trên Dashboard) */
    .monitor-title {
        font-weight: 600;
        font-size: 14px;
        color: #3b82f6;
        margin-bottom: 10px;
    }

    /* Strip stats duy nhất của dashboard (user quyết 2026-10-07, mockup merge-counts hướng A):
       thay 4 tile + count row của Live Trace — một nguồn số liệu là store (50 request gần nhất).
       Màu dot dùng trace-dot--* qua TraceColors (legend Live Trace cùng bảng). */
    .monitor-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        background: var(--background);
        border-radius: 6px;
        padding: 7px 10px;
        margin-bottom: 10px;
        font-size: 12px;
    }

    .monitor-strip b {
        font-weight: 600;
    }

    .monitor-stat--ok { color: #22c55e; }
    .monitor-stat--error { color: #ef4444; }
    .monitor-stat--cancelled { color: #eab308; }
    /* Màu xanh khớp dot Running (user checklist 2026-10-07) */
    .monitor-stat--running { color: #3b82f6; }

    .monitor-row {
        display: grid;
        grid-template-columns: 10px minmax(0, 1fr) 64px 56px 96px;
        gap: 8px;
        align-items: center;
        padding: 5px 6px;
        border-radius: 4px;
        font-size: 11px;
    }

    .monitor-row--head {
        font-size: 10.5px;
        opacity: .55;
        padding-bottom: 4px;
    }

    /* Zebra xen kẽ (mockup) — rgba trung tính để hợp cả light/dark theme */
    .monitor-body .monitor-row:nth-child(even) {
        background: rgba(127, 127, 127, .07);
    }

    /* Row bấm được → mở popup chi tiết dùng chung (Task 5) */
    .monitor-body .monitor-row {
        cursor: pointer;
    }

    /* Cuộn trong vùng thay vì kéo panel cao vượt Live Trace (mockup "… cuộn …") */
    .monitor-body {
        max-height: 340px;
        overflow-y: auto;
    }

    .monitor-cell--route {
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .monitor-route { opacity: .55; }

    .monitor-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .monitor-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* Row Running: dot nhấp nháy nhẹ cho tới khi xong (mockup "số live nhấp nháy") */
    .monitor-dot--pulse {
        animation: monitor-pulse 1.3s ease-in-out infinite;
    }

    @@keyframes monitor-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.35); }
    }

    .monitor-empty {
        padding: 18px 0;
        text-align: center;
        font-size: 12px;
        opacity: .6;
    }
</style>

<div class="mb-4 rounded border border-border bg-surface p-4">
    <div class="monitor-title">📊 @L["monitor.title"]</div>

    @* Strip gộp toàn bộ số liệu đếm request (hướng A — mockup merge-counts): đếm theo
       50 record trong ring, cùng nguồn với bảng bên dưới. Live Trace không còn count row. *@
    <div class="monitor-strip">
        <span><i class="monitor-dot @TraceColors.ForState(ApiCallState.Queued)"></i><b>@QueuedCount</b> @L["trace.count.queued"]</span>
        <span class="monitor-stat--running"><i class="monitor-dot @TraceColors.ForState(ApiCallState.Running)"></i><b>@RunningCount</b> @L["trace.count.running"]</span>
        <span class="monitor-stat--ok"><i class="monitor-dot @TraceColors.ForState(ApiCallState.Done)"></i><b>@OkCount</b> @L["trace.count.ok"]</span>
        <span class="monitor-stat--error"><i class="monitor-dot @TraceColors.ForState(ApiCallState.Error)"></i><b>@ErrorCount</b> @L["trace.count.error"]</span>
        <span class="monitor-stat--cancelled"><i class="monitor-dot @TraceColors.ForState(ApiCallState.Cancelled)"></i><b>@CancelledCount</b> @L["trace.count.cancelled"]</span>
        <span>⏱ @L["monitor.tiles.avgLatency"] <b>@AvgLatency</b></span>
        <span>Σ @L["monitor.tiles.tokensToday"] <b>@Store.TodayTokens</b></span>
    </div>

    <div class="monitor-row monitor-row--head">
        <span></span>
        <span>@L["monitor.col.model"] · @L["monitor.col.route"]</span>
        <span class="monitor-num">@L["monitor.col.latency"]</span>
        <span class="monitor-num">@L["monitor.col.ttft"]</span>
        <span class="monitor-num">@L["monitor.col.tokens"]</span>
    </div>

    <div class="monitor-body">
        @if (_rows.Count == 0)
        {
            <div class="monitor-empty">@L["monitor.empty"]</div>
        }
        else
        {
            @* Row click → popup chi tiết dùng chung (Task 5) — cùng popup với circle Live Trace *@
            @foreach (var record in _rows)
            {
                @* Pulse chỉ thêm khi Running — tách biến để Razor khỏi parse string literal nhúng trong attribute *@
                var dotClass = record.State == ApiCallState.Running
                    ? TraceColors.ForState(record.State) + " monitor-dot--pulse"
                    : TraceColors.ForState(record.State);
                <div class="monitor-row" @key="record.RequestId"
                     @onclick="() => OpenDetail(record.RequestId)">
                    <i class="monitor-dot @dotClass"></i>
                    <span class="monitor-cell--route">@record.Model<span class="monitor-route"> · @RouteLabel(record)</span></span>
                    <span class="monitor-num">@MonitorFormat.Latency(record)</span>
                    <span class="monitor-num">@MonitorFormat.Ttft(record)</span>
                    <span class="monitor-num">@MonitorFormat.Tokens(record)</span>
                </div>
            }
        }
    </div>
</div>

@* Modal chi tiết dùng chung (Task 5) — render fixed nên đặt ngoài block panel; đóng qua
   Esc/backdrop/× → OnClose xóa selection *@
@* @() tường minh: param string bind bare-identifier = literal "_selectedId" (xem RequestTrace.razor) *@
<RequestDetailModal RequestId="@(_selectedId)" OnClose="() => _selectedId = null" />

@code {
    // Snapshot tối đa 50 record (mới nhất trước) — đọc lại từ store mỗi lần Changed
    private IReadOnlyList<ApiCallRecord> _rows = [];

    // Id request đang mở modal chi tiết dùng chung — null = đóng; row click gán, OnClose xóa
    private string? _selectedId;

    // Component đã gỡ — callback fire-and-forget không được StateHasChanged sau dispose
    private bool _disposed;

    // Đếm theo state cho strip gộp — semantics "50 request gần nhất" (ring), không phải "live trên sơ đồ"
    private int QueuedCount => _rows.Count(r => r.State == ApiCallState.Queued);

    private int RunningCount => _rows.Count(r => r.State == ApiCallState.Running);

    private int OkCount => _rows.Count(r => r.State == ApiCallState.Done);

    /// <summary>Chỉ tính Error, không tính Cancelled (hủy là chủ đích của client).</summary>
    private int ErrorCount => _rows.Count(r => r.State == ApiCallState.Error);

    private int CancelledCount => _rows.Count(r => r.State == ApiCallState.Cancelled);

    /// <summary>Latency trung bình các request đã hoàn tất — "—" khi chưa request nào xong.</summary>
    private string AvgLatency
    {
        get
        {
            var samples = _rows
                .Where(r => r.CompletedAt is not null)
                .Select(r => r.CompletedAt.GetValueOrDefault() - r.StartedAt)
                .ToList();
            return samples.Count == 0
                ? "—"
                : MonitorFormat.Duration(TimeSpan.FromTicks((long)samples.Average(t => t.Ticks)));
        }
    }

    protected override void OnInitialized()
    {
        // Subscribe TRƯỚC khi đọc snapshot — event bắn giữa 2 bước không bị miss;
        // record thấy trùng (có cả trong snapshot lẫn event) là idempotent (mirror RequestTrace).
        Store.Changed += OnChanged;
        _rows = Store.Snapshot();
    }

    /// <summary>
    /// Nhận event từ <see cref="IApiMonitorStore.Changed"/> — chạy trên thread publish của Core.
    /// </summary>
    private void OnChanged()
    {
        // Handler tuyệt đối không được ném: Changed là multicast delegate của store singleton —
        // subscriber ném sẽ chặn các subscriber phía sau (lesson RequestTrace.OnPublished).
        try
        {
            // Publish đến từ thread Kestrel/dispatcher — Blazor chỉ render an toàn trên
            // dispatcher thread nên Marshal bằng InvokeAsync; _disposed chặn StateHasChanged
            // khi callback chạy muộn sau khi component đã gỡ.
            _ = InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    _rows = Store.Snapshot();
                    StateHasChanged();
                }
            });
        }
        catch (Exception ex)
        {
            Log.Error("ApiMonitorPanel: làm mới snapshot thất bại.", ex);
        }
    }

    /// <summary>Mở modal chi tiết dùng chung — gọi từ onclick của row (mirror RequestTrace.OpenDetail).</summary>
    private void OpenDetail(string id) => _selectedId = id;

    /// <summary>Route "Combo · Provider · Account" — thiếu hết → "—", thiếu từng phần → "—" tại chỗ.</summary>
    private static string RouteLabel(ApiCallRecord record) =>
        string.IsNullOrEmpty(record.Combo) && string.IsNullOrEmpty(record.Provider) && string.IsNullOrEmpty(record.Account)
            ? "—"
            : string.Join(" · ",
                string.IsNullOrEmpty(record.Combo) ? "—" : record.Combo,
                string.IsNullOrEmpty(record.Provider) ? "—" : record.Provider,
                string.IsNullOrEmpty(record.Account) ? "—" : record.Account);

    /// <summary>Gỡ subscription và đánh dấu đã dispose — tránh leak delegate trên store singleton.</summary>
    public ValueTask DisposeAsync()
    {
        // Bắt buộc unsubscribe: store là singleton, giữ delegate trỏ vào component đã
        // dispose là leak + handler chạy vô ích cho mỗi lần đổi (mirror RequestTrace.DisposeAsync).
        Store.Changed -= OnChanged;

        // Đánh dấu sau unsubscribe — callback InvokeAsync có thể còn đang đợi trên dispatcher.
        _disposed = true;
        return ValueTask.CompletedTask;
    }
}
