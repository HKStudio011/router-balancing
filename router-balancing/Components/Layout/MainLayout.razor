@inherits LayoutComponentBase
@implements IDisposable
@using RouterBalancing.Core.Update
@inject IProxyHost ProxyHost
@inject ThemeService Theme
@inject ILogService Log
@inject LocalizationService L
@inject ToastService Toast
@inject IAppUpdateService Updates
@inject UpdateCheckService UpdateCheck
@inject UpdateCoordinator Coordinator

<div class="flex h-screen overflow-hidden bg-background text-text">
    <aside class="w-56 shrink-0 border-r border-border bg-surface">
        <NavMenu />
    </aside>

    <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center justify-between border-b border-border bg-surface px-4 py-2">
            <span class="text-sm font-semibold">@L["app.title"]</span>
            <span class="@_badgeClass">@_badgeText</span>
        </header>

        <main class="flex-1 overflow-auto p-4">
            @Body
        </main>

        @* Footer version — format ngắn qua AppVersionFormatter (spec §9.3) *@
        <footer class="border-t border-border bg-surface px-4 py-1 text-right text-xs text-neutral-500">
            v@_appVersion
        </footer>
    </div>

    @* Modal update toàn màn hình — tự render rỗng khi không có update đang chạy *@
    <UpdateModal />

    @* Toast stack: fixed góc dưới phải, z-index cao để nổi trên nội dung *@
    <div class="fixed bottom-4 right-4 z-50 flex flex-col gap-2">
        @foreach (var toast in _toasts)
        {
            <div class="@ToastClass(toast.Severity) rounded px-4 py-2 shadow" @key="toast.Id">
                @toast.Message
            </div>
        }
    </div>
</div>

@code {
    private string _badgeText = string.Empty;
    private string _badgeClass = string.Empty;
    private string _appVersion = string.Empty;
    private readonly List<ToastItem> _toasts = [];

    protected override async Task OnInitializedAsync()
    {
        ProxyHost.StateChanged += OnProxyStateChanged;
        Toast.ToastAdded += OnToastAdded;
        L.LanguageChanged += OnLanguageChanged;
        UpdateCheck.UpdateFound += OnUpdateFound;
        Coordinator.Failed += OnUpdateFailed;
        Coordinator.Cancelled += OnUpdateCancelled;
        _appVersion = AppVersionFormatter.Format(Version.Parse(Updates.CurrentVersion));
        UpdateBadge();
        try
        {
            await Theme.ApplyAsync();
        }
        catch (Exception ex)
        {
            // Failure-domain: lỗi theme (bundle/index.html regression) chỉ được phép
            // tước mất theme — nuốt tại đây để OnInitializedAsync không fault
            // và làm sập toàn bộ render của layout.
            Log.Error("Áp dụng theme thất bại — giao diện vẫn hiển thị với theme mặc định.", ex);
        }
    }

    private void OnProxyStateChanged() => _ = InvokeAsync(() =>
    {
        UpdateBadge();
        StateHasChanged();
    });

    private void OnToastAdded(ToastItem item) => _ = InvokeAsync(async () =>
    {
        _toasts.Add(item);
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(4));
        _toasts.Remove(item);
        StateHasChanged();
    });

    private void OnLanguageChanged() => _ = InvokeAsync(() =>
    {
        // Badge hiển thị text của L — phải cập nhật cả text lẫn StateHasChanged
        UpdateBadge();
        StateHasChanged();
    });

    // UpdateFound bắn từ luồng nền của UpdateCheckService — marshal về UI thread
    private void OnUpdateFound(ReleaseInfo release) => _ = InvokeAsync(() =>
        Toast.Show(string.Format(L["update.available"], release.TagName)));

    // Cả 4 loại lỗi (UpdateError) đều toast kèm lý do — chi tiết đầy đủ đã vào Logs (spec §11)
    private void OnUpdateFailed(UpdateError error) => _ = InvokeAsync(() =>
    {
        var reason = error switch
        {
            UpdateError.DownloadFailed => L["update.error.download"],
            UpdateError.SnapshotFailed => L["update.error.snapshot"],
            UpdateError.InstallFailed => L["update.error.install"],
            _ => L["update.error.drain"],
        };
        Toast.Show(string.Format(L["update.failed"], reason), ToastSeverity.Error);
    });

    private void OnUpdateCancelled() => _ = InvokeAsync(() =>
        Toast.Show(L["update.cancelled"]));

    private void UpdateBadge()
    {
        // Badge dùng màu Tailwind literal — class động không được purge vì nằm sẵn trong string constant
        _badgeText = ProxyHost.IsRunning
            ? $"● {L["dashboard.status.running"]} : {ProxyHost.Port}"
            : $"○ {L["dashboard.status.stopped"]}";
        _badgeClass = ProxyHost.IsRunning
            ? "rounded-full bg-green-600 px-3 py-1 text-xs text-white"
            : "rounded-full bg-neutral-500 px-3 py-1 text-xs text-white";
    }

    private static string ToastClass(ToastSeverity severity) => severity switch
    {
        ToastSeverity.Success => "bg-green-700 text-white",
        ToastSeverity.Error => "bg-red-700 text-white",
        _ => "bg-neutral-700 text-white",
    };

    public void Dispose()
    {
        ProxyHost.StateChanged -= OnProxyStateChanged;
        Toast.ToastAdded -= OnToastAdded;
        L.LanguageChanged -= OnLanguageChanged;
        UpdateCheck.UpdateFound -= OnUpdateFound;
        Coordinator.Failed -= OnUpdateFailed;
        Coordinator.Cancelled -= OnUpdateCancelled;
    }
}
