@page "/proxies"
@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Proxies
@using RouterBalancing.Core.Providers
@implements IDisposable
@inject IProxyService ProxySvc
@inject IProviderService ProviderSvc
@inject IProxyPool ProxyPool
@inject LocalizationService L
@inject ToastService Toast
@inject ILogService Log

<div class="mb-4 flex items-center justify-between gap-3">
    <h1 class="text-xl font-semibold">@L["proxies.title"]</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenAdd">+ @L["proxies.add"]</button>
</div>

@if (_loading)
{
    <p class="text-sm opacity-70">...</p>
}
else if (_rows.Count == 0)
{
    <EmptyState Message="@L["proxies.empty"]" />
}
else
{
    <div class="overflow-x-auto rounded border border-border bg-surface">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-border text-left text-xs uppercase opacity-70">
                    <th class="px-2 py-2">@L["proxies.col.endpoint"]</th>
                    <th class="px-2 py-2">@L["proxies.col.scheme"]</th>
                    <th class="px-2 py-2">@L["proxies.col.auth"]</th>
                    <th class="px-2 py-2">@L["proxies.col.enabled"]</th>
                    <th class="px-2 py-2">@L["proxies.col.status"]</th>
                    <th class="px-2 py-2">@L["proxies.col.lastTest"]</th>
                    <th class="px-2 py-2">@L["proxies.col.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    @* @key để toggle/test không re-render cả bảng *@
                    <tr @key="row.Id" class="border-b border-border">
                        <td class="px-2 py-2 font-mono">@EndpointOf(row)</td>
                        <td class="px-2 py-2 font-mono text-xs opacity-70">@row.Scheme</td>
                        <td class="px-2 py-2">@(row.Username is null ? L["proxies.auth.none"] : "•••")</td>
                        <td class="px-2 py-2">
                            @* Toggle enable/disable theo đúng pattern Providers.razor (checkbox) *@
                            <input type="checkbox" checked="@row.Enabled" disabled="@_busy"
                                   @onchange="() => ToggleAsync(row)" />
                        </td>
                        <td class="px-2 py-2">@StatusBadge(row)</td>
                        <td class="px-2 py-2">
                            @if (row.LastTestAt is null)
                            {
                                @L["proxies.lastTest.never"]
                            }
                            else
                            {
                                @if (row.LastTestSuccess == false)
                                {
                                    @* ✗ + message — message là dữ liệu HTTP, không qua i18n *@
                                    <span class="text-danger">✗ <span class="font-mono">@row.LastTestAt.Value.ToLocalTime().ToString("g")</span></span>
                                    <div class="text-danger text-xs">@row.LastTestMessage</div>
                                }
                                else
                                {
                                    <span>✓</span>
                                    @if (!string.IsNullOrWhiteSpace(row.LastTestIp))
                                    {
                                        <span class="font-mono">@row.LastTestIp</span>
                                    }
                                    <span class="font-mono">@row.LastTestAt.Value.ToLocalTime().ToString("g")</span>
                                }
                            }
                        </td>
                        <td class="px-2 py-2">
                            <button type="button" class="btn btn-outline-secondary mr-1"
                                    disabled="@(_busy || _testingId == row.Id)"
                                    @onclick="() => TestAsync(row)">
                                @(_testingId == row.Id ? L["proxies.action.testing"] : L["proxies.action.test"])
                            </button>
                            <button type="button" class="btn btn-outline-secondary mr-1" disabled="@_busy"
                                    @onclick="() => OpenEdit(row)">@L["providers.action.edit"]</button>
                            <button type="button" class="btn btn-outline-danger" disabled="@_busy"
                                    @onclick="() => AskDelete(row)">@L["providers.action.delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Section gán proxy cho provider (spec proxy-per-provider D1–D8) *@
<div class="mt-6 rounded border border-border bg-surface p-4">
    <h2 class="text-sm font-semibold mb-3">@L["proxies.assign.title"]</h2>
    <div class="grid gap-2">
        <div class="flex flex-wrap items-center gap-2">
            <select class="rounded border border-border bg-surface px-2 py-1.5"
                    value="@_assignProviderId" @onchange="OnProviderSelected">
                <option value="">@L["proxies.assign.select_provider"]</option>
                @foreach (var p in _providers)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>

            @* Scope account (spec §7): chỉ chọn được sau khi có provider; không có account
               thì disable — không có option rỗng vô nghĩa *@
            <span class="text-xs opacity-70">@L["proxies.assign.account"]</span>
            <select class="rounded border border-border bg-surface px-2 py-1.5"
                    value="@_assignAccountId" @onchange="OnAccountSelected"
                    disabled="@(_busy || _assignProviderId is null || SelectedProviderAccounts.Count == 0)">
                <option value="">@L["proxies.assign.select_account"]</option>
                @foreach (var a in SelectedProviderAccounts)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </select>

            <span class="text-xs opacity-70">@L["proxies.assign.mode"]</span>
            <select class="rounded border border-border bg-surface px-2 py-1.5" @bind="_assignMode">
                <option value="">@L["proxies.assign.none_mode"]</option>
                <option value="rr">@L["proxies.assign.mode_rr"]</option>
                <option value="fb">@L["proxies.assign.mode_fallback"]</option>
            </select>

            <button class="btn btn-primary" @onclick="SaveAssignment"
                    disabled="@(_busy || _assignProviderId is null || _assignmentLoading)">
                @L["proxies.assign.save"]
            </button>
        </div>

        @if (_rows.Count > 0)
        {
            <div class="flex flex-col gap-1">
                @foreach (var row in _rows)
                {
                    <div class="flex items-center gap-2 text-sm">
                        <label class="flex min-w-0 flex-1 items-center gap-2">
                            <input type="checkbox" checked="@(_selectedProxyIds.Contains(row.Id))"
                                   disabled="@_busy"
                                   @onchange="() => ToggleProxySelection(row.Id)" />
                            <span class="font-mono">@EndpointOf(row)</span>
                            @if (!row.Enabled)
                            {
                                @* Hậu tố trạng thái — proxy tắt vẫn tick được, pool tự lọc (D-A2) *@
                                <span class="text-xs opacity-70">@L["proxies.assign.disabledSuffix"]</span>
                            }
                        </label>
                        @* Xem proxy đang gán cho ai (D-A6) — không thêm cột vào bảng chính *@
                        <button type="button" class="btn btn-outline-secondary px-1.5"
                                disabled="@_busy"
                                aria-expanded="@(_expandedUsageProxyId == row.Id)"
                                @onclick="() => ToggleUsageExpansion(row.Id)">
                            @(_expandedUsageProxyId == row.Id ? "▾" : "▸")
                        </button>
                    </div>
                    @if (_expandedUsageProxyId == row.Id)
                    {
                        var usages = UsagesOf(row.Id);
                        <div class="pl-6 text-xs opacity-70" data-testid="proxy-usage">
                            @(usages.Count == 0
                                ? L["proxies.assign.reverseNone"]
                                : string.Join(" · ", usages.Select(UsageLabel)))
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<Modal Visible="@(_editing is not null)"
       Title="@(_editing is { Id: 0 } ? L["proxies.form.addTitle"] : L["proxies.form.editTitle"])"
       OnClose="CloseModal">
    <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.scheme"]
            @* Tên scheme là protocol language-neutral — không qua i18n *@
            <select class="rounded border border-border bg-surface px-2 py-1.5" @bind="_scheme">
                <option value="http">http</option>
                <option value="socks5">socks5</option>
            </select>
            <span class="text-xs opacity-70">@L["proxies.schemes.hint"]</span>
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.port"]
            <input type="number" min="1" max="65535"
                   class="rounded border border-border bg-surface px-2 py-1.5"
                   disabled="@_busy" @bind="_port" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm sm:col-span-2">
            @L["proxies.field.host"]
            <input class="rounded border border-border bg-surface px-2 py-1.5"
                   spellcheck="false" disabled="@_busy" @bind="_host" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.username"]
            <input class="rounded border border-border bg-surface px-2 py-1.5"
                   autocomplete="off" disabled="@_busy" @bind="_username" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.password"]
            @* Password chỉ tồn tại lúc nhập — không bao giờ hiển thị lại (không đọc PasswordEncrypted) *@
            <input type="password" class="rounded border border-border bg-surface px-2 py-1.5"
                   autocomplete="new-password" spellcheck="false" disabled="@_busy"
                   placeholder="@PasswordPlaceholder"
                   @bind="_password" @bind:event="oninput" />
        </label>
    </div>

    @if (_formError is not null)
    {
        <div class="mt-1 text-sm text-danger">@_formError</div>
    }

    <div class="mt-4 flex justify-end gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseModal">
            @L["confirm.cancel"]
        </button>
        @* Nút Save dùng chung key i18n của Settings — cùng nghĩa, tránh nhân đôi key *@
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
            @L["settings.action.save"]
        </button>
    </div>
</Modal>

@if (_confirmDelete is { } proxyToDelete)
{
    <ConfirmDialog Visible="true"
                   Title="@L["providers.action.delete"]"
                   Message="@L["proxies.confirm.delete"]"
                   Danger="true"
                   ConfirmText="@L["providers.action.delete"]"
                   CancelText="@L["confirm.cancel"]"
                   OnConfirm="DeleteAsync"
                   OnCancel="CancelDelete" />
}

@code {
    private List<OutboundProxy> _rows = [];
    private List<ProxyRuntimeStatus> _downStatuses = [];
    private bool _loading = true;
    private bool _busy;

    // null = modal đóng; Id == 0 = đang thêm mới (edit giữ Id thật)
    private OutboundProxy? _editing;
    private long? _testingId;
    private string? _formError;
    private string _scheme = "http";
    private string _host = string.Empty;
    private int _port = 8080;
    private string _username = string.Empty;
    private string _password = string.Empty; // rỗng = giữ mật khẩu cũ khi edit
    private OutboundProxy? _confirmDelete;

    // Section gán proxy cho provider
    private List<Provider> _providers = [];
    private long? _assignProviderId;
    private long? _assignAccountId; // null = scope provider; có giá trị = override theo account (D1)
    private string? _assignMode;
    private List<long> _selectedProxyIds = [];
    // Cache toàn bộ hàng (provider + mọi account) của provider đang chọn — đổi scope không cần query lại
    private List<ProxyAssignment> _assignments = [];
    // Reverse view: proxy-id → scope đang dùng (D-A6); không có key = chưa gán ai
    private IReadOnlyDictionary<long, IReadOnlyList<ProxyUsage>> _reverseAssignments =
        new Dictionary<long, IReadOnlyList<ProxyUsage>>();
    // Race token: mỗi lần đổi scope tăng 1 — load của scope cũ về trễ bị discard (D-A3)
    private int _assignLoadToken;
    private bool _assignmentLoading;
    private long? _expandedUsageProxyId;

    /// <summary>Account của provider đang chọn — options của select account (spec §7).</summary>
    private IReadOnlyList<ProviderAccount> SelectedProviderAccounts =>
        _providers.FirstOrDefault(p => p.Id == _assignProviderId)?.Accounts is { } accounts
            ? accounts
            : [];

    /// <summary>Hàng assignment của scope đang chọn — account thắng provider khi đang chọn account (D1).</summary>
    private ProxyAssignment? SelectedScopeAssignment =>
        _assignAccountId is { } accountId
            ? _assignments.FirstOrDefault(a => !a.IsProvider && a.Id == accountId)
            : _assignments.FirstOrDefault(a => a.IsProvider);

    /// <summary>Chỉ hiện hint khi sửa — thêm mới để trống nghĩa là không đặt mật khẩu.</summary>
    private string? PasswordPlaceholder => _editing is { Id: > 0 } ? L["proxies.hint.password"] : null;

    protected override async Task OnInitializedAsync()
    {
        L.LanguageChanged += OnLanguageChanged;
        await ReloadAsync();
    }

    /// <summary>
    /// Nạp lại danh sách proxy + snapshot trạng thái pool + danh sách provider. Cột Status
    /// chỉ đọc lúc load và sau hành động (Save/Toggle/Test/Delete) — spec §6.
    /// </summary>
    private async Task ReloadAsync()
    {
        try
        {
            _rows = (await ProxySvc.ListAsync()).ToList();
            // Giữ toàn bộ snapshot để hiển thị "Down (còn Xs)" — DownUntil chỉ có ở đây.
            _downStatuses = ProxyPool.Snapshot().ToList();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _loading = false;
        }

        // Danh sách provider cho section gán proxy — best-effort, không ảnh hưởng load proxy.
        try
        {
            _providers = (await ProviderSvc.ListAsync()).ToList();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách provider.", ex);
        }

        // Reverse view (D-A6) — best-effort: lỗi không chặn load proxy chính
        try
        {
            _reverseAssignments = await ProxySvc.GetReverseAssignmentsAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách gán đảo.", ex);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Badge trạng thái: down → "Down (còn Xs)" (hoặc "Down" nếu hết cooldown); còn lại "Ready".
    /// </summary>
    private string StatusBadge(OutboundProxy row)
    {
        var status = _downStatuses.FirstOrDefault(s => s.Id == row.Id);
        if (status is not { IsDown: true })
        {
            return L["proxies.status.ok"];
        }

        if (status.DownUntil is not { } until)
        {
            return L["proxies.status.down"];
        }

        var remaining = (int)Math.Max(0, (until - DateTimeOffset.UtcNow).TotalSeconds);
        return $"{L["proxies.status.down"]} ({string.Format(L["proxies.status.downUntil"], remaining)})";
    }

    private static string EndpointOf(OutboundProxy row) =>
        $"{row.Scheme}://{row.Host}:{row.Port}";

    private void OpenAdd()
    {
        if (_busy) return;
        _editing = new OutboundProxy();
        _scheme = "http";
        _host = string.Empty;
        _port = 8080;
        _username = string.Empty;
        _password = string.Empty;
        _formError = null;
    }

    private void OpenEdit(OutboundProxy row)
    {
        if (_busy) return;
        _editing = row;
        _scheme = row.Scheme;
        _host = row.Host;
        _port = row.Port;
        _username = row.Username ?? string.Empty;
        _password = string.Empty; // để trống = giữ mật khẩu cũ
        _formError = null;
    }

    private void CloseModal()
    {
        _editing = null;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        // Single-flight — double-click vẫn tới được đây khi nút chưa re-render
        if (_busy || _editing is not { } target) return;

        var draft = new ProxyDraft
        {
            Scheme = _scheme,
            Host = _host,
            Port = _port,
            Username = _username,
            Password = string.IsNullOrEmpty(_password) ? null : _password,
        };

        // Validate chung với service (ProxyValidator) — không nhân bản rule trong Razor
        var errors = ProxyValidator.Validate(draft);
        if (errors.Count > 0)
        {
            _formError = string.Join(" ", errors.Values.Distinct().Select(k => L[k]));
            return;
        }

        _busy = true;
        try
        {
            if (target.Id == 0)
            {
                await ProxySvc.CreateAsync(draft);
            }
            else
            {
                await ProxySvc.UpdateAsync(target.Id, draft);
            }

            Toast.Show(L["proxies.msg.saved"], ToastSeverity.Success);
            CloseModal();
            await ReloadAsync();
        }
        catch (ProxyValidationException ex)
        {
            // Duplicate endpoint do server bắt (cần DB) — map key i18n đã gán sẵn
            _formError = string.Join(" ", ex.Errors.Values.Distinct().Select(k => L[k]));
        }
        catch (Exception ex)
        {
            Log.Error("Không lưu được proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAsync(OutboundProxy row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await ProxySvc.SetEnabledAsync(row.Id, !row.Enabled);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không đổi được trạng thái proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync(OutboundProxy row)
    {
        // Single-flight: _testingId chỉ có một slot — test song song sẽ xóa nhãn của nhau
        if (_busy) return;
        _busy = true;
        _testingId = row.Id;
        try
        {
            var result = await ProxySvc.TestAsync(row.Id, CancellationToken.None);
            if (!result.Success)
            {
                // Lỗi chi tiết đã persist và hiện trong cột Last test — toast chỉ báo chung
                Toast.Show(L["proxies.msg.testFailed"], ToastSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Log.Error("Test proxy thất bại từ danh sách.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _testingId = null;
            _busy = false;
            await ReloadAsync();
        }
    }

    private void AskDelete(OutboundProxy row)
    {
        if (_busy) return;
        _confirmDelete = row;
    }

    private void CancelDelete() => _confirmDelete = null;

    private async Task DeleteAsync()
    {
        if (_busy || _confirmDelete is not { } proxy) return;

        _busy = true;
        try
        {
            await ProxySvc.DeleteAsync(proxy.Id);
            Toast.Show(L["proxies.msg.deleted"], ToastSeverity.Success);
            CancelDelete();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không xóa được proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Pre-fill form gán proxy khi đổi provider — đọc assignment hiện có (D1–D8):
    /// cache cả tập provider lẫn account rồi đổ vào form theo scope đang chọn.
    /// Token: load của scope cũ về trễ bị discard, không áp dữ liệu lên scope mới (D-A3).
    /// </summary>
    private async Task LoadAssignmentAsync(int loadToken)
    {
        _assignmentLoading = true;
        try
        {
            if (_assignProviderId is null)
            {
                if (loadToken != _assignLoadToken) return;
                _assignments = [];
                ApplyScopeToForm();
                StateHasChanged();
                return;
            }

            List<ProxyAssignment> assignments;
            try
            {
                // GetAssignmentsAsync trả về hàng provider + mọi account của provider —
                // 1 query duy nhất cho cả 2 scope, đổi scope account không tốn query thêm.
                assignments = (await ProxySvc.GetAssignmentsAsync(_assignProviderId.Value)).ToList();
            }
            catch (Exception ex)
            {
                assignments = [];
                Log.Error("Không tải được gán proxy cho provider.", ex);
                Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
            }

            // Load cũ (token lệch) KHÔNG được áp dữ liệu lên scope mới (D-A3)
            if (loadToken != _assignLoadToken) return;
            _assignments = assignments;
            ApplyScopeToForm();
            StateHasChanged();
        }
        finally
        {
            // Chỉ owner của token hiện tại mới hạ cờ — load mồ côi không đụng trạng thái mới
            if (loadToken == _assignLoadToken)
                _assignmentLoading = false;
        }
    }

    /// <summary>Đổ gán của scope đang chọn (checkbox + mode) vào form — account thắng provider (D1).</summary>
    private void ApplyScopeToForm()
    {
        var scope = SelectedScopeAssignment;
        if (scope is null)
        {
            _selectedProxyIds = [];
            _assignMode = string.Empty;
            return;
        }

        _selectedProxyIds = scope.ProxyIds.ToList();
        _assignMode = scope.Mode switch
        {
            ProxyMode.RoundRobin => "rr",
            ProxyMode.Fallback => "fb",
            _ => string.Empty
        };
    }

    /// <summary>Các scope đang dùng proxy — thiếu key = chưa gán ai (D-A6).</summary>
    private IReadOnlyList<ProxyUsage> UsagesOf(long proxyId) =>
        _reverseAssignments.TryGetValue(proxyId, out var usages) ? usages : [];

    /// <summary>Dòng mô tả 1 scope: "Provider OpenAI (rr)" / "Tài khoản acc-1 (fb)".</summary>
    private string UsageLabel(ProxyUsage usage)
    {
        var scope = L[usage.IsProvider ? "proxies.assign.scopeProvider" : "proxies.assign.scopeAccount"];
        var mode = usage.Mode switch
        {
            ProxyMode.RoundRobin => " (rr)",
            ProxyMode.Fallback => " (fb)",
            _ => string.Empty,
        };
        return $"{scope} {usage.ScopeName}{mode}";
    }

    private void ToggleUsageExpansion(long proxyId)
    {
        _expandedUsageProxyId = _expandedUsageProxyId == proxyId ? null : proxyId;
        StateHasChanged();
    }

    private void OnProviderSelected(ChangeEventArgs e)
    {
        _assignProviderId = long.TryParse(e.Value?.ToString(), out var id) && id > 0
            ? id
            : null;
        // Đổi provider phải về scope provider — giữ account cũ sẽ map nhầm id sang provider khác
        _assignAccountId = null;
        // Tăng token trước khi start: load của scope trước (nếu còn chạy) sẽ bị discard (D-A3)
        _ = LoadAssignmentAsync(++_assignLoadToken);
    }

    private void OnAccountSelected(ChangeEventArgs e)
    {
        _assignAccountId = long.TryParse(e.Value?.ToString(), out var id) && id > 0
            ? id
            : null;
        // Đã cache assignment của provider này khi chọn provider — chỉ đổi scope, không query lại
        ApplyScopeToForm();
        StateHasChanged();
    }

    private void ToggleProxySelection(long id)
    {
        if (_selectedProxyIds.Contains(id))
        {
            _selectedProxyIds.Remove(id);
        }
        else
        {
            _selectedProxyIds.Add(id);
        }
        // Blazor không tự re-render khi handler chỉ mutate danh sách trong chỗ
        // (reference _selectedProxyIds không đổi) — ép render để checkbox cập nhật lại.
        StateHasChanged();
    }

    /// <summary>Gán proxy cho scope đang chọn (D1–D8) — single-flight qua _busy.</summary>
    private async Task SaveAssignment()
    {
        if (_busy || _assignProviderId is null || _assignmentLoading) return;

        _busy = true;
        try
        {
            var mode = _assignMode switch
            {
                "rr" => ProxyMode.RoundRobin,
                "fb" => ProxyMode.Fallback,
                _ => (ProxyMode?)null
            };

            // Chọn account = ghi hàng override của account; không chọn = ghi hàng provider.
            // Toast đúng scope: gán cho account mà vẫn báo "provider" gây hiểu nhầm.
            string toastKey;
            if (_assignAccountId is { } accountId)
            {
                await ProxySvc.AssignAccountProxiesAsync(accountId, _selectedProxyIds, mode);
                toastKey = "proxies.assign.message_account";
            }
            else
            {
                await ProxySvc.AssignProviderProxiesAsync(_assignProviderId.Value, _selectedProxyIds, mode);
                toastKey = "proxies.assign.message";
            }

            Toast.Show(L[toastKey], ToastSeverity.Success);
            await ReloadAsync();
            // Ghi xong → nạp lại theo token mới để form phản ánh đúng DB (và bỏ loading cũ)
            await LoadAssignmentAsync(++_assignLoadToken);
        }
        catch (KeyNotFoundException ex)
        {
            // Proxy/provider bị xoá ở nơi khác giữa lúc load và lúc save — toast riêng (D-A4)
            Log.Error("Không gán được proxy cho scope đang chọn.", ex);
            Toast.Show(L["proxies.assign.error.scopeNotFound"], ToastSeverity.Error);
        }
        catch (Exception ex)
        {
            Log.Error("Không gán được proxy cho scope đang chọn.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}
