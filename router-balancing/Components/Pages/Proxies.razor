@page "/proxies"
@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Proxies
@using RouterBalancing.Core.Providers
@implements IDisposable
@inject IProxyService ProxySvc
@inject IProviderService ProviderSvc
@inject IProxyPool ProxyPool
@inject LocalizationService L
@inject ToastService Toast
@inject ILogService Log

<div class="mb-4 flex items-center justify-between gap-3">
    <h1 class="text-xl font-semibold">@L["proxies.title"]</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenAdd">+ @L["proxies.add"]</button>
</div>

@if (_loading)
{
    <p class="text-sm opacity-70">...</p>
}
else if (_rows.Count == 0)
{
    <EmptyState Message="@L["proxies.empty"]" />
}
else
{
    <div class="overflow-x-auto rounded border border-border bg-surface">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-border text-left text-xs uppercase opacity-70">
                    <th class="px-2 py-2">@L["proxies.col.endpoint"]</th>
                    <th class="px-2 py-2">@L["proxies.col.scheme"]</th>
                    <th class="px-2 py-2">@L["proxies.col.auth"]</th>
                    <th class="px-2 py-2">@L["proxies.col.enabled"]</th>
                    <th class="px-2 py-2">@L["proxies.col.status"]</th>
                    <th class="px-2 py-2">@L["proxies.col.lastTest"]</th>
                    <th class="px-2 py-2">@L["proxies.col.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    @* @key để toggle/test không re-render cả bảng *@
                    <tr @key="row.Id" class="border-b border-border">
                        <td class="px-2 py-2 font-mono">@EndpointOf(row)</td>
                        <td class="px-2 py-2 font-mono text-xs opacity-70">@row.Scheme</td>
                        <td class="px-2 py-2">@(row.Username is null ? L["proxies.auth.none"] : "•••")</td>
                        <td class="px-2 py-2">
                            @* Toggle enable/disable theo đúng pattern Providers.razor (checkbox) *@
                            <input type="checkbox" checked="@row.Enabled" disabled="@_busy"
                                   @onchange="() => ToggleAsync(row)" />
                        </td>
                        <td class="px-2 py-2">@StatusBadge(row)</td>
                        <td class="px-2 py-2">
                            @if (row.LastTestAt is null)
                            {
                                @L["proxies.lastTest.never"]
                            }
                            else
                            {
                                @if (row.LastTestSuccess == false)
                                {
                                    @* ✗ + message — message là dữ liệu HTTP, không qua i18n *@
                                    <span class="text-danger">✗ <span class="font-mono">@row.LastTestAt.Value.ToLocalTime().ToString("g")</span></span>
                                    <div class="text-danger text-xs">@row.LastTestMessage</div>
                                }
                                else
                                {
                                    <span>✓</span>
                                    @if (!string.IsNullOrWhiteSpace(row.LastTestIp))
                                    {
                                        <span class="font-mono">@row.LastTestIp</span>
                                    }
                                    <span class="font-mono">@row.LastTestAt.Value.ToLocalTime().ToString("g")</span>
                                }
                            }
                        </td>
                        <td class="px-2 py-2">
                            <button type="button" class="btn btn-outline-secondary mr-1"
                                    disabled="@(_busy || _testingId == row.Id)"
                                    @onclick="() => TestAsync(row)">
                                @(_testingId == row.Id ? L["proxies.action.testing"] : L["proxies.action.test"])
                            </button>
                            <button type="button" class="btn btn-outline-secondary mr-1" disabled="@_busy"
                                    @onclick="() => OpenEdit(row)">@L["providers.action.edit"]</button>
                            <button type="button" class="btn btn-outline-danger" disabled="@_busy"
                                    @onclick="() => AskDelete(row)">@L["providers.action.delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Cây reverse view: Proxy → Provider → AC — thay danh sách checkbox phẳng (D-A6, phương án B).
   <details> thuần: expand/collapse do browser giữ DOM state, Blazor không re-render mất trạng thái. *@
<style>
    .proxy-tree { display: flex; flex-direction: column; gap: 2px; font-size: 0.875rem; }
    .proxy-tree .pt-node { margin-left: 18px; }
    .proxy-tree > .pt-node { margin-left: 0; }
    .pt-summary {
        display: flex; align-items: center; gap: 8px; cursor: pointer;
        padding: 6px 8px; border-radius: 4px; list-style: none; user-select: none;
    }
    .pt-summary::-webkit-details-marker { display: none; }
    .pt-summary:hover { background: var(--background); }
    .pt-chev { width: 12px; flex: none; opacity: 0.5; }
    .pt-chev::before { content: "▸"; }
    details[open] > .pt-summary .pt-chev::before { content: "▾"; }
    /* meta chứa "N AC" + nút ✎ — margin-left:auto đẩy cụm phải, 2 auto sẽ chia khoảng trống */
    .pt-meta {
        margin-left: auto; display: flex; align-items: center; gap: 8px;
        font-size: 11px; opacity: 0.75; white-space: nowrap;
    }
    .pt-badge {
        font-size: 10px; border: 1px solid var(--border); border-radius: 999px;
        padding: 1px 7px; text-transform: uppercase; white-space: nowrap;
    }
    .pt-badge-dashed { border-style: dashed; }
    .pt-leaf { display: flex; align-items: center; gap: 8px; padding: 5px 8px 5px 36px; border-radius: 4px; }
    .pt-leaf:hover { background: var(--background); }
    .pt-tick { width: 12px; flex: none; color: var(--color-success); }
    .pt-tick-off { opacity: 0.35; }
    .pt-empty { padding: 6px 8px 6px 30px; font-size: 12px; font-style: italic; opacity: 0.5; }
    .pt-edit {
        border: 0; background: transparent; cursor: pointer; border-radius: 4px;
        padding: 0 4px; font-size: 12px; line-height: 1.4; opacity: 0.6;
    }
    .pt-edit:hover { opacity: 1; background: var(--background); }
    .pt-edit:disabled { opacity: 0.25; cursor: not-allowed; background: transparent; }
    .pt-add {
        display: inline-flex; align-items: center; gap: 6px; margin: 6px 0 2px 24px;
        padding: 3px 10px; font-size: 12px; border: 1px dashed var(--border);
        border-radius: 6px; background: transparent; color: var(--color-primary); cursor: pointer;
    }
    .pt-add:hover { border-color: var(--color-primary); background: var(--background); }
    .pt-add:disabled { opacity: 0.5; cursor: not-allowed; }
    .pt-panel {
        margin: 4px 0 6px 24px; padding: 8px; border: 1px solid var(--border);
        border-radius: 6px; background: var(--background);
    }
</style>

<div class="mt-6 rounded border border-border bg-surface p-4">
    <h2 class="text-sm font-semibold mb-3">@L["proxies.assign.title"]</h2>

    <div class="proxy-tree">
        @foreach (var node in Tree)
        {
            <details @key="node.Proxy.Id" class="pt-node">
                <summary class="pt-summary">
                    <span class="pt-chev"></span>
                    <span class="font-mono">@EndpointOf(node.Proxy)</span>
                    @if (!node.Proxy.Enabled)
                    {
                        @* Proxy tắt vẫn gán được — pool tự lọc (D-A2) *@
                        <span class="pt-badge">@L["proxies.assign.disabledSuffix"]</span>
                    }
                    <span class="pt-meta">
                        @(node.Usages.Count == 0
                            ? L["proxies.assign.reverseNone"]
                            : string.Format(L["proxies.assign.scopeCount"], node.Usages.Count))
                    </span>
                </summary>

                @if (node.Providers.Count == 0)
                {
                    <div class="pt-empty">@L["proxies.assign.reverseNone"]</div>
                }

                @foreach (var providerNode in node.Providers)
                {
                    <details @key="providerNode.Provider.Id" class="pt-node">
                        <summary class="pt-summary">
                            <span class="pt-chev"></span>
                            <span>@L["proxies.assign.scopeProvider"] <b>@providerNode.Provider.Name</b></span>
                            @if (providerNode.ProviderUsage is { } providerUsage)
                            {
                                @* Mode HIỆU LỰC: null ≡ RoundRobin (D6) — hiển thị khớp badge trang Providers *@
                                <span class="pt-badge">@ModeShort(providerUsage.Mode ?? ProxyMode.RoundRobin)</span>
                            }
                            @if (providerNode.IsAccountOnly)
                            {
                                <span class="pt-badge pt-badge-dashed">@L["proxies.assign.accountOnly"]</span>
                            }
                            <span class="pt-meta">
                                @string.Format(L["proxies.assign.accountCount"], providerNode.AssignedAccountCount)
                                @if (providerNode.Accounts.Any(a => a.Override is not null))
                                {
                                    @* Bulk reset: xóa hàng override của mọi AC — hiện khi node có AC override *@
                                    <button type="button" class="pt-edit" disabled="@_busy"
                                            title="@L["proxies.assign.resetOverrides"]"
                                            aria-label="@L["proxies.assign.resetOverrides"]"
                                            @onclick="() => _confirmResetProvider = providerNode"
                                            @onclick:preventDefault="true" @onclick:stopPropagation="true">↺</button>
                                }
                                @* preventDefault: ✎ nằm trong <summary> — không chặn thì bấm sửa sẽ collapse node *@
                                <button type="button" class="pt-edit" disabled="@_busy"
                                        title="@L["proxies.assign.edit"]" aria-label="@L["proxies.assign.edit"]"
                                        @onclick="() => OpenEditScope(EditProviderKey(providerNode.Provider.Id))"
                                        @onclick:preventDefault="true" @onclick:stopPropagation="true">✎</button>
                            </span>
                        </summary>

                        @foreach (var accountNode in providerNode.Accounts)
                        {
                            <div @key="accountNode.Account.Id" class="pt-leaf">
                                <span class="@(accountNode.Assigned ? "pt-tick" : "pt-tick pt-tick-off")">@(accountNode.Assigned ? "✓" : "○")</span>
                                <span class="font-mono">@accountNode.Account.Name</span>
                                <span class="pt-meta">
                                    @if (accountNode.Override is { } overrideUsage)
                                    {
                                        <span class="pt-badge">@OverrideLabel(overrideUsage.Mode)</span>
                                    }
                                    else if (accountNode.Assigned)
                                    {
                                        <span class="pt-badge pt-badge-dashed">@InheritLabel(providerNode.ProviderUsage?.Mode)</span>
                                    }
                                    else
                                    {
                                        <span>@L["proxies.assign.noneForProxy"]</span>
                                    }
                                    <button type="button" class="pt-edit" disabled="@_busy"
                                            title="@L["proxies.assign.edit"]" aria-label="@L["proxies.assign.edit"]"
                                            @onclick="() => OpenEditScope(EditAccountKey(accountNode.Account.Id))">✎</button>
                                </span>
                            </div>

                            @if (IsEditOpen(EditAccountKey(accountNode.Account.Id)))
                            {
                                <ScopeProxyEditor @key="@($"a:{accountNode.Account.Id}")"
                                                  ProviderId="@providerNode.Provider.Id"
                                                  AccountId="@accountNode.Account.Id"
                                                  ScopeLabel="@($"{L["proxies.assign.scopeAccount"]} {accountNode.Account.Name}")"
                                                  AllProxies="_rows"
                                                  OnSaved="OnScopeSaved"
                                                  OnCancel="ClosePanel" />
                            }
                        }

                        @if (IsEditOpen(EditProviderKey(providerNode.Provider.Id)))
                        {
                            <ScopeProxyEditor @key="@($"p:{providerNode.Provider.Id}")"
                                              ProviderId="@providerNode.Provider.Id"
                                              AccountId="@(null)"
                                              ScopeLabel="@($"{L["proxies.assign.scopeProvider"]} {providerNode.Provider.Name}")"
                                              AllProxies="_rows"
                                              OnSaved="OnScopeSaved"
                                              OnCancel="ClosePanel" />
                        }
                    </details>
                }

                <button type="button" class="pt-add" disabled="@_busy"
                        @onclick="() => ToggleAddPanel(node.Proxy.Id)">
                    + @L["proxies.assign.add"]
                </button>

                @if (_addProxyId == node.Proxy.Id)
                {
                    @* Key có prefix "add:" — proxy.Id là long trùng giá trị với provider.Id (long)
                       của node <details> cùng parent → duplicate @key làm diff Blazor ném
                       "Attempting to return wrong pooled instance" *@
                    <AssignProxyToScope @key="@($"add:{node.Proxy.Id}")"
                                        ProxyId="node.Proxy.Id"
                                        Providers="_providers"
                                        OnSaved="OnScopeSaved"
                                        OnCancel="ClosePanel" />
                }
            </details>
        }
    </div>
</div>

<Modal Visible="@(_editing is not null)"
       Title="@(_editing is { Id: 0 } ? L["proxies.form.addTitle"] : L["proxies.form.editTitle"])"
       OnClose="CloseModal">
    <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.scheme"]
            @* Tên scheme là protocol language-neutral — không qua i18n *@
            <select class="rounded border border-border bg-surface px-2 py-1.5" @bind="_scheme">
                <option value="http">http</option>
                <option value="socks5">socks5</option>
            </select>
            <span class="text-xs opacity-70">@L["proxies.schemes.hint"]</span>
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.port"]
            <input type="number" min="1" max="65535"
                   class="rounded border border-border bg-surface px-2 py-1.5"
                   disabled="@_busy" @bind="_port" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm sm:col-span-2">
            @L["proxies.field.host"]
            <input class="rounded border border-border bg-surface px-2 py-1.5"
                   spellcheck="false" disabled="@_busy" @bind="_host" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.username"]
            <input class="rounded border border-border bg-surface px-2 py-1.5"
                   autocomplete="off" disabled="@_busy" @bind="_username" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.password"]
            @* Password chỉ tồn tại lúc nhập — không bao giờ hiển thị lại (không đọc PasswordEncrypted) *@
            <input type="password" class="rounded border border-border bg-surface px-2 py-1.5"
                   autocomplete="new-password" spellcheck="false" disabled="@_busy"
                   placeholder="@PasswordPlaceholder"
                   @bind="_password" @bind:event="oninput" />
        </label>
    </div>

    @if (_formError is not null)
    {
        <div class="mt-1 text-sm text-danger">@_formError</div>
    }

    <div class="mt-4 flex justify-end gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseModal">
            @L["confirm.cancel"]
        </button>
        @* Nút Save dùng chung key i18n của Settings — cùng nghĩa, tránh nhân đôi key *@
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
            @L["settings.action.save"]
        </button>
    </div>
</Modal>

@if (_confirmDelete is { } proxyToDelete)
{
    <ConfirmDialog Visible="true"
                   Title="@L["providers.action.delete"]"
                   Message="@L["proxies.confirm.delete"]"
                   Danger="true"
                   ConfirmText="@L["providers.action.delete"]"
                   CancelText="@L["confirm.cancel"]"
                   OnConfirm="DeleteAsync"
                   OnCancel="CancelDelete" />
}

@if (_confirmResetProvider is { } resetNode)
{
    <ConfirmDialog Visible="true"
                   Title="@L["proxies.assign.resetOverrides"]"
                   Message="@string.Format(L["proxies.assign.resetOverridesConfirm"],
                              resetNode.Accounts.Count(a => a.Override is not null))"
                   Danger="true"
                   ConfirmText="@L["proxies.assign.resetOverrides"]"
                   CancelText="@L["confirm.cancel"]"
                   OnConfirm="ResetProviderOverridesAsync"
                   OnCancel="CancelResetOverrides" />
}

@code {
    private List<OutboundProxy> _rows = [];
    private List<ProxyRuntimeStatus> _downStatuses = [];
    private bool _loading = true;
    private bool _busy;

    // null = modal đóng; Id == 0 = đang thêm mới (edit giữ Id thật)
    private OutboundProxy? _editing;
    private long? _testingId;
    private string? _formError;
    private string _scheme = "http";
    private string _host = string.Empty;
    private int _port = 8080;
    private string _username = string.Empty;
    private string _password = string.Empty; // rỗng = giữ mật khẩu cũ khi edit
    private OutboundProxy? _confirmDelete;
    // Node provider đang xác nhận bulk reset override (null = không có dialog nào mở)
    private ProxyTreeProviderNode? _confirmResetProvider;

    // Section gán proxy — cây reverse view Proxy → Provider → AC (D-A6, phương án B)
    private List<Provider> _providers = [];
    // Reverse view: proxy-id → scope đang dùng; không có key = chưa gán ai
    private IReadOnlyDictionary<long, IReadOnlyList<ProxyUsage>> _reverseAssignments =
        new Dictionary<long, IReadOnlyList<ProxyUsage>>();
    // Mọi hàng override của AC — cây dùng để phân biệt "chưa override" vs "override ngoài tập" (D1)
    private IReadOnlyList<ProxyAssignment> _accountOverrides = [];
    // Panel đang mở — "p:{providerId}" = sửa scope provider, "a:{accountId}" = sửa override;
    // null = đóng. Chỉ 1 panel tại một thời điểm; form Gán giữ _addProxyId riêng.
    private string? _editKey;
    private long? _addProxyId;

    /// <summary>Cây hiển thị cho UI — dựng từ _rows + _providers + reverse view, tính lại mỗi render.</summary>
    private IReadOnlyList<ProxyTreeNode> Tree =>
        ProxyAssignmentTree.Build(_rows, _providers, _reverseAssignments, _accountOverrides);

    /// <summary>Chỉ hiện hint khi sửa — thêm mới để trống nghĩa là không đặt mật khẩu.</summary>
    private string? PasswordPlaceholder => _editing is { Id: > 0 } ? L["proxies.hint.password"] : null;

    protected override async Task OnInitializedAsync()
    {
        L.LanguageChanged += OnLanguageChanged;
        await ReloadAsync();
    }

    /// <summary>
    /// Nạp lại danh sách proxy + snapshot trạng thái pool + danh sách provider. Cột Status
    /// chỉ đọc lúc load và sau hành động (Save/Toggle/Test/Delete) — spec §6.
    /// </summary>
    private async Task ReloadAsync()
    {
        try
        {
            _rows = (await ProxySvc.ListAsync()).ToList();
            // Giữ toàn bộ snapshot để hiển thị "Down (còn Xs)" — DownUntil chỉ có ở đây.
            _downStatuses = ProxyPool.Snapshot().ToList();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _loading = false;
        }

        // Danh sách provider cho section gán proxy — best-effort, không ảnh hưởng load proxy.
        try
        {
            _providers = (await ProviderSvc.ListAsync()).ToList();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách provider.", ex);
        }

        // Reverse view (D-A6) + override rows (D1) — best-effort: lỗi không chặn load proxy chính
        try
        {
            var reverseTask = ProxySvc.GetReverseAssignmentsAsync();
            var overridesTask = ProxySvc.GetAccountOverridesAsync();
            await Task.WhenAll(reverseTask, overridesTask);
            _reverseAssignments = await reverseTask;
            _accountOverrides = await overridesTask;
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách gán đảo.", ex);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Badge trạng thái: down → "Down (còn Xs)" (hoặc "Down" nếu hết cooldown); còn lại "Ready".
    /// </summary>
    private string StatusBadge(OutboundProxy row)
    {
        var status = _downStatuses.FirstOrDefault(s => s.Id == row.Id);
        if (status is not { IsDown: true })
        {
            return L["proxies.status.ok"];
        }

        if (status.DownUntil is not { } until)
        {
            return L["proxies.status.down"];
        }

        var remaining = (int)Math.Max(0, (until - DateTimeOffset.UtcNow).TotalSeconds);
        return $"{L["proxies.status.down"]} ({string.Format(L["proxies.status.downUntil"], remaining)})";
    }

    private static string EndpointOf(OutboundProxy row) =>
        $"{row.Scheme}://{row.Host}:{row.Port}";

    private void OpenAdd()
    {
        if (_busy) return;
        _editing = new OutboundProxy();
        _scheme = "http";
        _host = string.Empty;
        _port = 8080;
        _username = string.Empty;
        _password = string.Empty;
        _formError = null;
    }

    private void OpenEdit(OutboundProxy row)
    {
        if (_busy) return;
        _editing = row;
        _scheme = row.Scheme;
        _host = row.Host;
        _port = row.Port;
        _username = row.Username ?? string.Empty;
        _password = string.Empty; // để trống = giữ mật khẩu cũ
        _formError = null;
    }

    private void CloseModal()
    {
        _editing = null;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        // Single-flight — double-click vẫn tới được đây khi nút chưa re-render
        if (_busy || _editing is not { } target) return;

        var draft = new ProxyDraft
        {
            Scheme = _scheme,
            Host = _host,
            Port = _port,
            Username = _username,
            Password = string.IsNullOrEmpty(_password) ? null : _password,
        };

        // Validate chung với service (ProxyValidator) — không nhân bản rule trong Razor
        var errors = ProxyValidator.Validate(draft);
        if (errors.Count > 0)
        {
            _formError = string.Join(" ", errors.Values.Distinct().Select(k => L[k]));
            return;
        }

        _busy = true;
        try
        {
            if (target.Id == 0)
            {
                await ProxySvc.CreateAsync(draft);
            }
            else
            {
                await ProxySvc.UpdateAsync(target.Id, draft);
            }

            Toast.Show(L["proxies.msg.saved"], ToastSeverity.Success);
            CloseModal();
            await ReloadAsync();
        }
        catch (ProxyValidationException ex)
        {
            // Duplicate endpoint do server bắt (cần DB) — map key i18n đã gán sẵn
            _formError = string.Join(" ", ex.Errors.Values.Distinct().Select(k => L[k]));
        }
        catch (Exception ex)
        {
            Log.Error("Không lưu được proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAsync(OutboundProxy row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await ProxySvc.SetEnabledAsync(row.Id, !row.Enabled);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không đổi được trạng thái proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync(OutboundProxy row)
    {
        // Single-flight: _testingId chỉ có một slot — test song song sẽ xóa nhãn của nhau
        if (_busy) return;
        _busy = true;
        _testingId = row.Id;
        try
        {
            var result = await ProxySvc.TestAsync(row.Id, CancellationToken.None);
            if (!result.Success)
            {
                // Lỗi chi tiết đã persist và hiện trong cột Last test — toast chỉ báo chung
                Toast.Show(L["proxies.msg.testFailed"], ToastSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Log.Error("Test proxy thất bại từ danh sách.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _testingId = null;
            _busy = false;
            await ReloadAsync();
        }
    }

    private void AskDelete(OutboundProxy row)
    {
        if (_busy) return;
        _confirmDelete = row;
    }

    private void CancelDelete() => _confirmDelete = null;

    private async Task DeleteAsync()
    {
        if (_busy || _confirmDelete is not { } proxy) return;

        _busy = true;
        try
        {
            await ProxySvc.DeleteAsync(proxy.Id);
            Toast.Show(L["proxies.msg.deleted"], ToastSeverity.Success);
            CancelDelete();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không xóa được proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Xóa toàn bộ hàng override của provider đã xác nhận — mọi AC quay về kế thừa (bulk).</summary>
    private async Task ResetProviderOverridesAsync()
    {
        if (_busy || _confirmResetProvider is not { } node) return;
        _busy = true;
        try
        {
            var count = await ProxySvc.ResetAccountOverridesAsync(node.Provider.Id);
            _confirmResetProvider = null;
            Toast.Show(
                string.Format(L["proxies.assign.resetOverridesDone"], count), ToastSeverity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không đưa được các AC về kế thừa.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelResetOverrides() => _confirmResetProvider = null;

    private static string EditProviderKey(long providerId) => $"p:{providerId}";

    private static string EditAccountKey(long accountId) => $"a:{accountId}";

    private bool IsEditOpen(string key) => _editKey == key;

    /// <summary>Mở panel ✎ cho scope — đóng form Gán để chỉ 1 panel active (D-A3 không cần ở đây: mỗi panel tự nạp khi mount).</summary>
    private void OpenEditScope(string key)
    {
        if (_busy) return;
        _addProxyId = null;
        _editKey = key;
        StateHasChanged();
    }

    /// <summary>Mở/đóng form "+ Gán provider" dưới proxy — đóng panel ✎ đang mở.</summary>
    private void ToggleAddPanel(long proxyId)
    {
        if (_busy) return;
        _editKey = null;
        _addProxyId = _addProxyId == proxyId ? null : proxyId;
        StateHasChanged();
    }

    private void ClosePanel()
    {
        _editKey = null;
        _addProxyId = null;
        StateHasChanged();
    }

    /// <summary>Lưu xong từ panel con: đóng panel + nạp lại cây để badge reverse view phản ánh DB.</summary>
    private async Task OnScopeSaved()
    {
        ClosePanel();
        await ReloadAsync();
    }

    /// <summary>Badge mode ngắn "rr"/"fb" — ngôn ngữ kỹ thuật, không qua i18n.</summary>
    private static string ModeShort(ProxyMode? mode) => mode switch
    {
        ProxyMode.RoundRobin => "rr",
        ProxyMode.Fallback => "fb",
        _ => string.Empty,
    };

    /// <summary>Nhãn AC override: "fb override"; mode null (tập override không đổi mode) chỉ còn "override".</summary>
    private string OverrideLabel(ProxyMode? mode)
    {
        var shortMode = ModeShort(mode);
        return string.IsNullOrEmpty(shortMode)
            ? L["proxies.assign.override"]
            : $"{shortMode} {L["proxies.assign.override"]}";
    }

    /// <summary>Nhãn AC kế thừa từ hàng provider: "kế thừa rr" (null ≡ RR — D6).</summary>
    private string InheritLabel(ProxyMode? mode)
    {
        var shortMode = ModeShort(mode ?? ProxyMode.RoundRobin);
        return $"{L["proxies.assign.inherit"]} {shortMode}";
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}
