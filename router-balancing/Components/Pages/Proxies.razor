@page "/proxies"
@using RouterBalancing.Core.Domain
@using RouterBalancing.Core.Proxies
@using RouterBalancing.Core.Providers
@implements IDisposable
@inject IProxyService ProxySvc
@inject IProviderService ProviderSvc
@inject IProxyPool ProxyPool
@inject LocalizationService L
@inject ToastService Toast
@inject ILogService Log

<div class="mb-4 flex items-center justify-between gap-3">
    <h1 class="text-xl font-semibold">@L["proxies.title"]</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenAdd">+ @L["proxies.add"]</button>
</div>

@if (_loading)
{
    <p class="text-sm opacity-70">...</p>
}
else if (_rows.Count == 0)
{
    <EmptyState Message="@L["proxies.empty"]" />
}
else
{
    <div class="overflow-x-auto rounded border border-border bg-surface">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-border text-left text-xs uppercase opacity-70">
                    <th class="px-2 py-2">@L["proxies.col.endpoint"]</th>
                    <th class="px-2 py-2">@L["proxies.col.scheme"]</th>
                    <th class="px-2 py-2">@L["proxies.col.auth"]</th>
                    <th class="px-2 py-2">@L["proxies.col.enabled"]</th>
                    <th class="px-2 py-2">@L["proxies.col.status"]</th>
                    <th class="px-2 py-2">@L["proxies.col.lastTest"]</th>
                    <th class="px-2 py-2">@L["proxies.col.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    @* @key để toggle/test không re-render cả bảng *@
                    <tr @key="row.Id" class="border-b border-border">
                        <td class="px-2 py-2 font-mono">@EndpointOf(row)</td>
                        <td class="px-2 py-2 font-mono text-xs opacity-70">@row.Scheme</td>
                        <td class="px-2 py-2">@(row.Username is null ? L["proxies.auth.none"] : "•••")</td>
                        <td class="px-2 py-2">
                            @* Toggle enable/disable theo đúng pattern Providers.razor (checkbox) *@
                            <input type="checkbox" checked="@row.Enabled" disabled="@_busy"
                                   @onchange="() => ToggleAsync(row)" />
                        </td>
                        <td class="px-2 py-2">@StatusBadge(row)</td>
                        <td class="px-2 py-2">
                            @if (row.LastTestAt is null)
                            {
                                @L["proxies.lastTest.never"]
                            }
                            else
                            {
                                @if (row.LastTestSuccess == false)
                                {
                                    @* ✗ + message — message là dữ liệu HTTP, không qua i18n *@
                                    <span class="text-danger">✗ <span class="font-mono">@row.LastTestAt.Value.ToLocalTime().ToString("g")</span></span>
                                    <div class="text-danger text-xs">@row.LastTestMessage</div>
                                }
                                else
                                {
                                    <span>✓</span>
                                    @if (!string.IsNullOrWhiteSpace(row.LastTestIp))
                                    {
                                        <span class="font-mono">@row.LastTestIp</span>
                                    }
                                    <span class="font-mono">@row.LastTestAt.Value.ToLocalTime().ToString("g")</span>
                                }
                            }
                        </td>
                        <td class="px-2 py-2">
                            <button type="button" class="btn btn-outline-secondary mr-1"
                                    disabled="@(_busy || _testingId == row.Id)"
                                    @onclick="() => TestAsync(row)">
                                @(_testingId == row.Id ? L["proxies.action.testing"] : L["proxies.action.test"])
                            </button>
                            <button type="button" class="btn btn-outline-secondary mr-1" disabled="@_busy"
                                    @onclick="() => OpenEdit(row)">@L["providers.action.edit"]</button>
                            <button type="button" class="btn btn-outline-danger" disabled="@_busy"
                                    @onclick="() => AskDelete(row)">@L["providers.action.delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Cây gán provider-centric (spec C1-C4): root = mọi provider → proxy của provider →
   mọi AC của provider với checkbox tick hiệu lực. <details> thuần: expand/collapse do browser
   giữ DOM state; summary dùng preventDefault + state (_expandedProviderId) để chỉ 1 node mở
   tại một thời điểm — không attach @ontoggle vì setAttribute/removeAttribute `open` khi
   re-render cũng fire toggle → loop/sai node. *@
<style>
    .proxy-tree { display: flex; flex-direction: column; gap: 2px; font-size: 0.875rem; }
    .proxy-tree .pt-node { margin-left: 18px; }
    .proxy-tree > .pt-node { margin-left: 0; }
    .pt-summary {
        display: flex; align-items: center; gap: 8px; cursor: pointer;
        padding: 6px 8px; border-radius: 4px; list-style: none; user-select: none;
    }
    .pt-summary::-webkit-details-marker { display: none; }
    .pt-summary:hover { background: var(--background); }
    .pt-chev { width: 12px; flex: none; opacity: 0.5; }
    .pt-chev::before { content: "▸"; }
    details[open] > .pt-summary .pt-chev::before { content: "▾"; }
    /* meta chứa cluster phải (✕) — margin-left:auto đẩy cụm phải */
    .pt-meta {
        margin-left: auto; display: flex; align-items: center; gap: 8px;
        font-size: 11px; opacity: 0.75; white-space: nowrap;
    }
    .pt-badge {
        font-size: 10px; border: 1px solid var(--border); border-radius: 999px;
        padding: 1px 7px; text-transform: uppercase; white-space: nowrap;
    }
    /* dòng endpoint proxy — thụt vào ít hơn AC (24px vs 36px) để phân cấp trực quan */
    .pt-endpoint { display: flex; align-items: center; gap: 8px; padding: 5px 8px 5px 24px; border-radius: 4px; }
    .pt-endpoint:hover { background: var(--background); }
    .pt-leaf { display: flex; align-items: center; gap: 8px; padding: 5px 8px 5px 36px; border-radius: 4px; }
    .pt-leaf:hover { background: var(--background); }
    .pt-empty { padding: 6px 8px 6px 30px; font-size: 12px; font-style: italic; opacity: 0.5; }
    .pt-edit {
        border: 0; background: transparent; cursor: pointer; border-radius: 4px;
        padding: 0 4px; font-size: 12px; line-height: 1.4; opacity: 0.6;
    }
    .pt-edit:hover { opacity: 1; background: var(--background); }
    .pt-edit:disabled { opacity: 0.25; cursor: not-allowed; background: transparent; }
    .pt-add {
        display: inline-flex; align-items: center; gap: 6px; margin: 0;
        padding: 3px 10px; font-size: 12px; border: 1px dashed var(--border);
        border-radius: 6px; background: transparent; color: var(--color-primary); cursor: pointer;
    }
    .pt-add:hover { border-color: var(--color-primary); background: var(--background); }
    .pt-add:disabled { opacity: 0.5; cursor: not-allowed; }
    .pt-panel {
        margin: 4px 0 6px 24px; padding: 8px; border: 1px solid var(--border);
        border-radius: 6px; background: var(--background);
    }
</style>

<div class="mt-6 rounded border border-border bg-surface p-4">
    <h2 class="text-sm font-semibold mb-3">@L["proxies.assign.title"]</h2>

    <div class="proxy-tree">
        @foreach (var node in _tree)
        {
            <details @key="node.Provider.Id" class="pt-node"
                     open="@(_expandedProviderId == node.Provider.Id ? "open" : null)">
                @* preventDefault: click summary sẽ toggle native — state quản lý bằng
                   _expandedProviderId để attr `open` luôn khớp (xem comment khối style ở trên). *@
                <summary class="pt-summary"
                         @onclick="() => ToggleExpandAsync(node.Provider.Id)"
                         @onclick:preventDefault="true">
                    <span class="pt-chev"></span>
                    <span>@node.Provider.Name</span>
                    @* stopPropagation + preventDefault: click vào <select> nằm trong <summary>
                       sẽ bubble lên summary và collapse node nếu không chặn (cùng pattern
                       nút ✎ trong summary trước đây). *@
                    <select class="rounded border border-border bg-surface px-1 py-0.5 text-xs"
                            value="@node.EffectiveMode" disabled="@_busy"
                            @onclick:preventDefault="true" @onclick:stopPropagation="true"
                            @onchange="args => OnModeChangedAsync(node.Provider.Id, args)">
                        <option value="@ProxyMode.RoundRobin">@L["proxies.assign.mode_rr"]</option>
                        <option value="@ProxyMode.Fallback">@L["proxies.assign.mode_fallback"]</option>
                    </select>
                    <span class="pt-badge">
                        @(node.Proxies.Count == 0
                            ? L["proxies.assign.none"]
                            : string.Format(L["proxies.assign.badge_count"], node.Proxies.Count))
                    </span>
                </summary>

                @* Search-add: chỉ render khi node mở — tránh N input/option list bind cùng một _addSearch *@
                @if (_expandedProviderId == node.Provider.Id)
                {
                    var pool = UnassignedProxies(node);
                    <div class="pt-panel">
                        <input class="w-full rounded border border-border bg-surface px-2 py-1.5 text-sm"
                               placeholder="@L["proxies.tree.addPlaceholder"]"
                               disabled="@_busy"
                               @bind="_addSearch" @bind:event="oninput" />
                        @if (pool.Count == 0)
                        {
                            <p class="pt-empty">@L["proxies.tree.addEmpty"]</p>
                        }
                        else
                        {
                            <div class="mt-1 flex flex-col gap-1">
                                @foreach (var option in MatchSearch(pool))
                                {
                                    @* Proxy tắt vẫn thêm được — pool tự lọc khi chạy (D-A2) *@
                                    <button type="button" class="pt-add" disabled="@_busy"
                                            @onclick="() => AddProxyAsync(node.Provider.Id, option.Id)">
                                        @EndpointOf(option)
                                        @if (!option.Enabled)
                                        {
                                            <span class="pt-badge">@L["proxies.assign.disabledSuffix"]</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @if (node.Proxies.Count == 0)
                {
                    <div class="pt-empty">@L["proxies.tree.empty"]</div>
                }

                @foreach (var proxyNode in node.Proxies)
                {
                    <div @key="proxyNode.Proxy.Id" class="pt-endpoint">
                        <span class="font-mono">@EndpointOf(proxyNode.Proxy)</span>
                        @if (!proxyNode.Proxy.Enabled)
                        {
                            @* Proxy tắt vẫn gán/gỡ được — pool tự lọc (D-A2) *@
                            <span class="pt-badge">@L["proxies.assign.disabledSuffix"]</span>
                        }
                        <span class="pt-meta">
                            @* ✕ bật cả khi proxy tắt — chỉ chặn khi đang lưu (_busy) *@
                            <button type="button" class="pt-edit" disabled="@_busy"
                                    title="@L["proxies.tree.remove"]"
                                    aria-label="@L["proxies.tree.remove"]"
                                    @onclick="() => RemoveProxyAsync(node.Provider.Id, proxyNode.Proxy.Id)">✕</button>
                        </span>
                    </div>

                    @foreach (var account in proxyNode.Accounts)
                    {
                        @* Tick = tập hiệu lực (matrix), không phải state DOM — save ghi ngay (spec C4) *@
                        <label @key="account.Account.Id" class="pt-leaf">
                            <input type="checkbox" checked="@account.Tick"
                                   disabled="@(!proxyNode.Proxy.Enabled || _busy)"
                                   @onchange="args => ToggleAccountAsync(node, proxyNode, account, args.Value is true)" />
                            <span class="font-mono">@account.Account.Name</span>
                            @if (account.IsOverride)
                            {
                                <span class="pt-badge">@L["proxies.assign.override"]</span>
                            }
                        </label>
                    }
                }
            </details>
        }
    </div>
</div>

<Modal Visible="@(_editing is not null)"
       Title="@(_editing is { Id: 0 } ? L["proxies.form.addTitle"] : L["proxies.form.editTitle"])"
       OnClose="CloseModal">
    <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.scheme"]
            @* Tên scheme là protocol language-neutral — không qua i18n *@
            <select class="rounded border border-border bg-surface px-2 py-1.5" @bind="_scheme">
                <option value="http">http</option>
                <option value="socks5">socks5</option>
            </select>
            <span class="text-xs opacity-70">@L["proxies.schemes.hint"]</span>
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.port"]
            <input type="number" min="1" max="65535"
                   class="rounded border border-border bg-surface px-2 py-1.5"
                   disabled="@_busy" @bind="_port" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm sm:col-span-2">
            @L["proxies.field.host"]
            <input class="rounded border border-border bg-surface px-2 py-1.5"
                   spellcheck="false" disabled="@_busy" @bind="_host" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.username"]
            <input class="rounded border border-border bg-surface px-2 py-1.5"
                   autocomplete="off" disabled="@_busy" @bind="_username" @bind:event="oninput" />
        </label>

        <label class="flex flex-col gap-1 text-sm">
            @L["proxies.field.password"]
            @* Password chỉ tồn tại lúc nhập — không bao giờ hiển thị lại (không đọc PasswordEncrypted) *@
            <input type="password" class="rounded border border-border bg-surface px-2 py-1.5"
                   autocomplete="new-password" spellcheck="false" disabled="@_busy"
                   placeholder="@PasswordPlaceholder"
                   @bind="_password" @bind:event="oninput" />
        </label>
    </div>

    @if (_formError is not null)
    {
        <div class="mt-1 text-sm text-danger">@_formError</div>
    }

    <div class="mt-4 flex justify-end gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="CloseModal">
            @L["confirm.cancel"]
        </button>
        @* Nút Save dùng chung key i18n của Settings — cùng nghĩa, tránh nhân đôi key *@
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
            @L["settings.action.save"]
        </button>
    </div>
</Modal>

@if (_confirmDelete is { } proxyToDelete)
{
    <ConfirmDialog Visible="true"
                   Title="@L["providers.action.delete"]"
                   Message="@L["proxies.confirm.delete"]"
                   Danger="true"
                   ConfirmText="@L["providers.action.delete"]"
                   CancelText="@L["confirm.cancel"]"
                   OnConfirm="DeleteAsync"
                   OnCancel="CancelDelete" />
}

@code {
    private List<OutboundProxy> _rows = [];
    private List<ProxyRuntimeStatus> _downStatuses = [];
    private bool _loading = true;
    private bool _busy;

    // null = modal đóng; Id == 0 = đang thêm mới (edit giữ Id thật)
    private OutboundProxy? _editing;
    private long? _testingId;
    private string? _formError;
    private string _scheme = "http";
    private string _host = string.Empty;
    private int _port = 8080;
    private string _username = string.Empty;
    private string _password = string.Empty; // rỗng = giữ mật khẩu cũ khi edit
    private OutboundProxy? _confirmDelete;

    // Section gán proxy — cây provider-centric Provider → Proxy → AC (spec C1-C4)
    private List<Provider> _providers = [];
    // Ma trận gán (B4) — nguồn tập hiệu lực + cờ override; tick/lưu luôn đọc từ đây, không từ DOM
    private ProxyAssignmentMatrix _matrix = new([], []);
    // Cây hiển thị — tính lại sau mỗi ReloadAsync
    private IReadOnlyList<ProviderTreeNode> _tree = [];
    // Node provider đang mở (null = tất cả đóng) — chỉ 1 node mở tại một thời điểm (spec C1)
    private long? _expandedProviderId;
    // Từ khóa search-add — chỉ 1 node mở tại một thời điểm nên dùng chung được
    private string _addSearch = string.Empty;

    /// <summary>Chỉ hiện hint khi sửa — thêm mới để trống nghĩa là không đặt mật khẩu.</summary>
    private string? PasswordPlaceholder => _editing is { Id: > 0 } ? L["proxies.hint.password"] : null;

    protected override async Task OnInitializedAsync()
    {
        L.LanguageChanged += OnLanguageChanged;
        await ReloadAsync();
    }

    /// <summary>
    /// Nạp lại danh sách proxy + snapshot trạng thái pool + danh sách provider. Cột Status
    /// chỉ đọc lúc load và sau hành động (Save/Toggle/Test/Delete) — spec §6.
    /// </summary>
    private async Task ReloadAsync()
    {
        try
        {
            _rows = (await ProxySvc.ListAsync()).ToList();
            // Giữ toàn bộ snapshot để hiển thị "Down (còn Xs)" — DownUntil chỉ có ở đây.
            _downStatuses = ProxyPool.Snapshot().ToList();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _loading = false;
        }

        // Danh sách provider + ma trận gán cho cây — chạy song song, best-effort:
        // lỗi không chặn load proxy chính, cây dùng dữ liệu của lần nạp trước.
        var providersTask = ProviderSvc.ListAsync();
        var matrixTask = ProxySvc.GetAssignmentMatrixAsync();
        try
        {
            _providers = (await providersTask).ToList();
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được danh sách provider.", ex);
        }

        try
        {
            _matrix = await matrixTask;
        }
        catch (Exception ex)
        {
            Log.Error("Không tải được ma trận gán proxy.", ex);
        }

        _tree = ProviderAssignmentTree.Build(_providers, _rows, _matrix);

        StateHasChanged();
    }

    /// <summary>
    /// Badge trạng thái: down → "Down (còn Xs)" (hoặc "Down" nếu hết cooldown); còn lại "Ready".
    /// </summary>
    private string StatusBadge(OutboundProxy row)
    {
        var status = _downStatuses.FirstOrDefault(s => s.Id == row.Id);
        if (status is not { IsDown: true })
        {
            return L["proxies.status.ok"];
        }

        if (status.DownUntil is not { } until)
        {
            return L["proxies.status.down"];
        }

        var remaining = (int)Math.Max(0, (until - DateTimeOffset.UtcNow).TotalSeconds);
        return $"{L["proxies.status.down"]} ({string.Format(L["proxies.status.downUntil"], remaining)})";
    }

    private static string EndpointOf(OutboundProxy row) =>
        $"{row.Scheme}://{row.Host}:{row.Port}";

    private void OpenAdd()
    {
        if (_busy) return;
        _editing = new OutboundProxy();
        _scheme = "http";
        _host = string.Empty;
        _port = 8080;
        _username = string.Empty;
        _password = string.Empty;
        _formError = null;
    }

    private void OpenEdit(OutboundProxy row)
    {
        if (_busy) return;
        _editing = row;
        _scheme = row.Scheme;
        _host = row.Host;
        _port = row.Port;
        _username = row.Username ?? string.Empty;
        _password = string.Empty; // để trống = giữ mật khẩu cũ
        _formError = null;
    }

    private void CloseModal()
    {
        _editing = null;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        // Single-flight — double-click vẫn tới được đây khi nút chưa re-render
        if (_busy || _editing is not { } target) return;

        var draft = new ProxyDraft
        {
            Scheme = _scheme,
            Host = _host,
            Port = _port,
            Username = _username,
            Password = string.IsNullOrEmpty(_password) ? null : _password,
        };

        // Validate chung với service (ProxyValidator) — không nhân bản rule trong Razor
        var errors = ProxyValidator.Validate(draft);
        if (errors.Count > 0)
        {
            _formError = string.Join(" ", errors.Values.Distinct().Select(k => L[k]));
            return;
        }

        _busy = true;
        try
        {
            if (target.Id == 0)
            {
                await ProxySvc.CreateAsync(draft);
            }
            else
            {
                await ProxySvc.UpdateAsync(target.Id, draft);
            }

            Toast.Show(L["proxies.msg.saved"], ToastSeverity.Success);
            CloseModal();
            await ReloadAsync();
        }
        catch (ProxyValidationException ex)
        {
            // Duplicate endpoint do server bắt (cần DB) — map key i18n đã gán sẵn
            _formError = string.Join(" ", ex.Errors.Values.Distinct().Select(k => L[k]));
        }
        catch (Exception ex)
        {
            Log.Error("Không lưu được proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAsync(OutboundProxy row)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await ProxySvc.SetEnabledAsync(row.Id, !row.Enabled);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không đổi được trạng thái proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync(OutboundProxy row)
    {
        // Single-flight: _testingId chỉ có một slot — test song song sẽ xóa nhãn của nhau
        if (_busy) return;
        _busy = true;
        _testingId = row.Id;
        try
        {
            var result = await ProxySvc.TestAsync(row.Id, CancellationToken.None);
            if (!result.Success)
            {
                // Lỗi chi tiết đã persist và hiện trong cột Last test — toast chỉ báo chung
                Toast.Show(L["proxies.msg.testFailed"], ToastSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Log.Error("Test proxy thất bại từ danh sách.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _testingId = null;
            _busy = false;
            await ReloadAsync();
        }
    }

    private void AskDelete(OutboundProxy row)
    {
        if (_busy) return;
        _confirmDelete = row;
    }

    private void CancelDelete() => _confirmDelete = null;

    private async Task DeleteAsync()
    {
        if (_busy || _confirmDelete is not { } proxy) return;

        _busy = true;
        try
        {
            await ProxySvc.DeleteAsync(proxy.Id);
            Toast.Show(L["proxies.msg.deleted"], ToastSeverity.Success);
            CancelDelete();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không xóa được proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Mở/đóng node provider — chỉ 1 node mở tại một thời điểm (spec C1); đổi node reset search-add.</summary>
    private Task ToggleExpandAsync(long providerId)
    {
        _expandedProviderId = _expandedProviderId == providerId ? null : providerId;
        _addSearch = string.Empty;
        return Task.CompletedTask;
    }

    private Task OnModeChangedAsync(long providerId, ChangeEventArgs args) =>
        Enum.TryParse<ProxyMode>(args.Value?.ToString(), out var mode)
            ? SetModeAsync(providerId, mode)
            : Task.CompletedTask;

    /// <summary>Đổi mode rr/fb của provider — giữ nguyên tập proxy (spec C3).</summary>
    private async Task SetModeAsync(long providerId, ProxyMode mode)
    {
        if (_busy) return;
        var row = _matrix.Providers.FirstOrDefault(r => r.Id == providerId);
        await SaveProviderAssignmentAsync(providerId, row?.ProxyIds ?? [], mode);
    }

    /// <summary>Thêm 1 proxy vào tập của provider — cộng tập, giữ nguyên mode.</summary>
    private async Task AddProxyAsync(long providerId, long proxyId)
    {
        if (_busy) return;
        var row = _matrix.Providers.FirstOrDefault(r => r.Id == providerId);
        var set = new HashSet<long>(row?.ProxyIds ?? []) { proxyId };
        await SaveProviderAssignmentAsync(providerId, set.OrderBy(id => id).ToList(), row?.Mode);
    }

    /// <summary>Gỡ 1 proxy khỏi tập của provider — trừ tập, giữ nguyên mode (✕ bật cả khi proxy tắt).</summary>
    private async Task RemoveProxyAsync(long providerId, long proxyId)
    {
        if (_busy) return;
        var row = _matrix.Providers.FirstOrDefault(r => r.Id == providerId);
        var set = new HashSet<long>(row?.ProxyIds ?? []);
        set.Remove(proxyId);
        await SaveProviderAssignmentAsync(providerId, set.OrderBy(id => id).ToList(), row?.Mode);
    }

    /// <summary>
    /// Lưu gán cấp provider — single-flight (_busy chặn double-click), không toast thành công;
    /// lỗi KeyNotFound = scope bị xóa nơi khác (spec C3) → toast riêng, còn lại toast chung.
    /// </summary>
    private async Task SaveProviderAssignmentAsync(
        long providerId, IReadOnlyList<long> proxyIds, ProxyMode? mode)
    {
        _busy = true;
        try
        {
            await ProxySvc.AssignProviderProxiesAsync(providerId, proxyIds, mode);
            await ReloadAsync();
        }
        catch (KeyNotFoundException ex)
        {
            Log.Error("Không lưu được gán proxy — provider/proxy không còn tồn tại.", ex);
            Toast.Show(L["proxies.assign.error.scopeNotFound"], ToastSeverity.Error);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Log.Error("Không lưu được gán proxy.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Bật/tắt checkbox 1 AC cho 1 proxy (spec C4): tập mới = tập hiệu lực ± proxyId;
    /// trùng tập provider → quay kế thừa (flag=false), rỗng → direct (flag=true + tập rỗng).
    /// Tập hiệu lực đọc từ _matrix (override dùng tập AC, còn lại kế thừa) — không đọc tick DOM.
    /// </summary>
    private async Task ToggleAccountAsync(ProviderTreeNode providerNode, ProxyNode proxyNode,
        AccountTickNode accountNode, bool checking)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var providerRow = _matrix.Providers.FirstOrDefault(r => r.Id == providerNode.Provider.Id);
            var providerSet = providerRow?.ProxyIds ?? [];
            var accountRow = _matrix.Accounts.FirstOrDefault(r => r.Id == accountNode.Account.Id);
            var currentSet = accountRow is { OverrideEnabled: true }
                ? accountRow.ProxyIds
                : providerSet;

            var set = new HashSet<long>(currentSet);
            if (checking)
            {
                set.Add(proxyNode.Proxy.Id);
            }
            else
            {
                set.Remove(proxyNode.Proxy.Id);
            }
            var newSet = set.OrderBy(id => id).ToList();

            // Đúng tập provider (cùng thứ tự Id) → tự tắt cờ, không cần hàng override nữa
            var overrideEnabled = !newSet.SequenceEqual(providerSet.OrderBy(id => id));
            await ProxySvc.SetAccountProxyOverrideAsync(
                accountNode.Account.Id, newSet, overrideEnabled);
            await ReloadAsync();
        }
        catch (KeyNotFoundException ex)
        {
            Log.Error("Không lưu được tick AC — scope không còn tồn tại.", ex);
            Toast.Show(L["proxies.assign.error.scopeNotFound"], ToastSeverity.Error);
            await ReloadAsync(); // spec C4: lỗi → toast + reload, không để state lệch
        }
        catch (Exception ex)
        {
            Log.Error("Không lưu được tick AC.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Proxy chưa gán cho provider — pool của search-add (kể cả proxy tắt, thêm được — D-A2).</summary>
    private List<OutboundProxy> UnassignedProxies(ProviderTreeNode node)
    {
        var assigned = node.Proxies.Select(n => n.Proxy.Id).ToHashSet();
        return _rows.Where(p => !assigned.Contains(p.Id)).ToList();
    }

    /// <summary>Lọc pool theo _addSearch — khớp endpoint, không phân biệt hoa thường (pattern model panel).</summary>
    private IEnumerable<OutboundProxy> MatchSearch(IReadOnlyList<OutboundProxy> pool)
    {
        var term = _addSearch.Trim();
        return term.Length == 0
            ? pool
            : pool.Where(p => EndpointOf(p).Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.LanguageChanged -= OnLanguageChanged;
    }
}
