@page "/"
@using RouterBalancing.Core.Settings
@using RouterBalancing.Core.Engine
@using RouterBalancing.Core.Providers
@implements IDisposable
@inject IProxyHost Proxy
@inject ILogService Log
@inject ToastService Toast
@inject LocalizationService L
@inject IAppSettingsService Settings
@inject IManualRetryStore RetryStore
@inject IProviderService ProviderService

<h1 class="mb-4 text-xl font-semibold">@L["dashboard.title"]</h1>

<div class="mb-4 rounded border border-border bg-surface p-4">
    <div class="flex items-center justify-between">
        <div>
            <div class="text-sm opacity-70">@L["dashboard.status.label"]</div>
            <div class="mt-1 text-lg font-medium">
                @(Proxy.IsRunning ? L["dashboard.status.running"] : L["dashboard.status.stopped"])
            </div>
            @if (Proxy.IsRunning)
            {
                <div class="mt-1 font-mono text-sm">http://127.0.0.1:@Proxy.Port/v1</div>
                @if (Settings.LanAccess)
                {
                    @* Render lúc truy vấn (không cache) — phản ánh ngay sau restart; loopback đã có dòng trên (D-C3) *@
                    @foreach (var url in LanUrls)
                    {
                        <div class="mt-1 font-mono text-sm">@url/v1</div>
                    }
                }
            }
        </div>

        <div class="flex gap-2">
            @if (!Proxy.IsRunning)
            {
                <button class="btn btn-primary" @onclick="StartAsync">@L["dashboard.action.start"]</button>
            }
            else
            {
                <button class="btn btn-danger" @onclick="StopAsync">@L["dashboard.action.stop"]</button>
                <button class="btn btn-secondary" @onclick="RestartAsync">@L["dashboard.action.restart"]</button>
            }
        </div>
    </div>
</div>

@* Manual retry (spec §3.2): hiện provider/account/model đang park — nút Retry now unpark ngay *@
@if (_retryEntries.Count > 0)
{
    <div class="mb-4 rounded border border-border bg-surface p-4" data-testid="manual-retry-list">
        <div class="mb-2 text-sm opacity-70">@L["manualRetry.title"]</div>
        @foreach (var entry in _retryEntries)
        {
            <div class="flex items-center gap-2 py-1" @key="entry">
                @* min-width 76px: chừa chỗ cho label dài nhất (Provider/Account/Model) — spec §3.2 *@
                <span class="whitespace-nowrap text-center" style="min-width:76px">@L[ManualRetryI18n.LevelKey(entry.Level)]</span>
                <span class="flex-1 truncate">@GetEntryDisplayName(entry)</span>
                <span class="text-sm opacity-70">@L[ManualRetryI18n.ReasonKey(entry.Reason)]</span>
                <button class="btn btn-outline-info px-1.5" @onclick="() => RetryNowAsync(entry)">
                    @L["manualRetry.action.retry"]
                </button>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ManualRetryEntry> _retryEntries = [];
    private Dictionary<long, string> _providerNames = [];

    protected override async Task OnInitializedAsync()
    {
        Proxy.StateChanged += OnStateChanged;
        RetryStore.Changed += HandleRetryStoreChanged;
        try
        {
            await ReloadEntriesAsync();
        }
        catch (Exception ex)
        {
            // Không để throw đánh sập pipeline init của Blazor (render trắng cả Dashboard)
            Log.Error("Tải danh sách retry thủ công lúc khởi tạo Dashboard thất bại.", ex);
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>URL LAN hiện tại — tính lúc render để không cần cache/refresh tay.</summary>
    private IReadOnlyList<string> LanUrls =>
        Proxy.Port is { } port ? LanUrlProvider.GetUrls(port) : [];

    /// <summary>Tải danh sách retry thủ công + map providerId → tên để hiển thị trong card.</summary>
    private async Task ReloadEntriesAsync()
    {
        var providers = await ProviderService.ListAsync();
        // Key = provider Id để khớp entry.Id cấp Provider — không qua Accounts:
        // provider có nhiều account sẽ cho tuple trùng, ToDictionary ném ArgumentException
        _providerNames = providers.ToDictionary(p => p.Id, p => p.Name);
        _retryEntries = RetryStore.GetEntries(); // gán CUỐI — tránh render dở dang
    }

    // Changed bắn từ background thread (Park trong request/ping loop) → marshal về UI thread
    private void HandleRetryStoreChanged() =>
        _ = InvokeAsync(async () =>
        {
            try
            {
                await ReloadEntriesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // Ném trong nền sẽ là unobserved exception — bắt NGAY trong lambda để log
                Log.Error("Tải lại danh sách retry thủ công (nền) thất bại.", ex);
            }
        });

    /// <summary>Tên hiển thị: provider theo tên (fallback #id), account #id, model = ModelId.</summary>
    private string GetEntryDisplayName(ManualRetryEntry entry) => entry.Level switch
    {
        ManualRetryLevel.Provider when _providerNames.TryGetValue(entry.Id, out var n) => n,
        ManualRetryLevel.Provider => $"#{entry.Id}",
        ManualRetryLevel.Account => $"#{entry.Id}",
        _ => entry.ModelId,
    };

    private async Task RetryNowAsync(ManualRetryEntry entry)
    {
        try
        {
            RetryStore.Unpark(entry.Level, entry.Id, entry.ModelId);
            Log.Info($"'{GetEntryDisplayName(entry)}' được retry thủ công — trở lại vòng xoay");
            // Bản dịch giữ placeholder {key} (exact theo spec §3.6) — thay tại chỗ, Toast.Show nhận text đã dịch
            Toast.Show(L["manualRetry.msg.unparked"].Replace("{key}", GetEntryDisplayName(entry)), ToastSeverity.Success);
            await ReloadEntriesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // SQLite ném từ ReloadEntriesAsync — cùng pattern Start/Stop/Restart ở trên
            Log.Error($"Retry thủ công cho '{GetEntryDisplayName(entry)}' thất bại.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
    }

    private async Task StartAsync()
    {
        try
        {
            await Proxy.StartAsync();
            Log.Info("Proxy được khởi động từ Dashboard.");
            Toast.Show(L["dashboard.msg.started"], ToastSeverity.Success);
        }
        catch (Exception ex)
        {
            Log.Error("Khởi động proxy thất bại từ Dashboard.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
    }

    private async Task StopAsync()
    {
        try
        {
            await Proxy.StopAsync();
            Log.Info("Proxy được dừng từ Dashboard.");
            Toast.Show(L["dashboard.msg.stopped"], ToastSeverity.Success);
        }
        catch (Exception ex)
        {
            Log.Error("Dừng proxy thất bại từ Dashboard.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
    }

    private async Task RestartAsync()
    {
        try
        {
            await Proxy.RestartAsync();
            Log.Info("Proxy được khởi động lại từ Dashboard.");
            Toast.Show(L["dashboard.msg.restarted"], ToastSeverity.Success);
        }
        catch (Exception ex)
        {
            Log.Error("Khởi động lại proxy thất bại từ Dashboard.", ex);
            Toast.Show(L["dashboard.msg.failed"], ToastSeverity.Error);
        }
    }

    public void Dispose()
    {
        Proxy.StateChanged -= OnStateChanged;
        RetryStore.Changed -= HandleRetryStoreChanged;
    }
}
