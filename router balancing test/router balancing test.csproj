<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>router_balancing_test</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: test project là stand-alone executable, bắt buộc OutputType=Exe -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (truyền TestContext.Current.CancellationToken) chỉ là best-practice;
         suite hiện tại có ~800 call sites — sửa hàng loạt sẽ đổi behavior test.
         Tạm tắt trong test project; bật lại từng phần nếu muốn. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebApplication/UseTestServer trong integration test — host của app nằm trong Core (FrameworkReference sẵn) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- mtp-off: tắt Microsoft.Testing.Platform — .NET 10 SDK chặn chạy MTP qua
         dotnet test VSTest mode, nên giữ adapter VSTest (xunit.runner.visualstudio)
         thay vì MTP để mọi lệnh filter (FullyQualifiedName~...) trong CI/docs chạy y hệt. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\RouterBalancing.Core\RouterBalancing.Core.csproj" />
    <!-- Compile trực tiếp UpdateStager (KHÔNG ProjectReference): reference assembly
         sẽ kéo RouterBalancing.Updater.exe vào test bin, phá test
         InstallUpdateAsync_False_WhenUpdaterMissing và có thể launch thật updater. -->
    <Compile Include="..\RouterBalancing.Updater\UpdateStager.cs" Link="Update\UpdateStager.cs" />
  </ItemGroup>

</Project>