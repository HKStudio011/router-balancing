<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>router_balancing_test</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: test project là stand-alone executable, bắt buộc OutputType=Exe -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (truyền TestContext.Current.CancellationToken) chỉ là best-practice;
         suite hiện tại có ~800 call sites — sửa hàng loạt sẽ đổi behavior test.
         Tạm tắt trong test project; bật lại từng phần nếu muốn. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- MTP mặc định gói failure vào .log; bật để CI hiện lỗi per-test như VSTest cũ -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <!-- Bắt buộc với xunit khi dùng MTP: chuyển CLI của test app sang MTP
         (dotnet test mới parse được filter options kiểu filter-class/filter-method) -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebApplication/UseTestServer trong integration test — host của app nằm trong Core (FrameworkReference sẵn) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- MTP mode (.NET 10): dotnet test chạy qua global.json ở repo root,
         không cần VSTest adapter (xunit.runner.visualstudio / Microsoft.NET.Test.Sdk). -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Go sidecar binary: OpenCodeSidecarServiceTests + OpenCodeSidecarE2ETests
         resolve từ AppContext.BaseDirectory/runtimes/... như app thật. -->
    <Content Include="..\runtimes\win-x64\native\opencode-proxy.exe"
             CopyToOutputDirectory="PreserveNewest"
             Link="runtimes\win-x64\native\opencode-proxy.exe" />
    <!-- Wire body title-gen thật (capture 2026-10-15 từ opencode CLI qua echo server) —
         dùng trong OpenCodeSidecarE2ETests replay. -->
    <Content Include="Server\title-captured.json"
             CopyToOutputDirectory="PreserveNewest"
             Link="title-captured.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\RouterBalancing.Core\RouterBalancing.Core.csproj" />
    <!-- Compile trực tiếp UpdateStager (KHÔNG ProjectReference): reference assembly
         sẽ kéo RouterBalancing.Updater.exe vào test bin, phá test
         InstallUpdateAsync_False_WhenUpdaterMissing và có thể launch thật updater. -->
    <Compile Include="..\RouterBalancing.Updater\UpdateStager.cs" Link="Update\UpdateStager.cs" />
  </ItemGroup>

</Project>